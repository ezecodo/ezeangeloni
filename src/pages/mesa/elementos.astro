---
/**
 * Los elementos de la mesa (Eze, 2026-11-27): piezas que acompañan al dragón, en sus mismas reglas gráficas, dibujadas en
 * vivo desde src/cronovisor/elementos/ (ELEMENTOS). Un menú a la izquierda, por grupos; al elegir uno se despliega a la
 * derecha, grande, con su descripción y el movimiento previsto (donde irá su animación). Sólo se dibuja el elegido.
 * `#id` en la URL abre uno directo; ↑ ↓ (o j k) recorren el menú. Unlisted y sin indexar.
 */
import Cabecera from '../../components/CabeceraMesa.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Elementos · la mesa</title>
  <style is:global>
    html, body { margin: 0; background: #0b0908; color: #cfc8bf; font: 13px/1.55 ui-monospace, monospace; }
    body > .cabecera { padding-left: 22px; padding-right: 22px; }
    .sala { display: grid; grid-template-columns: 290px 1fr; min-height: calc(100vh - 42px); }
    aside { border-right: 1px solid #2a241f; padding: 18px 0 40px; position: sticky; top: 42px; height: calc(100vh - 42px); overflow-y: auto; box-sizing: border-box; }
    aside h1 { font: italic 300 30px/1.05 Georgia, serif; color: #f0ede8; margin: 0 20px 4px; }
    aside .cuenta { color: #6d655c; font-size: 11px; margin: 0 20px 10px; }
    aside h2 { font: 10px ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; color: #6d655c; margin: 18px 20px 4px; }
    aside button { display: block; width: 100%; text-align: left; background: none; border: 0; border-left: 2px solid transparent; color: #a8a096; font: italic 300 17px/1.3 Georgia, serif; padding: 5px 18px; cursor: pointer; }
    aside button:hover { color: #f0ede8; background: #14110f; }
    aside button.on { color: #e8b04a; border-left-color: #e8b04a; background: #17120d; }
    .escena { padding: 22px 28px 40px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    .escena canvas { display: block; width: 100%; max-height: calc(100vh - 230px); aspect-ratio: 4/3; object-fit: contain; background: #000; border: 1px solid #2a241f; align-self: center; max-width: calc((100vh - 230px)*4/3); }
    .escena .grupo { font: 10px ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; color: #8d857b; }
    .escena h3 { font: italic 300 34px/1.1 Georgia, serif; color: #f0ede8; margin: 0; }
    .escena p { margin: 0; max-width: 820px; }
    .escena .mov { color: #7d756b; border-top: 1px dashed #2a241f; padding-top: 10px; }
    .escena .mov::before { content: 'movimiento previsto · '; color: #e8b04a; letter-spacing: .08em; }
    .escena .ayuda { color: #5d564e; font-size: 11px; }
    .modo { display: flex; gap: 0; align-self: center; border: 1px solid #2a241f; }
    .modo button { background: none; border: 0; color: #8d857b; font: 11px ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase; padding: 7px 14px; cursor: pointer; }
    .modo button.on { color: #0b0908; background: #e8b04a; }
    @media (max-width: 800px) { .sala { grid-template-columns: 1fr; } aside { position: static; height: auto; border-right: 0; border-bottom: 1px solid #2a241f; } }
  </style>
</head>
<body>
  <Cabecera actual="elementos" />
  <div class="sala">
    <aside>
      <h1>Elementos</h1>
      <div class="cuenta" id="cuenta"></div>
      <nav id="menu"></nav>
    </aside>
    <section class="escena">
      <canvas id="lienzo" width="1440" height="1080"></canvas>
      <div class="modo"><button id="m-anim">animado</button><button id="m-quieto">estático</button></div>
      <div><div class="grupo" id="grupo"></div><h3 id="nombre"></h3></div>
      <p id="desc"></p>
      <p class="mov" id="mov"></p>
      <p class="ayuda">↑ ↓ para recorrer · E estático / animado · las reglas, en la <a href="/mesa/estilo/" style="color:#8d857b">guía de estilo</a></p>
    </section>
  </div>
  <script>
    import { ELEMENTOS, FOTO } from '../../cronovisor/elementos';
    const menu = document.getElementById('menu')!, lienzo = document.getElementById('lienzo') as HTMLCanvasElement, g = lienzo.getContext('2d')!;
    const $ = (id: string) => document.getElementById(id)!;
    // el menú, por grupos, en el orden en que aparecen
    const porGrupo = new Map<string, typeof ELEMENTOS>();
    for(const e of ELEMENTOS){ const k = e.grupo ?? ''; porGrupo.set(k, [...(porGrupo.get(k) ?? []), e]); }
    $('cuenta').textContent = `${ELEMENTOS.length} piezas · ${porGrupo.size} elementos`;
    const botones = new Map<string, HTMLButtonElement>();
    for(const [nombre, lista] of porGrupo){
      if(nombre){ const h = document.createElement('h2'); h.textContent = nombre; menu.appendChild(h); }
      for(const e of lista){
        const b = document.createElement('button'); b.textContent = e.nombre; b.onclick = () => elegir(e.id, true);
        menu.appendChild(b); botones.set(e.id, b);
      }
    }
    let actual = ELEMENTOS[0];
    function elegir(id: string, historia = false){
      actual = ELEMENTOS.find(e => e.id === id) ?? ELEMENTOS[0];
      for(const [k, b] of botones) b.classList.toggle('on', k === actual.id);
      botones.get(actual.id)!.scrollIntoView({ block: 'nearest' });
      $('grupo').textContent = actual.grupo ?? ''; $('nombre').textContent = actual.nombre; $('desc').textContent = actual.descripcion;
      $('mov').textContent = actual.animacion ?? ''; $('mov').hidden = !actual.animacion;
      document.title = `${actual.nombre} · elementos`;
      if(historia) history.replaceState(null, '', '#' + actual.id);
    }
    elegir(location.hash.slice(1));
    addEventListener('hashchange', () => elegir(location.hash.slice(1)));
    // animado o estático (el elemento quieto en su mejor segundo, `FOTO`); se recuerda en este navegador
    let quieto = localStorage.getItem('mesa-elementos-quieto') === '1';
    const modo = (q: boolean) => { quieto = q; localStorage.setItem('mesa-elementos-quieto', q ? '1' : '0'); $('m-anim').classList.toggle('on', !q); $('m-quieto').classList.toggle('on', q); };
    $('m-anim').onclick = () => modo(false); $('m-quieto').onclick = () => modo(true); modo(quieto);
    addEventListener('keydown', ev => {
      if(ev.key === 'e' || ev.key === 'E'){ modo(!quieto); return; }
      const d = ev.key === 'ArrowDown' || ev.key === 'j' ? 1 : ev.key === 'ArrowUp' || ev.key === 'k' ? -1 : 0;
      if(!d) return; ev.preventDefault();
      const i = ELEMENTOS.indexOf(actual); elegir(ELEMENTOS[(i + d + ELEMENTOS.length) % ELEMENTOS.length].id, true);
    });
    // sólo se dibuja el elegido, a cada cuadro (estáticos por ahora: cuando tengan movimiento no hay que tocar la página)
    const t0 = performance.now(), W = lienzo.width, H = lienzo.height;
    const cuadro = (now: number) => {
      g.setTransform(1, 0, 0, 1, 0, 0); g.globalAlpha = 1; g.globalCompositeOperation = 'source-over'; g.shadowBlur = 0;
      g.fillStyle = '#000'; g.fillRect(0, 0, W, H); g.lineJoin = 'round'; g.lineCap = 'round';
      actual.dibujar(g, W, H, quieto ? FOTO[actual.id] ?? 0 : (now - t0)/1000);
      requestAnimationFrame(cuadro);
    };
    requestAnimationFrame(cuadro);
  </script>
</body>
</html>
