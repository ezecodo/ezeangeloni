---
/**
 * Las escenas de la mesa (Eze, 2026-11-27): los elementos combinados en capas, cada escena un cuadro de una noche
 * japonesa, y la función completa que las encadena con la cortina de pétalos (src/cronovisor/escenas/). Un menú a la
 * izquierda; a la derecha, la escena elegida en vivo. `#id` abre una directo; ↑ ↓ recorren; F, pantalla completa
 * (sólo el lienzo, como iría a la mesa). Unlisted y sin indexar.
 */
import Cabecera from '../../components/CabeceraMesa.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Escenas · la mesa</title>
  <style is:global>
    html, body { margin: 0; background: #0b0908; color: #cfc8bf; font: 13px/1.55 ui-monospace, monospace; }
    body > .cabecera { padding-left: 22px; padding-right: 22px; }
    .sala { display: grid; grid-template-columns: 290px 1fr; min-height: calc(100vh - 42px); }
    aside { border-right: 1px solid #2a241f; padding: 18px 0 40px; position: sticky; top: 42px; height: calc(100vh - 42px); overflow-y: auto; box-sizing: border-box; }
    aside h1 { font: italic 300 30px/1.05 Georgia, serif; color: #f0ede8; margin: 0 20px 4px; }
    aside .cuenta { color: #6d655c; font-size: 11px; margin: 0 20px 10px; }
    aside h2 { font: 10px ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; color: #6d655c; margin: 18px 20px 4px; }
    aside button { display: block; width: 100%; text-align: left; background: none; border: 0; border-left: 2px solid transparent; color: #a8a096; font: italic 300 17px/1.3 Georgia, serif; padding: 5px 18px; cursor: pointer; }
    aside button:hover { color: #f0ede8; background: #14110f; }
    aside button.on { color: #e8b04a; border-left-color: #e8b04a; background: #17120d; }
    aside button.sonando { color: #f0ede8; }
    aside button.sonando::after { content: ' ·'; color: #e8b04a; }
    .escena { padding: 22px 28px 40px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    .escena canvas { display: block; width: 100%; max-height: calc(100vh - 250px); aspect-ratio: 4/3; object-fit: contain; background: #000; border: 1px solid #2a241f; align-self: center; max-width: calc((100vh - 250px)*4/3); }
    .escena canvas:fullscreen { border: 0; max-height: none; max-width: none; width: 100vw; height: 100vh; }
    .escena .grupo { font: 10px ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; color: #8d857b; }
    .escena h3 { font: italic 300 34px/1.1 Georgia, serif; color: #f0ede8; margin: 0; }
    .escena p { margin: 0; max-width: 820px; }
    .barra { display: flex; gap: 3px; max-width: 820px; }
    .barra i { display: block; height: 4px; background: #2a241f; position: relative; overflow: hidden; }
    .barra i b { position: absolute; inset: 0 auto 0 0; background: #e8b04a; }
    .escena .ayuda { color: #5d564e; font-size: 11px; }
    @media (max-width: 800px) { .sala { grid-template-columns: 1fr; } aside { position: static; height: auto; border-right: 0; border-bottom: 1px solid #2a241f; } }
  </style>
</head>
<body>
  <Cabecera actual="escenas" />
  <div class="sala">
    <aside>
      <h1>Escenas</h1>
      <div class="cuenta" id="cuenta"></div>
      <nav id="menu"></nav>
    </aside>
    <section class="escena">
      <canvas id="lienzo" width="1440" height="1080"></canvas>
      <div class="barra" id="barra"></div>
      <div><div class="grupo" id="grupo"></div><h3 id="nombre"></h3></div>
      <p id="desc"></p>
      <p class="ayuda">↑ ↓ para recorrer · F pantalla completa · las piezas, en <a href="/mesa/elementos/" style="color:#8d857b">elementos</a></p>
    </section>
  </div>
  <script>
    import { ESCENAS, DURACION, funcion } from '../../cronovisor/escenas';
    const $ = (id: string) => document.getElementById(id)!;
    const lienzo = $('lienzo') as HTMLCanvasElement, g = lienzo.getContext('2d')!, menu = $('menu');
    const min = (s: number) => `${Math.floor(s/60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
    $('cuenta').textContent = `${ESCENAS.length} escenas · la función, ${min(DURACION)}`;
    const opciones = [{ id: 'funcion', nombre: 'La función completa', descripcion: `Todas las escenas una tras otra, ${min(DURACION)} en bucle, con la cortina de pétalos entre una y otra: lo que correría toda la noche.` }, ...ESCENAS];
    const botones = new Map<string, HTMLButtonElement>();
    opciones.forEach((o, i) => {
      if(i === 1){ const h = document.createElement('h2'); h.textContent = 'Una por una'; menu.appendChild(h); }
      const b = document.createElement('button'); b.textContent = o.nombre; b.onclick = () => elegir(o.id, true); menu.appendChild(b); botones.set(o.id, b);
    });
    // la barra de la función: un tramo por escena, proporcional a su duración
    $('barra').innerHTML = ESCENAS.map(e => `<i style="flex:${e.dura}"><b style="width:0"></b></i>`).join('');
    const tramos = [...$('barra').querySelectorAll('b')] as HTMLElement[];
    let actual = 'funcion', t0 = performance.now();
    function elegir(id: string, historia = false){
      actual = opciones.some(o => o.id === id) ? id : 'funcion'; t0 = performance.now();
      const o = opciones.find(o => o.id === actual)!;
      for(const [k, b] of botones) b.classList.toggle('on', k === actual);
      $('grupo').textContent = actual === 'funcion' ? 'función' : 'escena'; $('nombre').textContent = o.nombre; $('desc').textContent = o.descripcion;
      $('barra').style.display = actual === 'funcion' ? '' : 'none';
      document.title = `${o.nombre} · escenas`;
      if(historia) history.replaceState(null, '', '#' + actual);
    }
    elegir(location.hash.slice(1));
    addEventListener('hashchange', () => elegir(location.hash.slice(1)));
    addEventListener('keydown', ev => {
      if(ev.key === 'f' || ev.key === 'F'){ document.fullscreenElement ? document.exitFullscreen() : lienzo.requestFullscreen(); return; }
      const d = ev.key === 'ArrowDown' || ev.key === 'j' ? 1 : ev.key === 'ArrowUp' || ev.key === 'k' ? -1 : 0;
      if(!d) return; ev.preventDefault();
      const i = opciones.findIndex(o => o.id === actual); elegir(opciones[(i + d + opciones.length) % opciones.length].id, true);
    });
    const W = lienzo.width, H = lienzo.height;
    let sonando = '';
    const cuadro = (now: number) => {
      const t = (now - t0)/1000;
      g.setTransform(1, 0, 0, 1, 0, 0); g.globalAlpha = 1; g.globalCompositeOperation = 'source-over'; g.shadowBlur = 0;
      g.fillStyle = '#000'; g.fillRect(0, 0, W, H); g.lineJoin = 'round'; g.lineCap = 'round';
      if(actual === 'funcion'){
        const { escena, local } = funcion(g, W, H, t);
        let desde = 0;
        ESCENAS.forEach((e, i) => { const p = (t % DURACION) - desde; tramos[i].style.width = `${Math.max(0, Math.min(1, p/e.dura))*100}%`; desde += e.dura; });
        if(sonando !== escena.id){ sonando = escena.id; for(const [k, b] of botones) b.classList.toggle('sonando', k === sonando); $('desc').textContent = `Ahora: ${escena.nombre}. ${escena.descripcion}`; }
        void local;
      } else {
        const e = ESCENAS.find(e => e.id === actual)!;
        e.dibujar(g, W, H, t % e.dura);
        if(sonando){ sonando = ''; for(const b of botones.values()) b.classList.remove('sonando'); }
      }
      requestAnimationFrame(cuadro);
    };
    requestAnimationFrame(cuadro);
  </script>
</body>
</html>
