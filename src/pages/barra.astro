---
/**
 * Boceto 3D de la barra con pantalla (Eze, 2026-11-26, después de la reunión con el cliente del restaurante): una
 * barra/mesa larga (250 cm) con una pantalla LED de 60 cm de ancho a lo largo, en el medio, y madera a los dos lados
 * para comer (35 cm por lado por defecto: 130 cm en total); encima, un único vidrio templado que cubre todo (pantalla y madera), sin juntas donde se acumule suciedad o se
 * metan líquidos. En la pantalla corre el dragón plano (src/cronovisor/dragon/dragon2d.ts) a la proporción real de la
 * franja, para ver cómo se lee el contenido.
 * Unlisted y sin indexar, como /dragon/: es para mostrarle la idea al dueño. Medidas en cm (1 unidad = 1 cm).
 */
import Cabecera from '../components/CabeceraMesa.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Barra con pantalla · boceto</title>
  <style is:global>
    html, body { margin: 0; height: 100%; background: #0c0a09; overflow: hidden; font: 12px/1.45 ui-monospace, monospace; color: #cfc8bf; }
    #c { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
    #panel { position: fixed; left: 14px; top: 50px; width: 270px; max-height: calc(100vh - 92px); overflow-y: auto; background: rgba(12,10,9,.82); border: 1px solid #3a332c; padding: 12px 14px; z-index: 2; }
    #panel h1 { font: italic 300 22px/1.1 Georgia, serif; margin: 0 0 10px; color: #f0ede8; }
    #panel label { display: block; margin: 8px 0 2px; color: #9d958b; }
    #panel input[type=range] { width: 100%; }
    #panel .v { float: right; color: #f0ede8; }
    #panel .row { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    #panel button { font: inherit; background: #1b1714; color: #cfc8bf; border: 1px solid #4a4038; padding: 4px 8px; cursor: pointer; }
    #panel button.on { border-color: #e8b04a; color: #fff; }
    .muestras { display: flex; gap: 5px; margin-top: 3px; }
    .muestras button { width: 28px; height: 20px; padding: 0; border: 1px solid #4a4038; cursor: pointer; }
    .muestras button.on { outline: 2px solid #e8b04a; outline-offset: 1px; }
    #datos { margin-top: 10px; border-top: 1px solid #3a332c; padding-top: 8px; }
    #datos div { display: flex; justify-content: space-between; }
    #datos b { font-weight: 400; color: #f0ede8; }
    #datos .mal b { color: #ff7a5a; }
    #datos .bien b { color: #9fe08a; }
    #nota { margin-top: 8px; color: #8d857b; font-size: 11px; }
    .cota { font: 11px ui-monospace, monospace; color: #fff; background: rgba(0,0,0,.6); padding: 1px 5px; border: 1px solid rgba(255,255,255,.25); white-space: nowrap; pointer-events: none; }
    .cota.mal { border-color: #ff7a5a; color: #ffb3a0; }
    body.limpio #panel, body.limpio .cota, body.limpio #tradeoffs { display: none; }
    body.sin-cotas .cota { display: none; }
    /* pros y contras: una hoja a la derecha */
    #tradeoffs { position: fixed; top: 50px; right: 14px; bottom: 34px; width: 430px; overflow-y: auto; background: rgba(12,10,9,.92); border: 1px solid #3a332c; padding: 14px 16px; z-index: 2; display: none; }
    body.con-tradeoffs #tradeoffs { display: block; }
    /* la pestaña para abrirla, siempre a la vista (Eze: que se encuentre desde el boceto) */
    #pestana { position: fixed; top: 50px; right: 14px; z-index: 2; font: italic 300 18px Georgia, serif; color: #f0ede8; background: rgba(12,10,9,.85); border: 1px solid #e8b04a; padding: 8px 14px; cursor: pointer; }
    #pestana span { font: 11px ui-monospace, monospace; color: #e8b04a; margin-left: 8px; }
    body.con-tradeoffs #pestana, body.limpio #pestana { display: none; }
    #tradeoffs h2 { font: italic 300 24px/1.1 Georgia, serif; margin: 0 0 4px; color: #f0ede8; }
    #tradeoffs .sub { color: #8d857b; margin: 0 0 12px; }
    #tradeoffs h3 { font: 11px ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase; color: #9d958b; margin: 16px 0 6px; border-top: 1px solid #3a332c; padding-top: 10px; }
    #tradeoffs .item { margin: 0 0 10px; padding-left: 10px; border-left: 2px solid #4a4038; }
    #tradeoffs .item.bien { border-color: #7fbf6a; } #tradeoffs .item.ojo { border-color: #e8b04a; } #tradeoffs .item.riesgo { border-color: #ff7a5a; }
    #tradeoffs .item b { display: block; color: #f0ede8; font-weight: 400; margin-bottom: 2px; }
    #tradeoffs .item p { margin: 0; color: #bdb5ab; }
    #tradeoffs .item .como { margin-top: 3px; color: #e8d9b8; }
    #tradeoffs .item .como::before { content: '→ '; color: #e8b04a; }
    #tradeoffs .leyenda span { margin-right: 10px; } #tradeoffs .leyenda i { display: inline-block; width: 8px; height: 8px; margin-right: 4px; }
    #tradeoffs .cerrar { position: absolute; top: 10px; right: 12px; background: none; border: 0; color: #8d857b; font: 18px ui-monospace, monospace; cursor: pointer; }
    #ayuda { position: fixed; right: 14px; bottom: 10px; color: #6d655c; z-index: 2; }
  </style>
</head>
<body>
  <Cabecera actual="simulador" fija />
  <canvas id="c"></canvas>
  <div id="panel">
    <h1>Barra con pantalla</h1>
    <label>largo <span class="v" id="vL"></span></label><input id="L" type="range" min="200" max="320" step="5" value="250">
    <label>ancho total <span class="v" id="vD"></span></label><input id="D" type="range" min="80" max="200" step="5" value="130">
    <label>pantalla</label>
    <div class="row" style="margin-top:2px">
      <button id="p-88" class="on">LG 88BH7G · 61 cm</button><button id="p-86">LG 86BH5F · 35 cm</button><button id="p-medida">a medida</button>
    </div>
    <label>ancho de la pantalla <span class="v" id="vS"></span></label><input id="S" type="range" min="20" max="90" step="1" value="61">
    <div class="row">
      <button id="m-barra" class="on">barra 105 · taburetes</button><button id="m-mesa">mesa 75 · sillas</button><button id="m-baja">baja 65 · sillas bajas</button>
    </div>
    <label>en la pantalla</label>
    <div class="row" style="margin-top:2px">
      <button id="c-8" class="on">desde el fondo (8)</button><button id="c-7">espiral (7)</button><button id="c-6">plano (6)</button><button id="c-off">apagada</button>
    </div>
    <div class="row">
      <button id="e-isla" class="on">isla</button><button id="e-patas">patas</button>
    </div>
    <label>madera de la tapa <span class="v" id="nTapa"></span></label><div class="muestras" id="mTapa"></div>
    <label>madera del cuerpo <span class="v" id="nCuerpo"></span></label><div class="muestras" id="mCuerpo"></div>
    <div class="row">
      <button id="vGeneral">general</button><button id="vComensal">comensal</button><button id="vArriba">desde arriba</button>
    </div>
    <div class="row">
      <button id="tVidrio" class="on">vidrio</button><button id="tGente" class="on">vajilla y asientos</button><button id="tCotas" class="on">medidas</button>
    </div>
    <div class="row">
      <button id="tTrade">pros y contras</button>
    </div>
    <div id="datos"></div>
    <div id="nota">Un solo vidrio templado laminado extraclaro sobre todo. Medidas aproximadas: es un boceto para discutir la idea, no un plano de fabricación.</div>
  </div>
  <button id="pestana">Pros y contras <span>T</span></button>
  <aside id="tradeoffs">
    <button class="cerrar" id="cerrarTrade" title="cerrar">×</button>
    <h2>Pros y contras</h2>
    <p class="sub">Barra de 250 cm, pantalla de 60 cm en el medio, madera a los lados y un solo vidrio templado encima.</p>
    <p class="leyenda"><span><i style="background:#7fbf6a"></i>a favor</span><span><i style="background:#e8b04a"></i>se resuelve con diseño</span><span><i style="background:#ff7a5a"></i>riesgo a asumir</span></p>

    <h3>El vidrio de una sola pieza</h3>
    <div class="item bien"><b>Limpieza</b><p>Sin juntas arriba: se limpia de una pasada, no hay ranuras donde se acumule suciedad ni por donde entre líquido a la pantalla o la madera.</p></div>
    <div class="item bien"><b>La madera queda protegida</b><p>Ni manchas de vino ni aceite ni marcas de vasos: la madera se ve siempre nueva.</p><p class="como">A cambio, no se toca: se ve, pero al tacto es vidrio.</p></div>
    <div class="item riesgo"><b>Rayas en la zona donde se come</b><p>El aro sin esmaltar de la base de platos y vasos raya el vidrio con el uso; en un año se nota a contraluz.</p><p class="como">Platos con base esmaltada o con fieltro, individuales o bajoplatos; o, como opción, esmerilado satinado sólo sobre la madera, que disimula las rayas (pero marca más las huellas).</p></div>
    <div class="item riesgo"><b>Si se daña, se cambia entero</b><p>Una rotura o un desportillado en cualquier punto obliga a cambiar la pieza completa (~250 × 130 cm, ~100 kg).</p><p class="como">La alternativa son tres piezas (una sobre la pantalla y una por cada lado) con juntas a ras selladas: se cambia sólo la dañada, pero vuelven las juntas. Es justo lo que se quiere evitar: decidirlo con el cliente.</p></div>
    <div class="item ojo"><b>Seguridad</b><p>Templado laminado (dos hojas de 6 mm con lámina entre medio): si se rompe, queda pegado y no cae sobre la pantalla ni la gente. Cantos pulidos y redondeados.</p></div>
    <div class="item ojo"><b>Fabricación e instalación</b><p>~98 kg. Después de templado no se puede cortar ni agujerear: todos los agujeros y cortes van de fábrica. Instalación con ventosas, entre 3 o 4 personas; la estructura tiene que estar calculada para ese peso.</p></div>
    <div class="item ojo"><b>Perímetro</b><p>Sin juntas arriba, pero el borde del vidrio sí es una junta con la madera de abajo.</p><p class="como">Sellado perimetral y un canto con goterón, para que lo que se derrame caiga al suelo y no se meta por debajo.</p></div>

    <h3>La pantalla bajo el vidrio</h3>
    <div class="item ojo"><b>Reflejos</b><p>Toda lámpara que quede en el ángulo de espejo entre la pantalla y el ojo del comensal se refleja en el vidrio.</p><p class="como">Se resuelve con el diseño de luz: lámparas sobre la madera y los platos, no sobre el centro de la pantalla; luz cálida y difusa; techo oscuro o mate. Plan B: vidrio con capa antirreflejo (más caro).</p></div>
    <div class="item ojo"><b>Nitidez y doble imagen</b><p>Si entre la pantalla y el vidrio queda aire, se ve un doble reflejo y la imagen pierde contraste.</p><p class="como">Pantalla lo más pegada posible al vidrio, y vidrio extraclaro (el común tiñe de verde).</p></div>
    <div class="item ojo"><b>Tipo de pantalla</b><p>Se ve a menos de un metro: un LED común muestra los puntitos. 244 × 58 cm (4,2:1) no es un tamaño estándar de LCD; con LED en módulos se arma a medida.</p><p class="como">LED de paso fino (1,2 mm o menos) o varios LCD (con marcos visibles entre ellos). Pedir cotización de las dos.</p></div>
    <div class="item riesgo"><b>Calor</b><p>~1,4 m² de pantalla encendida muchas horas, debajo de un vidrio: se calienta la pantalla y el vidrio se entibia donde apoyan los platos.</p><p class="como">Ventilación por el cuerpo de la barra, sin sellarla; ventiladores silenciosos (están a centímetros de las piernas); brillo moderado (el local es oscuro, no hace falta el máximo).</p></div>
    <div class="item riesgo"><b>Mantenimiento</b><p>Con el vidrio pegado arriba, a la pantalla no se llega desde arriba.</p><p class="como">Acceso por debajo: tapa de servicio en el cuerpo de la barra y pantalla de mantenimiento trasero. Si hay que sacar el vidrio, son ~100 kg.</p></div>
    <div class="item ojo"><b>Costo</b><p>La pantalla es la parte cara del proyecto, bastante más que el vidrio y la madera.</p></div>

    <h3>La altura</h3>
    <div class="item ojo"><b>Sillas bajas, mesa baja</b><p>Con sillas bajas la mesa baja también (silla de 46 → mesa de 75; silla baja de 40 → mesa de 65). Pero el grosor de la tapa y lo que ocupa la pantalla por debajo le roban sitio a las piernas: con sillas bajas quedan ~20 cm para los muslos bajo la madera, justo, y menos bajo la pantalla, adonde llegan las rodillas.</p><p class="como">Pantalla y caja lo más finas posible (la electrónica, en la cabecera o en un mueble aparte, no bajo la mesa), tapa fina, y sillas sin apoyabrazos que choquen. Conviene probar sentado con una maqueta de cartón a la altura real.</p></div>

    <h3>El contenido</h3>
    <div class="item bien"><b>La proporción funciona</b><p>En 4,2:1 un dragón que cruza a lo largo se ve grande y entero; el mismo sistema de /dragon/ se adapta a esta medida.</p></div>
    <div class="item ojo"><b>Comer y mirar</b><p>Los platos están al lado de la pantalla, no encima: no tapan la imagen. Pero si el contenido es muy rápido o brillante, cansa durante una cena.</p><p class="como">Movimientos lentos, fondo oscuro, brillo bajo; y una pasada cada tanto, no imagen continua.</p></div>
  </aside>
  <div id="ayuda">arrastrá para girar · rueda para acercar · H oculta el panel · T pros y contras</div>
  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
    import { CSS2DRenderer, CSS2DObject } from 'three/addons/renderers/CSS2DRenderer.js';
    import { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';
    import { RectAreaLightUniformsLib } from 'three/addons/lights/RectAreaLightUniformsLib.js';
    import { DragonPlano } from '../cronovisor/dragon/dragon2d';

    const cv = document.getElementById('c') as HTMLCanvasElement;
    const renderer = new THREE.WebGLRenderer({ canvas: cv, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    RectAreaLightUniformsLib.init();
    renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.NeutralToneMapping; renderer.toneMappingExposure = 1.2;   // neutro: ACES lavaba y corría el color de la madera
    const etiquetas = new CSS2DRenderer(); etiquetas.domElement.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:1';
    document.body.appendChild(etiquetas.domElement);
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0c0a09);
    scene.fog = new THREE.Fog(0x0c0a09, 700, 1500);
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), .04).texture;
    scene.environmentIntensity = .35;   // el estudio blanco del entorno, apagado: es un restaurante en penumbra
    const camera = new THREE.PerspectiveCamera(40, 1, 1, 5000);
    const controls = new OrbitControls(camera, cv);
    controls.enableDamping = true; controls.maxPolarAngle = Math.PI*.495;

    // La luz (más realista, Eze 2026-11-26): un relleno bajo de sala, una luz clave alta y casi cenital que da las sombras
    // (como si fueran las de las lámparas), y en `armar` las dos lámparas lineales colgadas sobre la madera (luz de área,
    // como recomienda la hoja de pros y contras: no sobre la pantalla, para no reflejarse) y la pantalla misma, que
    // ilumina un poco la vajilla con sus colores.
    scene.add(new THREE.HemisphereLight(0xfff3e6, 0x1a1612, .22));
    const lampara = new THREE.DirectionalLight(0xffeedd, .9);
    lampara.position.set(-40, 420, 70); lampara.castShadow = true;
    lampara.shadow.mapSize.set(2048, 2048); lampara.shadow.bias = -.0004; lampara.shadow.normalBias = .4;
    Object.assign(lampara.shadow.camera, { left: -230, right: 230, top: 170, bottom: -170, near: 100, far: 700 });
    scene.add(lampara);
    // la sala: piso de microcemento pulido (refleja un poco), paredes de revoque oscuro y techo, para que la luz rebote
    // y los reflejos no salgan de la nada
    function texturaCemento(){
      const W = 1024, c = document.createElement('canvas'); c.width = c.height = W; const g = c.getContext('2d')!;
      const img = g.createImageData(W, W), n = ruido(9), n2 = ruido(11);
      for(let y = 0; y < W; y++) for(let x = 0; x < W; x++){
        const u = x/W, v = y/W, k = (y*W + x)*4;
        const val = 62 + (n(u*6, v*6, 5) - .5)*34 + (n2(u*40, v*40, 3) - .5)*10 + (n(u*1.5, v*1.5, 2) - .5)*20;
        img.data[k] = val*1.04; img.data[k + 1] = val; img.data[k + 2] = val*.94; img.data[k + 3] = 255;
      }
      g.putImageData(img, 0, 0);
      const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(8, 8); t.anisotropy = 8;
      return t;
    }
    const piso = new THREE.Mesh(new THREE.PlaneGeometry(1600, 1600), new THREE.MeshStandardMaterial({ map: texturaCemento(), roughness: .32, metalness: 0, envMapIntensity: .8 }));
    piso.rotation.x = -Math.PI/2; piso.receiveShadow = true; scene.add(piso);
    const sala = new THREE.Mesh(new THREE.BoxGeometry(1600, 340, 1100), new THREE.MeshStandardMaterial({ color: 0x2b2420, roughness: .95, side: THREE.BackSide }));
    sala.position.y = 170.1; sala.receiveShadow = true; scene.add(sala);

    // madera: una veta dibujada en un canvas, por especie (Eze: elegir tipos y colores de madera). Colores aproximados
    // de cada madera con un acabado natural mate; la veta: líneas onduladas más oscuras y más claras que la base.
    const MADERAS = {
      'roble claro': { base: '#c9a46e', osc: '110,72,32', clara: '238,210,165', rugosa: .55 },
      'roble':       { base: '#a8743f', osc: '80,45,15', clara: '205,160,105', rugosa: .55 },
      'fresno':      { base: '#d8c6a2', osc: '140,115,80', clara: '245,232,205', rugosa: .5 },
      'cerezo':      { base: '#9c5232', osc: '70,25,10', clara: '200,120,80', rugosa: .45 },
      'teca':        { base: '#8d5a2f', osc: '60,32,12', clara: '180,125,75', rugosa: .5 },
      'nogal':       { base: '#5b3b24', osc: '32,18,8', clara: '140,95,62', rugosa: .5 },
      'wengué':      { base: '#3a2a20', osc: '14,9,6', clara: '110,85,65', rugosa: .6 },
    } as const;
    type Madera = keyof typeof MADERAS;
    // La veta, más natural (Eze: "que la madera tenga textura más natural"): calculada píxel a píxel con ruido. Los anillos
    // de crecimiento corren a lo largo de la tabla y ondulan (el ruido los desvía, y a veces se abren en arcos como el
    // corte de una tabla de verdad); el leño tardío de cada anillo, más oscuro; poros finos alargados; manchas suaves de
    // tono a lo largo; y la misma veta como relieve (bumpMap), así la luz rasante la marca. Con semilla fija: siempre igual.
    const texturas = new Map<Madera, { mapa: THREE.CanvasTexture; relieve: THREE.CanvasTexture }>();
    const hex = (h: string) => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
    function ruido(semilla: number){
      const h = (x: number, y: number) => { const s = Math.sin(x*127.1 + y*311.7 + semilla*74.7)*43758.5453; return s - Math.floor(s); };
      const suav = (t: number) => t*t*(3 - 2*t);
      const v = (x: number, y: number) => {
        const xi = Math.floor(x), yi = Math.floor(y), xf = suav(x - xi), yf = suav(y - yi);
        const a = h(xi, yi), b = h(xi + 1, yi), c = h(xi, yi + 1), d = h(xi + 1, yi + 1);
        return a + (b - a)*xf + (c - a)*yf + (a - b - c + d)*xf*yf;
      };
      return (x: number, y: number, oct = 4) => { let s = 0, a = .5, f = 1; for(let o = 0; o < oct; o++){ s += a*v(x*f, y*f); a *= .5; f *= 2.03; } return s; };
    }
    function texturaMadera(nombre: Madera){
      if(texturas.has(nombre)) return texturas.get(nombre)!;
      const m = MADERAS[nombre], W = 2048, H = 512;
      const base = hex(m.base), osc = m.osc.split(',').map(Number), clara = m.clara.split(',').map(Number);
      const c = document.createElement('canvas'); c.width = W; c.height = H; const g = c.getContext('2d')!;
      const cb = document.createElement('canvas'); cb.width = W; cb.height = H; const gb = cb.getContext('2d')!;
      const img = g.createImageData(W, H), bump = gb.createImageData(W, H);
      const n1 = ruido(1), n2 = ruido(2), n3 = ruido(3);
      const anillos = nombre === 'wengué' ? 46 : nombre === 'fresno' || nombre.startsWith('roble') ? 34 : 28;
      for(let y = 0; y < H; y++) for(let x = 0; x < W; x++){
        const u = x/W, v = y/H;
        // el desvío de los anillos: lento a lo largo, y un arco ancho que se abre en algunos tramos
        const desvio = n1(u*3, v*2)*1.6 + Math.pow(Math.max(0, Math.sin(u*Math.PI*2.3 + n1(u, v)*2)), 6)*.45*Math.sin(v*Math.PI);
        // separación irregular entre anillos (años de más o menos crecimiento), que además cambia despacio a lo largo:
        // las líneas se juntan y se separan como en una tabla de verdad
        const t = v*anillos + n2(u*1.2, v*5, 3)*7 + desvio*anillos*.1;
        const f = t - Math.floor(t);
        const tardio = (Math.pow(f, 4 + 6*n3(Math.floor(t)*.37, 0, 1))*.75 + .08*n2(u*40, v*anillos*.6, 2))*(.6 + .8*n1(u*5, v*3, 2));   // la banda oscura de cada anillo, irregular
        const poro = Math.max(0, n3(u*320, v*60, 2) - .66)*1.6;                 // poros: puntos alargados a lo largo
        const mancha = n2(u*2.5, v*1.5, 3) - .5;                              // variaciones suaves de tono
        const k = (y*W + x)*4;
        for(let ch = 0; ch < 3; ch++){
          let col = base[ch]*(1 + mancha*.14);
          col += (clara[ch] - base[ch])*Math.max(0, .3 - tardio)*.35;           // el leño temprano, más claro
