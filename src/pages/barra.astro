      // la pantalla: el dragón a la proporción real (largo × ancho de la franja)
      const pw = 2048, ph = Math.max(64, Math.round(pw*PA.imgA/PA.imgL));
      if(pantallaCv.width !== pw || pantallaCv.height !== ph){ pantallaCv.width = pw; pantallaCv.height = ph; pantallaTex.dispose(); }   // otra medida: la textura se rehace (si no, queda con la vieja y la imagen sale partida)
      // el contenido: las variantes de /dragon/ que comparten el motor 2D, a la proporción de esta pantalla. El 7 (desde
      // el fondo) va un poco más chico: en una franja angosta necesita sitio a lo alto para su espiral
      dragones = {};
      dragon = hacerDragon(pw, ph);
      datos();
    }

    // cuánto vuela la tapa sobre la isla por los lados largos: lo que necesitan las rodillas, sin pasar de la madera
    function voladizo(){ const lado = (P.D - P.S)/2; return Math.max(15, Math.min(lado, P.modo === 'barra' ? 30 : 35)); }
    function datos(){
      const { L, D, S } = P, lado = (D - S)/2, PA = pantalla(), MO = P.modelo ? MODELOS[P.modelo] : null;
      const area = L*D/1e4, peso = area*12*2.5;                 // laminado 6+6 mm: 2,5 kg por m² y mm
      const puestos = Math.max(2, Math.floor(L/62))*2;
      const M = MODOS[P.modo], top = M.mesa - 1.2;
      const libreMadera = top - 4 - M.asiento, librePantalla = top - bajoPantalla() - M.asiento;   // entre el asiento y lo de arriba
      const fila = (t: string, v: string, cls = '') => `<div class="${cls}"><span>${t}</span><b>${v}</b></div>`;
      document.getElementById('datos')!.innerHTML =
        fila('madera por lado', `${lado.toFixed(1)} cm`, lado < 30 ? 'mal' : 'bien') +
        fila('plato de 27 cm', lado >= 30 ? 'entra' : 'no entra', lado >= 30 ? 'bien' : 'mal') +
        (MO ? fila('modelo', MO.nombre) + fila('resolución', MO.res) + fila('brillo', `${MO.brillo} nits`) +
              fila('consumo (calor en la isla)', `${MO.w[0]} W, máx. ${MO.w[1]}`, MO.w[0] > 300 ? 'mal' : '') +
              fila('peso de la pantalla', `${MO.kg} kg`) + fila('boca arriba', 'consultar a LG (N/D)', 'mal') : '') +
        fila('imagen', `${PA.imgL.toFixed(1)} × ${PA.imgA.toFixed(1)} cm (${(PA.imgL/PA.imgA).toFixed(1)}:1)`) +
        (PA.largo < L - .5 ? fila('madera en cada punta', `${((L - PA.largo)/2).toFixed(1)} cm`) : '') +
        fila('vidrio', `${L} × ${D} cm, ${area.toFixed(2)} m²`) +
        fila('peso del vidrio (12 mm)', `~${Math.round(peso)} kg`) +
        fila('comensales', `${puestos}`) +
        fila('altura de la mesa', `${M.mesa} cm (${M.nombre} ${M.asiento})`) +
        fila('muslos, bajo la madera', `${libreMadera.toFixed(0)} cm`, libreMadera < 20 ? 'mal' : 'bien') +
        (P.estructura === 'isla'
          ? fila('vuelo para las rodillas', `${voladizo().toFixed(0)} cm`, voladizo() < 25 ? 'mal' : 'bien')
          : (P.modo === 'barra' ? '' : fila('rodillas, bajo la pantalla', `${librePantalla.toFixed(0)} cm`, librePantalla < 20 ? 'mal' : 'bien')));
      for(const [id, v] of [['vL', `${L} cm`], ['vD', `${D} cm`], ['vS', `${+S.toFixed(1)} cm`]]) document.getElementById(id)!.textContent = v;
    }

    // controles
    const rango = (id: 'L' | 'D' | 'S') => {
      const el = document.getElementById(id) as HTMLInputElement;
      el.addEventListener('input', () => {
        P[id] = Number(el.value);
        if(id === 'S') elegirModelo(null, false);
        if(P.S > P.D - 4){ P.S = P.D - 4; (document.getElementById('S') as HTMLInputElement).value = String(P.S); }
        armar();
      });
    };
    rango('L'); rango('D'); rango('S');
    // un modelo de LG: fija el ancho de la pantalla a su medida y deja 35 cm de madera por lado; "a medida" libera el
    // ancho (y la pantalla vuelve a ocupar todo el largo)
    function elegirModelo(m: Modelo | null, rearmar = true){
      P.modelo = m;
      if(m){
        P.S = MODELOS[m].ext[1]/10; P.D = Math.round((P.S + 70)/5)*5;
        (document.getElementById('S') as HTMLInputElement).value = String(Math.round(P.S));
        (document.getElementById('D') as HTMLInputElement).value = String(P.D);
        if(P.L < MODELOS[m].ext[0]/10 + 4){ P.L = 250; (document.getElementById('L') as HTMLInputElement).value = '250'; }
      }
      for(const [id, v] of [['p-88', '88'], ['p-86', '86'], ['p-medida', null]] as const) document.getElementById(id)!.classList.toggle('on', v === m);
      if(rearmar) armar();
    }
    document.getElementById('p-88')!.addEventListener('click', () => elegirModelo('88'));
    document.getElementById('p-86')!.addEventListener('click', () => elegirModelo('86'));
    document.getElementById('p-medida')!.addEventListener('click', () => elegirModelo(null));
    const boton = (id: string, f: (b: HTMLButtonElement) => void) => { const b = document.getElementById(id) as HTMLButtonElement; b.addEventListener('click', () => f(b)); };
    for(const e of ['isla', 'patas'] as const) boton('e-' + e, () => {
      P.estructura = e; document.getElementById('e-isla')!.classList.toggle('on', e === 'isla'); document.getElementById('e-patas')!.classList.toggle('on', e === 'patas'); armar();
    });
    for(const [id, campo] of [['mTapa', 'tapa'], ['mCuerpo', 'cuerpo']] as const){
      const cont = document.getElementById(id)!;
      for(const nombre of Object.keys(MADERAS) as Madera[]){
        const b = document.createElement('button'); b.dataset.m = nombre; b.title = nombre; b.style.background = MADERAS[nombre].base;
        b.addEventListener('click', () => { P[campo] = nombre; vestir(); }); cont.appendChild(b);
      }
    }
    vestir();
    for(const m of ['barra', 'mesa', 'baja'] as Modo[]) boton('m-' + m, () => {
      P.modo = m;
      for(const o of ['barra', 'mesa', 'baja']) document.getElementById('m-' + o)!.classList.toggle('on', o === m);
      armar(); vista('general');
    });
    boton('tVidrio', b => { P.vidrio = !P.vidrio; b.classList.toggle('on', P.vidrio); armar(); });
    for(const c of ['6', '7', '8', 'off'] as const) boton('c-' + c, () => {
      P.conDragon = c !== 'off';
      if(c !== 'off'){ P.contenido = c; dragon = hacerDragon(pantallaCv.width, pantallaCv.height); }
      for(const o of ['6', '7', '8', 'off']) document.getElementById('c-' + o)!.classList.toggle('on', o === c);
    });
    boton('tCotas', b => { const on = !b.classList.contains('on'); b.classList.toggle('on', on); document.body.classList.toggle('sin-cotas', !on); });
    boton('tGente', b => { P.gente = !P.gente; b.classList.toggle('on', P.gente); armar(); });
    const trade = (abrir?: boolean) => { const on = document.body.classList.toggle('con-tradeoffs', abrir); document.getElementById('tTrade')!.classList.toggle('on', on); };
    boton('tTrade', () => trade()); boton('cerrarTrade', () => trade(false)); boton('pestana', () => trade(true));
    if(new URLSearchParams(location.search).has('tradeoffs')) trade(true);
    // vistas: la cámara viaja suave hasta cada una
    let viaje: { p0: THREE.Vector3; p1: THREE.Vector3; t0: THREE.Vector3; t1: THREE.Vector3; desde: number } | null = null;
    function vista(cual: string, inmediato = false){
      const alto = MODOS[P.modo].mesa;
      const poses: Record<string, [number[], number[]]> = {
        general: [[-280, alto + 190, 320 + P.D*.5], [0, alto - 25, 0]],
        comensal: [[-40, alto + 45, P.D/2 + 45], [30, alto, -P.D*.1]],
        arriba: [[0, alto + 460, .1], [0, alto, 0]],
      };
      const [p, t] = poses[cual];
      if(inmediato){ camera.position.set(p[0], p[1], p[2]); controls.target.set(t[0], t[1], t[2]); return; }
      viaje = { p0: camera.position.clone(), p1: new THREE.Vector3(...p), t0: controls.target.clone(), t1: new THREE.Vector3(...t), desde: performance.now() };
    }
    boton('vGeneral', () => vista('general')); boton('vComensal', () => vista('comensal')); boton('vArriba', () => vista('arriba'));
    addEventListener('keydown', e => { const k = e.key.toLowerCase(); if(k === 'h') document.body.classList.toggle('limpio'); if(k === 't') trade(); });

    function tamano(){
      renderer.setSize(innerWidth, innerHeight, false); etiquetas.setSize(innerWidth, innerHeight);
      camera.aspect = innerWidth/innerHeight; camera.updateProjectionMatrix();
    }
    addEventListener('resize', tamano);
    tamano(); armar(); vista('general', true);

    const t0 = performance.now();
    let cuadro = 0;
    const mediaCv = document.createElement('canvas'); mediaCv.width = mediaCv.height = 1;
    const mediaCtx = mediaCv.getContext('2d', { willReadFrequently: true })!;
    function frame(now: number){
      requestAnimationFrame(frame);
      if(viaje){
        const q = Math.min(1, (now - viaje.desde)/1200), e = q*q*(3 - 2*q);
        camera.position.lerpVectors(viaje.p0, viaje.p1, e); controls.target.lerpVectors(viaje.t0, viaje.t1, e);
        if(q >= 1) viaje = null;
      }
      controls.update();
      // la pantalla: el dragón cruzando la franja (o apagada, en negro)
      const t = (now - t0)/1000;
      pctx.setTransform(1, 0, 0, 1, 0, 0); pctx.fillStyle = '#000'; pctx.fillRect(0, 0, pantallaCv.width, pantallaCv.height);
      if(P.conDragon && dragon) dragon.draw(pctx, (t/pasada()) % 1, t);
      pantallaTex.needsUpdate = true;
      // el color medio de la pantalla, cada pocos cuadros, para la luz que echa sobre la vajilla
      if(luzPantalla && (cuadro++ % 6 === 0)){
        mediaCtx.drawImage(pantallaCv, 0, 0, 1, 1);
        const [cr, cg, cb] = mediaCtx.getImageData(0, 0, 1, 1).data;
        luzPantalla.color.setRGB(cr/255, cg/255, cb/255, THREE.SRGBColorSpace);
        luzPantalla.intensity = P.conDragon ? 1400 : 0;   // un reflejo suave en la vajilla, no un foco
      }
      renderer.render(scene, camera); etiquetas.render(scene, camera);
    }
    requestAnimationFrame(frame);
    (window as any).__barra = { P, armar, vista, camera };
  </script>
</body>
</html>
