      // each burst lights the envelope from inside, warmest at full burn
      const full = s.lit === 11 && !s.over;
      const blast = Math.pow(Math.max(0, Math.sin(now*.0007)), 14);
      const burning = s.mode === 'pilot' && !!pilot && !pilot.selecting && burnerOn;
