        const k = t < .5 ? 4*t*t*t : 1-Math.pow(-2*t+2, 3)/2;
        camera.position.lerpVectors(flight.fromP, flight.toP, k);
        camera.position.y += Math.sin(Math.PI*k)*flight.arc;
        look.lerpVectors(flight.fromL, flight.toL, Math.min(1, k*1.25));
