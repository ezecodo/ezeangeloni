        if(!w.home) return;
        if(k !== worldAt) w.phase += dt*Math.PI*2/90;
        w.mesh.position.set(w.home.x + Math.cos(w.phase)*2.4, w.home.y + Math.sin(w.phase*2)*.8, w.home.z + Math.sin(w.phase)*2.4);
