          <span id="set-time-total">--:--</span>
        </div>
        <button id="set-copy">copy link</button>
      </div>
      <div id="set-tracklist"></div>
      <audio id="set-audio" preload="metadata"></audio>
    </div>
  </div>

  <div id="about-sheet" class="sheet">
    <button class="close" id="about-close">close ✕</button>
    <h2>About</h2>
    <div id="about-body">
      <p>Hey, I'm Eze. I build things for the web — from the database to the pixel.</p>
      <p>Originally from Argentina, now based in Barcelona, I've spent years at the intersection of technology and culture. I've helped organize theatre festivals, been part of interdisciplinary collectives, and worked on projects that use culture as a bridge between societies. That background shapes how I approach every line of code — with purpose, context, and people in mind.</p>
      <p>On the technical side, I'm a full-stack developer working with Next.js, React, and Node — building editorial platforms, CMS systems, and interactive experiences.</p>
      <p>Currently available for freelance work. If you've got something interesting brewing, I'd love to hear about it.</p>
    </div>
    <p id="how-to-fly"><button id="tour-again">how to fly ↗</button></p>
    <form id="signin" autocomplete="on">
      <label for="signin-pass">is this your galaxy? sign in</label>
      <div><input id="signin-pass" name="password" type="password" autocomplete="current-password" placeholder="your password" /><button>sign in</button></div>
      <p id="signin-msg"></p>
    </form>
    <p id="signed-as" hidden></p>
  </div>

  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
    import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
    import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
    import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';

    const COLORS = ['#ff3f3f','#ff9f1c','#6ef9f5','#b8f75b','#c77dff','#ff6eb4','#38bdf8','#ffd166'];
    const NOTES =  [392, 440, 523, 587, 659, 349, 466, 311];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouch = window.matchMedia('(hover: none)').matches;
    const $ = (id: string) => document.getElementById(id)!;
    function rnd(a: number, b: number){ return a + Math.random()*(b-a); }
    function hexRgb(h: string){ return [1,3,5].map(i => parseInt(h.slice(i,i+2),16)/255); }

    // ── Sound ─────────────────────────────────────────────
    let audioCtx: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let staticGain: GainNode | null = null;
    let staticFilter: BiquadFilterNode | null = null;
    let soundOn = localStorage.getItem('sound') !== 'off';
    function ensureAudio(){
      if(audioCtx){ if(audioCtx.state === 'suspended') audioCtx.resume(); return; }
      audioCtx = new AudioContext();
      masterGain = audioCtx.createGain();
      masterGain.gain.value = soundOn ? 0.18 : 0;
      masterGain.connect(audioCtx.destination);
      const noise = audioCtx.createBuffer(1, audioCtx.sampleRate*2, audioCtx.sampleRate);
      const data = noise.getChannelData(0);
      for(let i = 0; i < data.length; i++) data[i] = Math.random()*2 - 1;
      const src = audioCtx.createBufferSource();
      src.buffer = noise; src.loop = true;
      staticFilter = audioCtx.createBiquadFilter();
      staticFilter.type = 'bandpass'; staticFilter.Q.value = 0.8;
      staticGain = audioCtx.createGain();
      staticGain.gain.value = 0;
      src.connect(staticFilter); staticFilter.connect(staticGain); staticGain.connect(masterGain);
      src.start();
    }
    function playNote(freq: number){
      if(!audioCtx || !masterGain) return;
      const t = audioCtx.currentTime;
      function layer(f: number, type: OscillatorType, vol: number, dur: number, pitchDrop = 1){
        const osc = audioCtx!.createOscillator();
        const g = audioCtx!.createGain();
        osc.connect(g); g.connect(masterGain!);
        osc.type = type;
        osc.frequency.setValueAtTime(f, t);
        if(pitchDrop !== 1) osc.frequency.exponentialRampToValueAtTime(f * pitchDrop, t + dur * 0.6);
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + dur);
        osc.start(t); osc.stop(t + dur);
      }
      layer(freq,     'sine',     1.0,  0.35, 0.75); // main — suave con pitch drop
      layer(freq/2,   'triangle', 0.5,  0.18);        // bass — cuerpo, corto
      layer(freq*2,   'sine',     0.15, 0.2);         // shimmer — brillo suave
    }
    let songPlaying = false;
    // Note frequencies
    const G4=392, A4=440, B4=493.88, C5=523.25, D5=587.33, E4=329.63, D4=293.66, C4=261.63;
    // [freq, duration_seconds] — 0 = rest
    const REDEMPTION: [number,number][] = [
      // "Old pi-rates, yes, they rob I"
      [G4,.4],[B4,.4],[A4,.3],[G4,.3],[E4,.4],[D4,.3],[E4,.3],[G4,.7],
      // "Sold I to the mer-chant ships"
      [G4,.4],[B4,.4],[A4,.3],[G4,.3],[E4,.4],[D4,.3],[C4,.3],[D4,.7],
      // "Mi-nutes af-ter they took I"
      [E4,.4],[D4,.3],[E4,.3],[G4,.4],[E4,.3],[D4,.7],
      // "From the bot-tom-less pit"
      [G4,.4],[B4,.4],[A4,.3],[G4,.3],[E4,.8],
      [0,.5],
      // "Won't you help to sing"
      [G4,.4],[G4,.25],[A4,.25],[B4,.4],[A4,.3],[G4,.7],
      // "These songs of free-dom"
      [G4,.4],[A4,.3],[B4,.4],[A4,.3],[G4,.3],[E4,.7],
      // "'Cause all I ev-er had"
      [G4,.4],[G4,.25],[A4,.25],[B4,.4],[A4,.3],[G4,.3],[E4,.3],[D4,.5],
      // "Re-demp-tion songs"
      [G4,.4],[B4,.4],[D5,.4],[C5,.3],[B4,.9],
      [0,.3],
      // "Re-demp-tion songs" (repeat, hold)
      [G4,.4],[B4,.4],[D5,.4],[C5,.3],[B4,1.4],
    ];
    async function playSong(){
      if(songPlaying || !audioCtx || !masterGain) return;
      songPlaying = true;
      for(const [freq, dur] of REDEMPTION){
        if(!songPlaying) break;
        if(freq > 0){
          const osc = audioCtx.createOscillator();
          const g = audioCtx.createGain();
          osc.connect(g); g.connect(masterGain);
          osc.type = 'triangle';
          osc.frequency.value = freq;
          g.gain.setValueAtTime(0.9, audioCtx.currentTime);
          g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur * 0.85);
          osc.start(); osc.stop(audioCtx.currentTime + dur);
        }
        await new Promise(r => setTimeout(r, dur * 1000));
      }
      songPlaying = false;
    }
    const btnSound = $('btn-sound');
    function syncSound(){
      btnSound.classList.toggle('on', soundOn);
      btnSound.setAttribute('aria-pressed', String(soundOn));
      if(masterGain) masterGain.gain.value = soundOn ? 0.18 : 0;
      if(!soundOn) songPlaying = false;
    }
    function toggleSound(){
      soundOn = !soundOn;
      try { localStorage.setItem('sound', soundOn ? 'on' : 'off'); } catch {}
      syncSound();
    }
    btnSound.addEventListener('click', toggleSound);
    syncSound();
    window.addEventListener('pointerdown', ensureAudio);
    window.addEventListener('keydown', ensureAudio);

    // ── Stations ──────────────────────────────────────────
    interface TrackPoint { at: number; label: string; }
    interface SetMeta { slug: string; title: string; date: string; audio: string; artwork?: string; tracklist?: TrackPoint[]; duration?: number; bpm?: number; musicalKey?: string; }
    interface Station {
      kind: 'home' | 'photo' | 'text' | 'set';
      n: number;            // archive number, oldest = 1 (shifts when something is dated into the past)
      id: string;           // stable share link: photo file name, t+hash of a frase, s-slug of a set
      legacy?: number;      // the old #NNN link, counted without pieces uploaded later into the past
      date: string;
      text: string;         // frase, caption or set title
      src?: string;
      set?: SetMeta;
      tint: string;
      flood: boolean;       // full-colour plate instead of type on the void
    }
    let stations: Station[] = [{ kind:'home', n:0, id:'', date:'', text:'', tint:'#c77dff', flood:false }];
    let total = 0;

    // ── Which galaxy ──────────────────────────────────────
    // ezeangeloni.xyz is Eze's galaxy. Others (family, invite-only, created from his admin) open with ?g=<slug>
    // (or /g/<slug> where nginx sends it here). Their data lives in /galaxies/<slug>-<token>/, same files as Eze's
    // at the root. A private one's folder is only told at its door (/api/frases/doors): to this device once its
    // owner let it in, or to anyone logged into the admin as the owner of a galaxy that was let in.
    interface Kin { kin: number; tone: number; sign: number; }
    interface GalaxyEntry { slug: string; name: string; public: boolean; dir?: string; kin?: Kin | null; }
    let mainKin: Kin | null = null;
    interface Door { status: 'open' | 'pending' | 'declined' | 'closed'; dir?: string; }
    const qs = new URLSearchParams(location.search);
    const GAL = (location.pathname.match(/^\/g\/([a-z0-9-]+)/)?.[1] || qs.get('g') || '').toLowerCase();
    const store = { get: (k: string) => { try { return localStorage.getItem(k) || ''; } catch { return ''; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} } };
    const DEVICE = store.get('cv-device') || (() => { const d = Array.from(crypto.getRandomValues(new Uint8Array(16)), b => b.toString(16).padStart(2, '0')).join(''); store.set('cv-device', d); return d; })();
    const ownerPass = store.get('eze-upload-pass'); // logged into an admin here: this device belongs to a galaxy's owner
    const doorHeaders = (): Record<string, string> => ({ 'Content-Type': 'application/json', ...(ownerPass ? { 'X-Auth': ownerPass } : {}) });
    let doors: Record<string, Door> = {};
    let BASE = '', galaxyName = 'Eze', locked = false;
    async function askDoors(slugs: string[]){
      if(!slugs.length) return;
      const d = await fetch('/api/frases/doors', { method: 'POST', headers: doorHeaders(), body: JSON.stringify({ device: DEVICE, galaxies: slugs }) }).then(r => r.ok ? r.json() : null).catch(() => null);
      if(d?.doors) doors = { ...doors, ...d.doors };
    }
    let registry: GalaxyEntry[] = [];
    type Frase = {texto?: string, imagen?: string, caption?: string, fecha?: string, subida?: string};
    function hash36(s: string){
      let h = 0x811c9dc5;
      for(let i = 0; i < s.length; i++){ h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
      return (h >>> 0).toString(36);
    }
    function buildStations(frases: Frase[], sets: SetMeta[]){
      const merged = [
        ...frases.filter(f => f.imagen || f.texto).map(f => ({ date: f.fecha || '', f, s: null as SetMeta | null })),
        ...sets.map(s => ({ date: s.date || '', f: null, s })),
      ].sort((a,b) => a.date.localeCompare(b.date));
      // Links used to be the archive number. Pieces dated into the past (uploaded later, `subida`) shift it,
      // so old #NNN links are resolved by counting without them.
      let legacy = 0;
      const out: Station[] = merged.map((m, i) => {
        const n = i + 1, tint = COLORS[n % COLORS.length];
        const back = !!(m.f?.subida && m.f.subida > m.date);
        const old = back ? undefined : ++legacy;
        if(m.s) return { kind:'set', n, id:'s-'+m.s.slug, legacy:old, date:m.date, text:m.s.title, src:m.s.artwork, set:m.s, tint:'#ff6eb4', flood:!m.s.artwork };
        if(m.f!.imagen) return { kind:'photo', n, id:m.f!.imagen.split('/').pop()!.replace(/\.\w+$/, ''), legacy:old, date:m.date, text:m.f!.caption || '', src:BASE + m.f!.imagen, tint, flood:false };
        return { kind:'text', n, id:'t'+hash36(m.date+m.f!.texto), legacy:old, date:m.date, text:m.f!.texto!, tint, flood: n % 3 === 0 };
      });
      total = out.length;
      stations = [stations[0], ...out.reverse()]; // newest at the centre: distance is time
    }

    // ── Cards ─────────────────────────────────────────────
    // Sets a frase as big as the plate allows, so one word hits harder than a paragraph.
    function fitText(c: CanvasRenderingContext2D, text: string, boxW: number, boxH: number){
      const font = (s: number) => `italic 300 ${s}px 'Cormorant Garamond', serif`;
      const wrap = (s: number) => {
        c.font = font(s);
        const lines: string[] = [];
        let line = '';
        for(const w of text.trim().split(/\s+/)){
          if(c.measureText(w).width > boxW) return null;
          const next = line ? line + ' ' + w : w;
          if(c.measureText(next).width > boxW){ lines.push(line); line = w; } else line = next;
        }
        lines.push(line);
        return lines.length * s * .98 <= boxH ? lines : null;
      };
      let lo = 10, hi = Math.floor(boxH), best = wrap(lo) || [text];
      while(hi - lo > 1){
        const mid = (lo + hi) >> 1;
        const r = wrap(mid);
        if(r){ lo = mid; best = r; } else hi = mid;
      }
      c.font = font(lo);
      return { lines: best, size: lo };
    }
    let logo: HTMLImageElement | null = null;
    function renderCard(st: Station, S: number){
      const cv = document.createElement('canvas');
      cv.width = cv.height = S;
      const c = cv.getContext('2d')!;
      if(st.kind === 'home' && GAL){
        c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillStyle = '#f0ede8';
        let size = S*.3;
        c.font = `italic 300 ${size}px 'Cormorant Garamond', serif`;
        while(c.measureText(galaxyName).width > S*.86 && size > 20){ size -= 4; c.font = `italic 300 ${size}px 'Cormorant Garamond', serif`; }
        c.fillText(galaxyName, S/2, S*.44);
        c.font = `${S*.024}px 'DM Mono', monospace`;
        c.globalAlpha = .6;
        c.fillText('G A L A X Y  ·  C R O N O V I S O R', S/2, S*.7);
        return cv;
      }
      if(st.kind === 'home'){
        const h = S*.68, w = h*1447.5/1821.75;
        if(logo?.complete && logo.naturalWidth){
          const lc = document.createElement('canvas');
          lc.width = Math.round(w); lc.height = Math.round(h);
          const l = lc.getContext('2d')!;
          l.drawImage(logo, 0, 0, lc.width, lc.height);
          l.globalCompositeOperation = 'source-in';
          l.fillStyle = '#f0ede8'; l.fillRect(0, 0, lc.width, lc.height);
          c.drawImage(lc, (S-w)/2, S*.02, w, h);
        }
        c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillStyle = '#f0ede8';
        c.font = `300 ${S*.085}px 'Cormorant Garamond', serif`;
        c.fillText('A N G E L O N I', S/2, S*.8);
        c.font = `${S*.021}px 'DM Mono', monospace`;
        c.globalAlpha = .6;
        c.fillText('D E V E L O P E R  ·  B U I L D E R  ·  E X P L O R E R', S/2, S*.88);
        return cv;
      }
      if(!st.flood && st.kind === 'text' && S > 512){ c.fillStyle = 'rgba(8,8,16,.72)'; c.fillRect(0, 0, S, S); }
      if(st.kind === 'set'){
        const g = c.createLinearGradient(0, 0, S, S);
        g.addColorStop(0, '#ff6eb4'); g.addColorStop(1, '#c77dff');
        c.fillStyle = g; c.fillRect(0, 0, S, S);
      } else if(st.flood){
        c.fillStyle = st.tint; c.fillRect(0, 0, S, S);
      }
      const px = S*.08, box = S-px*2;
      const { lines, size } = fitText(c, st.text, box, box);
      c.fillStyle = st.flood ? '#080810' : '#f0ede8';
      c.textBaseline = 'alphabetic'; c.textAlign = 'left';
      const lh = size*.98;
      const y0 = px + (box - lines.length*lh)/2 + lh*.78;
      lines.forEach((l, i) => c.fillText(l, px, y0 + i*lh));
      return cv;
    }

    // ── Space ─────────────────────────────────────────────
    interface Piece {
      star?: THREE.Mesh; starMat?: THREE.ShaderMaterial; stage?: string; beat: number; bright: number; starMix: number;
      st: Station; i: number; mesh: THREE.Mesh; mat: THREE.ShaderMaterial;
      w: number; h: number; lo?: THREE.Texture; hi?: THREE.Texture; hiBusy?: boolean; loBusy?: boolean;
      opacity: number; reveal: number; grow: number; halo?: THREE.Mesh;
    }
    const screen = $('screen') as HTMLCanvasElement;
    let renderer: THREE.WebGLRenderer | null = null;
    try { renderer = new THREE.WebGLRenderer({ canvas:screen, antialias:true, powerPreference:'high-performance' }); }
    catch { renderer = null; }
    // 1.25 instead of the full retina ratio: half the pixels, and the grain and halftone hide the difference.
    // (Fanless laptops ran hot drawing ~4M pixels every frame.)
    const DPR = Math.min(window.devicePixelRatio || 1, 1.25);
    THREE.ColorManagement.enabled = false;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, window.innerWidth/window.innerHeight, .1, 6000); // far: the other galaxies and the Sun
    const controls = renderer ? new OrbitControls(camera, screen) : null;
    const plane = new THREE.PlaneGeometry(1, 1);
    const CENTER = new THREE.Vector3();
    let overviewR = 112;
    const blank = new THREE.Texture();

    // far pieces are halftone signals in their tint; approaching resolves them to the untouched original
    const VERT = `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix*modelViewMatrix*vec4(position,1.); }`;
    const FRAG = `precision highp float;
      varying vec2 vUv;
      uniform sampler2D uMap;
      uniform vec3 uTint;
      uniform float uHas, uReveal, uOpacity, uCell, uGain;
      void main(){
        vec4 s = uHas > .5 ? texture2D(uMap, vUv) : vec4(uTint*.3, 1.);
        if(s.a < .01) discard;
        vec2 g = mat2(.966,-.259,.259,.966)*gl_FragCoord.xy/uCell;
        float l = clamp(dot(s.rgb, vec3(.299,.587,.114))*.8, 0., 1.);
        float dots = smoothstep(.09,-.09,length(fract(g)-.5)-.68*sqrt(l));
        gl_FragColor = vec4(mix(uTint*dots, s.rgb, uReveal)*uGain, s.a*uOpacity);
      }`;

    // ── Stellar life ──────────────────────────────────────
    // Age comes from the piece's date on every visit, so the universe grows old by itself.
    // Log time: a piece changes fast at first and slowly after, like attention does.
    const DAY = 864e5;
    const NOW = Date.now() + (parseFloat(new URLSearchParams(location.search).get('days') || '0') || 0)*DAY; // ?days=365 previews the future
    const SPAN: Record<string, number> = { set:200, photo:365, text:520 }; // the massive live fast, as in real stars
    const MASS: Record<string, number> = { set:1.5, photo:1, text:.75 };
    const STAGES = [
      { at:0,   name:'protostar',     color:'#ff9a6b', size:6.5, bright:.8,  beat:1.5, core:.1,  cloud:1, spike:0, ring:0 },
      { at:.25, name:'young star',    color:'#a9d6ff', size:7,   bright:2,   beat:.5,  core:.16, cloud:0, spike:1, ring:0 },
      { at:.55, name:'main sequence', color:'#ffe7ac', size:5.4, bright:1.25,beat:.14, core:.14, cloud:0, spike:0, ring:0 },
      { at:.9,  name:'red giant',     color:'#ff5a3c', size:10,  bright:.85, beat:.06, core:.3,  cloud:0, spike:0, ring:0 },
      { at:.97, name:'white dwarf',   color:'#dfe9ff', size:3,   bright:.9,  beat:0,   core:.05, cloud:0, spike:0, ring:1 },
    ];
    function stellar(st: Station){
      const age = st.date ? Math.max(0, (NOW-Date.parse(st.date))/DAY) : 1e5;
      const span = SPAN[st.kind] || 365;
      const life = Math.min(1, Math.log1p(age)/Math.log1p(span));
      const mix = (a: number, b: number, t: number) => a + (b-a)*t;
      let i = STAGES.length-1;
      while(i > 0 && STAGES[i].at > life) i--;
      const A = STAGES[i], B = STAGES[Math.min(i+1, STAGES.length-1)];
      const t = B === A ? 0 : Math.min(1, (life-A.at)/(B.at-A.at));
      const ca = hexRgb(A.color), cb = hexRgb(B.color);
      const s = {
        name:A.name, life, color:[0,1,2].map(k => mix(ca[k], cb[k], t)),
        size:mix(A.size, B.size, t)*(MASS[st.kind] || 1), bright:mix(A.bright, B.bright, t), beat:mix(A.beat, B.beat, t),
        core:mix(A.core, B.core, t), cloud:mix(A.cloud, B.cloud, t), spike:mix(A.spike, B.spike, t), ring:mix(A.ring, B.ring, t),
      };
      if(st.kind === 'set' && life >= 1){ // heavy stars don't fade: they go supernova and leave a nebula
        Object.assign(s, { name:'supernova remnant', color:hexRgb('#ff6eb4'), size:17, bright:1, beat:.04, core:.03, cloud:.55, spike:0, ring:1 });
      }
      return s;
    }
    const STAR_VERT = `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix*modelViewMatrix*vec4(position,1.); }`;
    const STAR_FRAG = `precision highp float;
      varying vec2 vUv;
      uniform vec3 uColor, uTint;
      uniform float uTime, uBright, uCore, uCloud, uSpike, uRing, uOpacity, uSeed;
      void main(){
        vec2 p = (vUv-.5)*2.;
        float d = length(p), a = atan(p.y, p.x);
        float rough = .5+.5*sin(a*3.+uSeed+uTime*.3)*sin(a*5.-uTime*.2+d*7.);
        vec3 col = uColor*(smoothstep(uCore, uCore*.45, d)*1.6 + pow(max(0.,1.-d),3.)*.6)*(1.-uCloud*.5);
        col += vec3(1.)*smoothstep(uCore*.55, 0., d)*.7;
        col += uColor*uSpike*1.2*(exp(-abs(p.y)*60.)*pow(max(0.,1.-abs(p.x)),4.) + exp(-abs(p.x)*60.)*pow(max(0.,1.-abs(p.y)),4.));
        col += uTint*uCloud*.7*pow(max(0.,1.-d),1.6)*(.45+.55*rough);
        col += uTint*uRing*.6*exp(-pow((d-.62)/.07,2.))*(.6+.4*rough);
        col *= uBright*smoothstep(1.,.86,d)*uOpacity;
        gl_FragColor = vec4(col, 1.);
      }`;
    function buildStar(p: Piece){
      const s = stellar(p.st);
      p.stage = s.name;
      p.beat = s.beat;
      p.bright = s.bright;
      p.starMat = new THREE.ShaderMaterial({
        vertexShader:STAR_VERT, fragmentShader:STAR_FRAG, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending,
        uniforms:{
          uColor:{value:new THREE.Vector3(...s.color)}, uTint:{value:new THREE.Vector3(...hexRgb(p.st.tint))},
          uTime:{value:0}, uBright:{value:s.bright}, uCore:{value:s.core}, uCloud:{value:s.cloud}, uSpike:{value:s.spike}, uRing:{value:s.ring},
          uOpacity:{value:0}, uSeed:{value:p.st.n*1.7},
        },
      });
      p.star = new THREE.Mesh(plane, p.starMat);
      p.star.position.copy(p.mesh.position);
      p.star.scale.set(s.size, s.size, 1);
      scene.add(p.star);
      billboards.push(p.star);
    }

    function makeRng(seed: number){
      return () => {
        seed = (seed + 0x6D2B79F5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    let pieces: Piece[] = [];
    let thread: THREE.Line | null = null, dust: THREE.Points | null = null;
    const billboards: THREE.Object3D[] = [];

    function makeLabel(text: string){
      const cv = document.createElement('canvas');
      cv.width = 256; cv.height = 48;
      const c = cv.getContext('2d')!;
      c.font = "26px 'DM Mono', monospace"; c.fillStyle = '#f0ede8'; c.textAlign = 'center'; c.textBaseline = 'middle';
      c.fillText(text, 128, 24);
      const mesh = new THREE.Mesh(plane, new THREE.MeshBasicMaterial({ map:new THREE.CanvasTexture(cv), transparent:true, opacity:.5, depthWrite:false }));
      mesh.scale.set(10.6, 2, 1);
      billboards.push(mesh);
      scene.add(mesh);
      return mesh;
    }
    // Months are clusters on a spiral: same month stays together, older months sit further out.
    let gasSpots: THREE.Vector3[] = [];
    // Months on a spiral that keeps its spacing however long the archive gets: about 30 apart along the curve
    // and between turns (an Archimedean spiral walked at constant speed), newest at the centre.
    function spiral(k: number){
      const t = Math.sqrt(12.5*Math.max(0, k));
      return { a: t + .6, r: 34 + 4.8*t };
    }
    let galaxyR = 92; // how far the oldest barrio lies; the overview, the pilot's reach and the worlds follow it
    function layout(){
      const months = [...new Set(stations.slice(1).map(s => s.date.slice(0,7)))].sort().reverse();
      const spots = new Map<string, THREE.Vector3>();
      months.forEach((m, k) => {
        const f = months.length > 1 ? k/(months.length-1) : 0;
        const { a, r } = spiral(k);
        spots.set(m, new THREE.Vector3(Math.cos(a)*r, (k % 2 ? 1 : -1)*(8 + f*18), Math.sin(a)*r));
      });
      const count = new Map<string, number>();
      stations.forEach(s => { const m = s.date.slice(0,7); count.set(m, (count.get(m) || 0) + 1); });
      const out = stations.map(s => {
        if(s.kind === 'home') return new THREE.Vector3();
        const m = s.date.slice(0,7), rng = makeRng(s.n*7919);
        const spread = 9 + Math.sqrt(count.get(m)!)*3.8;
        const u = rng()*Math.PI*2, v = Math.acos(2*rng()-1), r = spread*Math.cbrt(rng());
        return spots.get(m)!.clone().add(new THREE.Vector3(Math.sin(v)*Math.cos(u)*r, Math.cos(v)*r, Math.sin(v)*Math.sin(u)*r));
      });
      // a few relaxation passes so plates don't sit on top of each other
      for(let pass = 0; pass < 24; pass++){
        for(let a = 1; a < out.length; a++) for(let b = a+1; b < out.length; b++){
          const d = out[a].clone().sub(out[b]), len = d.length();
          if(len < 8.5 && len > 1e-3) { d.multiplyScalar((8.5-len)/len*.5); out[a].add(d); out[b].sub(d); }
        }
        for(let a = 1; a < out.length; a++){ // keep the logo clear
          const len = out[a].length();
          if(len < 19) out[a].multiplyScalar(19/len);
        }
      }
      // Gas for the balloon: a nebula at each turn of the year, where one time gives way to an older one,
      // and the biggest beyond the oldest month. To keep flying you travel into the past.
      galaxyR = spiral(Math.max(0, months.length-1)).r;
      PILOT_R = Math.max(150, galaxyR + 45);
      const along = (k: number, out: number) => {
        const { a, r } = spiral(k);
        return new THREE.Vector3(Math.cos(a)*(r + out), 0, Math.sin(a)*(r + out));
      };
      const ks: number[] = [];
      for(let k = 0; k < months.length-1; k++) if(months[k].slice(0,4) !== months[k+1].slice(0,4)) ks.push(k + .5);
      ks.push(months.length - 1 + .7);
      for(let extra = 1; ks.length < 3; extra++) ks.push(Math.max(months.length, 4)*extra/4); // few years yet: a couple more along the way
      gasSpots = ks.map((k, j) => {
        const g = along(k, j === ks.length-1 ? 24 : 16);
        for(let t = 0; t < 30 && out.some(o => o.distanceTo(g) < 22); t++){ g.multiplyScalar(1.05); g.y += j % 2 ? 1.6 : -1.6; } // clear of the pieces
        return g;
      });
      months.forEach(m => {
        const p = spots.get(m)!;
        makeLabel(m.replace('-','·')).position.copy(p).add(new THREE.Vector3(0, 13 + Math.sqrt(count.get(m)!)*3.4, 0));
      });
      return out;
    }
    function setSize(p: Piece, aspect: number){
      const home = p.st.kind === 'home';
      const big = p.st.kind === 'set' ? 1.4 : 1;
      if(home){ p.w = p.h = 24; }
      else if(aspect >= 1){ p.w = 8.4*big; p.h = p.w/aspect; }
      else { p.h = 8*big; p.w = p.h*aspect; }
      p.mesh.scale.set(p.w, p.h, 1);
    }
    function setMap(p: Piece, tex: THREE.Texture){
      p.mat.uniforms.uMap.value = tex;
      p.mat.uniforms.uHas.value = 1;
    }
    function buildSpace(){
      const spots = layout();
      pieces = stations.map((st, i) => {
        const mat = new THREE.ShaderMaterial({
          vertexShader:VERT, fragmentShader:FRAG, transparent:true, depthWrite:false,
          uniforms:{ uMap:{value:blank}, uTint:{value:new THREE.Vector3(...hexRgb(st.tint))}, uHas:{value:0}, uReveal:{value:0}, uOpacity:{value:0}, uCell:{value:4*DPR}, uGain:{value:.74} },
        });
        const mesh = new THREE.Mesh(plane, mat);
        mesh.position.copy(spots[i]);
        mesh.userData.i = i;
        scene.add(mesh);
        billboards.push(mesh);
        const p: Piece = { st, i, mesh, mat, w:4, h:4, opacity:0, reveal:0, grow:1, beat:0, bright:1, starMix:1 };
        setSize(p, st.src ? .75 : 1);
        if(st.kind !== 'home') buildStar(p);
        if(st.kind === 'set'){
          p.halo = new THREE.Mesh(new THREE.RingGeometry(.98, 1, 96), new THREE.MeshBasicMaterial({ color:0xff6eb4, transparent:true, opacity:.7, depthWrite:false }));
          p.halo.position.copy(mesh.position);
          scene.add(p.halo);
          billboards.push(p.halo);
        }
        return p;
      });
      buildThread();
      buildDust();
      buildNebulae();
      buildWind();
      buildBalloon();
      placeWorlds();
      addGateNebulae();
      cards();
      queuePhotos();
    }
    // The chronology is one continuous curve; pulses run along it from the present into the past.
    function buildThread(){
      if(pieces.length < 3) return; // a new galaxy, nothing to thread yet
      const pts = pieces.map(p => p.mesh.position.clone());
      const curve = new THREE.CatmullRomCurve3(pts, false, 'centripetal');
      const N = pts.length*14;
      const geo = new THREE.BufferGeometry().setFromPoints(curve.getPoints(N));
      const at = new Float32Array(N+1), col = new Float32Array((N+1)*3);
      for(let i = 0; i <= N; i++){
        at[i] = i/N;
        const q = pieces[Math.min(pieces.length-1, Math.round(i/N*(pieces.length-1)))];
        col.set(hexRgb(q.st.tint), i*3);
      }
      geo.setAttribute('aT', new THREE.BufferAttribute(at, 1));
      geo.setAttribute('aC', new THREE.BufferAttribute(col, 3));
      thread = new THREE.Line(geo, new THREE.ShaderMaterial({
        transparent:true, depthWrite:false, blending:THREE.AdditiveBlending,
        uniforms:{ uTime:{value:0}, uDim:{value:1} },
        vertexShader:`attribute float aT; attribute vec3 aC; varying float vT; varying vec3 vC;
          void main(){ vT = aT; vC = aC; gl_Position = projectionMatrix*modelViewMatrix*vec4(position,1.); }`,
        fragmentShader:`precision highp float; varying float vT; varying vec3 vC; uniform float uTime, uDim;
          void main(){
            float p = pow(fract(vT*5.-uTime*.05), 18.);
            gl_FragColor = vec4(vC*(.34+p*2.6)*uDim, 1.);
          }`,
      }));
      scene.add(thread);
    }
    function buildDust(){
      if(pieces.length < 2) return; // a new, empty galaxy: no dust yet
      const rng = makeRng(23), N = 5200, pos = new Float32Array(N*3), col = new Float32Array(N*3);
      for(let i = 0; i < N; i++){
        const q = pieces[1 + Math.floor(rng()*(pieces.length-1))];
        const r = 2 + Math.pow(rng(), 2)*24, u = rng()*Math.PI*2, v = Math.acos(2*rng()-1);
        pos.set([q.mesh.position.x + Math.sin(v)*Math.cos(u)*r, q.mesh.position.y + Math.cos(v)*r*.8, q.mesh.position.z + Math.sin(v)*Math.sin(u)*r], i*3);
        const c = hexRgb(q.st.tint), b = .2 + rng()*.6;
        col.set([c[0]*b, c[1]*b, c[2]*b], i*3);
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      dust = new THREE.Points(geo, new THREE.PointsMaterial({ size:.55, map:SPRITE, vertexColors:true, transparent:true, opacity:.8, depthWrite:false, blending:THREE.AdditiveBlending }));
      scene.add(dust);
    }
    function cards(){
      pieces.forEach(p => {
        if(p.st.src) return;
        p.lo?.dispose();
        p.lo = new THREE.CanvasTexture(renderCard(p.st, p.st.kind === 'home' ? 1400 : 512));
        p.lo.anisotropy = 4;
        if(!p.hi) setMap(p, p.lo);
      });
    }
    // Thumbnails stream in from the centre outwards, a few at a time.
    // Thumbnails (384px, made by the server in images/t/) stream in by proximity: only the photos near the camera,
    // or the balloon, get one, nearest first, a few at a time; far ones give theirs back. Hovered, focused and their
    // neighbours always have one. A photo without a thumbnail (a set's artwork, or before the server made it) falls
    // back to the full image.
    const THUMB_NEAR = 100, THUMB_FAR = 160, THUMB_MAX = 120;
    let thumbBusy = 0, thumbAt = 0;
    const THUMB_RE = /^((?:\/galaxies\/[^/]+)?\/images)\/([^/]+)\.\w+$/;
    const thumbOf = (src: string) => THUMB_RE.test(src) ? src.replace(THUMB_RE, '$1/t/$2.jpg') : src;
    function queuePhotos(){ thumbAt = 0; }
    function loadThumb(p: Piece){
      if(p.lo || p.loBusy || !p.st.src) return;
      p.loBusy = true; thumbBusy++;
      const img = new Image(), done = () => { p.loBusy = false; thumbBusy--; };
      img.onerror = () => { if(img.src.includes('/images/t/') && p.st.src){ img.src = p.st.src; } else done(); };
      img.onload = () => {
        done();
        const S = 384, k = Math.min(1, S/Math.max(img.naturalWidth, img.naturalHeight));
        const cv = document.createElement('canvas');
        cv.width = Math.round(img.naturalWidth*k); cv.height = Math.round(img.naturalHeight*k);
        cv.getContext('2d')!.drawImage(img, 0, 0, cv.width, cv.height);
        setSize(p, img.naturalWidth/img.naturalHeight);
        p.lo = new THREE.CanvasTexture(cv);
        p.lo.anisotropy = 4;
        if(!p.hi) setMap(p, p.lo);
      };
      img.src = thumbOf(p.st.src);
    }
    function dropThumb(p: Piece){
      if(!p.lo || !p.st.src) return;
      p.lo.dispose();
      p.lo = undefined;
      if(!p.hi){ p.mat.uniforms.uMap.value = blank; p.mat.uniforms.uHas.value = 0; }
    }
    function manageThumbs(now: number){
      if(now < thumbAt || !pieces.length) return;
      thumbAt = now + 350;
      const eyes = [camera.position];
      if(pilot) eyes.push(pilot.pos);
      const keep = new Set([hovered, focused, focused-1, focused+1, shown]);
      const photos = pieces.filter(p => p.st.src).map(p => ({ p, d: Math.min(...eyes.map(e => e.distanceTo(p.mesh.position))) - (keep.has(p.i) ? 1e4 : 0) }));
      photos.sort((a, b) => a.d - b.d);
      photos.forEach(({ p, d }, rank) => {
        if(((d < THUMB_NEAR && rank < THUMB_MAX) || d < 0) && thumbBusy < 4) loadThumb(p);
      });
      // give back only when over budget, farthest first, so orbiting around doesn't load the same ones again and again
      let loaded = photos.filter(q => q.p.lo).length;
      for(let k = photos.length-1; k >= 0 && loaded > THUMB_MAX; k--){
        const { p, d } = photos[k];
        if(p.lo && d > THUMB_FAR){ dropThumb(p); loaded--; }
      }
    }
    function loadHi(p: Piece){
      if(p.hi || p.hiBusy || p.st.kind === 'home') return;
      if(!p.st.src){
        p.hi = new THREE.CanvasTexture(renderCard(p.st, 1536));
        p.hi.anisotropy = 8;
        setMap(p, p.hi);
        return;
      }
      p.hiBusy = true;
      const img = new Image();
      img.onload = () => {
        p.hiBusy = false;
        p.hi = new THREE.Texture(img);
        p.hi.anisotropy = 8;
        p.hi.needsUpdate = true;
        setMap(p, p.hi);
      };
      img.onerror = () => { p.hiBusy = false; };
      img.src = p.st.src;
    }
    function dropHi(p: Piece){
      if(!p.hi) return;
      p.hi.dispose();
      p.hi = undefined;
      if(p.lo) setMap(p, p.lo);
      else { p.mat.uniforms.uMap.value = blank; p.mat.uniforms.uHas.value = 0; }
    }
    function roundSprite(){
      const cv = document.createElement('canvas');
      cv.width = cv.height = 32;
      const c = cv.getContext('2d')!;
      const g = c.createRadialGradient(16, 16, 0, 16, 16, 16);
      g.addColorStop(0, '#fff'); g.addColorStop(.45, 'rgba(255,255,255,.6)'); g.addColorStop(1, 'rgba(255,255,255,0)');
      c.fillStyle = g; c.fillRect(0, 0, 32, 32);
      return new THREE.CanvasTexture(cv);
    }
    const SPRITE = roundSprite();
    function buildStars(){
      const rng = makeRng(11), N = 2600, pos = new Float32Array(N*3), col = new Float32Array(N*3);
      for(let i = 0; i < N; i++){
        const u = rng()*Math.PI*2, v = Math.acos(2*rng()-1), r = 90 + rng()*330;
        pos.set([Math.sin(v)*Math.cos(u)*r, Math.cos(v)*r, Math.sin(v)*Math.sin(u)*r], i*3);
        const c = rng() < .12 ? hexRgb(COLORS[Math.floor(rng()*COLORS.length)]) : [.94,.93,.91];
        const b = .25 + rng()*.75;
        col.set([c[0]*b, c[1]*b, c[2]*b], i*3);
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      const stars = new THREE.Points(geo, new THREE.PointsMaterial({ size:2.4*DPR, sizeAttenuation:false, map:SPRITE, vertexColors:true, transparent:true, depthWrite:false }));
      scene.add(stars);
      return stars;
    }
    const stars = buildStars();
    const nebula = new THREE.Mesh(new THREE.SphereGeometry(460, 32, 24), new THREE.ShaderMaterial({
      side:THREE.BackSide, depthWrite:false, uniforms:{ uDim:{value:1} },
      vertexShader:`varying vec3 vD; void main(){ vD = normalize(position); gl_Position = projectionMatrix*modelViewMatrix*vec4(position,1.); }`,
      fragmentShader:`precision highp float; varying vec3 vD; uniform float uDim;
        float h(vec3 p){ return fract(sin(dot(p, vec3(127.1,311.7,74.7)))*43758.5453); }
        float n(vec3 p){ vec3 i = floor(p), f = fract(p); f = f*f*(3.-2.*f);
          return mix(mix(mix(h(i),h(i+vec3(1,0,0)),f.x),mix(h(i+vec3(0,1,0)),h(i+vec3(1,1,0)),f.x),f.y),
                     mix(mix(h(i+vec3(0,0,1)),h(i+vec3(1,0,1)),f.x),mix(h(i+vec3(0,1,1)),h(i+vec3(1,1,1)),f.x),f.y),f.z); }
        float fbm(vec3 p){ float a = .5, r = 0.; for(int i = 0; i < 5; i++){ r += a*n(p); p = p*2.03+7.; a *= .5; } return r; }
        void main(){
          float w = fbm(vD*2.4), a = fbm(vD*3.1+w*2.2), b = fbm(vD*2.2-w*1.8+4.);
          vec3 col = vec3(.031,.031,.063);
          col += vec3(.78,.49,1.)*pow(a,4.)*.95 + vec3(.22,.74,.97)*pow(b,4.)*.7 + vec3(1.,.43,.7)*pow(a*b,3.)*1.4;
          gl_FragColor = vec4(col*uDim, 1.);
        }`,
    }));
    scene.add(nebula);

    // Light and speed. Both fall to zero on arrival: a tuned piece is shown untouched.
    const BLOOM = .34;
    let composer: EffectComposer | null = null, bloom: UnrealBloomPass | null = null, lens: ShaderPass | null = null;
    if(renderer){
      composer = new EffectComposer(renderer, new THREE.WebGLRenderTarget(1, 1, { type:THREE.HalfFloatType, samples:4 }));
      composer.addPass(new RenderPass(scene, camera));
      bloom = new UnrealBloomPass(new THREE.Vector2(window.innerWidth/2, window.innerHeight/2), BLOOM, .55, .78);
      // bloom is a soft glow: render it at half resolution, a quarter of the cost, nothing visible lost
      const bloomSize = bloom.setSize.bind(bloom);
      bloom.setSize = (w: number, h: number) => bloomSize(Math.max(1, Math.round(w/2)), Math.max(1, Math.round(h/2)));
      composer.addPass(bloom);
      lens = new ShaderPass({
        uniforms:{ tDiffuse:{value:null}, uEnergy:{value:0}, uGrain:{value:1}, uTime:{value:0} },
        vertexShader:`varying vec2 vUv; void main(){ vUv = uv; gl_Position = vec4(position.xy,0.,1.); }`,
        fragmentShader:`precision highp float; varying vec2 vUv; uniform sampler2D tDiffuse; uniform float uEnergy, uGrain, uTime;
          float h(vec2 p){ return fract(sin(dot(p, vec2(12.9898,78.233)))*43758.5453); }
          void main(){
            vec2 d = vUv-.5;
            vec3 col = vec3(0.);
            float amt = uEnergy*.11*dot(d,d)*4.;
            for(int i = 0; i < 8; i++){
              float t = float(i)/7.;
              col.r += texture2D(tDiffuse, vUv-d*amt*t*1.25).r;
              col.g += texture2D(tDiffuse, vUv-d*amt*t).g;
              col.b += texture2D(tDiffuse, vUv-d*amt*t*.75).b;
            }
            col /= 8.;
            col *= 1.-uGrain*dot(d,d)*.9;
            col += (h(vUv*913.+fract(uTime))-.5)*.04*uGrain;
            gl_FragColor = vec4(col, 1.);
          }`,
      });
      composer.addPass(lens);
    }

    // ── Flight ────────────────────────────────────────────
    let focused = -1, hovered = -1, shown = -1, lastInput = 0, lockedAt = 0, scanning = false;
    interface Flight { fromP: THREE.Vector3; toP: THREE.Vector3; fromL: THREE.Vector3; toL: THREE.Vector3; t0: number; dur: number; arc: number; done?: () => void; }
    let flight: Flight | null = null;
    const look = new THREE.Vector3();
    const overviewPos = new THREE.Vector3();
    const hint = $('hint'), lamp = $('lamp'), metaId = $('meta-id'), metaCap = $('meta-cap'), nowEl = $('now'), act = $('act');
    const btnScan = $('btn-scan'), btnBack = $('btn-back'), balloonTag = $('balloon-tag'), cockpit = $('cockpit');
    function anyOpen(){ return !!document.querySelector('.sheet.open'); }

    function syncScan(){
      btnScan.classList.toggle('on', scanning);
      btnScan.setAttribute('aria-pressed', String(scanning));
    }
    function stopScan(){ if(scanning){ scanning = false; syncScan(); } }
    btnScan.addEventListener('click', () => {
      scanning = !scanning;
      syncScan();
      if(scanning && focused < 0) focusOn(1);
      lockedAt = performance.now();
    });
    function touched(){
      lastInput = performance.now();
      hint.hidden = true;
      stopScan();
    }
    function flyTo(toP: THREE.Vector3, toL: THREE.Vector3, dur: number, done?: () => void){
      if(reduced || dur === 0){
        camera.position.copy(toP); look.copy(toL); camera.lookAt(look);
        flight = null; done?.();
        return;
      }
      const dist = camera.position.distanceTo(toP);
      flight = { fromP:camera.position.clone(), toP, fromL:look.clone(), toL, t0:performance.now(), dur, arc:Math.min(dist*.14, 16), done };
    }
    function viewDistance(p: Piece){
      const t = Math.tan(camera.fov*Math.PI/360);
      return Math.max(p.h/(2*t*.72), p.w/(2*t*camera.aspect*.86));
    }
    function focusOn(i: number, dur = 1500){
      if(!renderer || !pieces[i]) return;
      if(focused < 0 && controls){ controls.enabled = false; overviewPos.copy(camera.position); }
      const prev = pieces[focused];
      focused = i;
      const p = pieces[i];
      [i-1, i, i+1].forEach(k => { if(pieces[k]) loadHi(pieces[k]); });
      pieces.forEach(q => { if(Math.abs(q.i-i) > 2) dropHi(q); });
      if(prev) { prev.mat.depthTest = true; prev.mesh.renderOrder = 0; }
      p.mat.depthTest = false;
      p.mesh.renderOrder = 10;
      const dir = camera.position.clone().sub(p.mesh.position);
      if(dir.lengthSq() < 1e-3) dir.set(0, 0, 1);
      dir.normalize();
      lamp.classList.remove('on');
      showMeta(i);
      btnBack.hidden = false;
      document.body.classList.add('focus');
      flyTo(p.mesh.position.clone().add(dir.multiplyScalar(viewDistance(p))), p.mesh.position.clone(), dur, () => {
        lamp.classList.add('on');
        lockedAt = performance.now();
        if(p.st.n) playNote(NOTES[p.st.n % NOTES.length]);
      });
      const url = new URL(location.href);
      if(!sheets.set.classList.contains('open')) url.searchParams.delete('set');
      url.hash = p.st.id;
      history.replaceState(null, '', url.toString());
    }
    // ── Balloon ───────────────────────────────────────────
    // The message carrier: a hot air balloon drifting through the limbo with a string of eleven lights, one per word.
    // On send it lets them go: they fall into the logo while the balloon rises, lighter.
    interface Balloon {
      group: THREE.Group; engine: THREE.Mesh; lamps: THREE.MeshBasicMaterial[]; bulbs: THREE.Mesh[]; home: THREE.Vector3[];
      thread: THREE.Line; skin: { m: THREE.MeshBasicMaterial; base: THREE.Color }[]; drops: { from: THREE.Vector3; ctrl: THREE.Vector3 }[];
      tau: number; peek: number; peekFrom: number; mode: 'cruise' | 'pilot' | 'board' | 'parked' | 'launch' | 'away';
      spawn: number; t0: number; p0: THREE.Vector3; dir: THREE.Vector3; lit: number; over: boolean; sx: number; sy: number; onScreen: boolean;
    }
    let balloon: Balloon | null = null, boarded = false, hoverBalloon = false;
    let skyMoving = false; // someone else's balloon is flying on screen
    let myPower = .5; // how hard your burner is firing, for the shared sky
    let burst: THREE.Points | null = null, shock: THREE.Mesh | null = null;
    let impactAt = 0, logoPulse = 0, delivering = false, novaImpact = false;
    const BURST = 330, BALLOON_SCALE = .7;
    const DELIVERY = 4.6, RISE = 3.5, LET_GO = .17; // a light is released every LET_GO seconds
    // Cruising, the balloon lives in this rig glued to the camera: orbiting and zooming the universe never move it.
    const rig = new THREE.Group();
    scene.add(rig);
    // Envelope profile (radius, height): a full pear, round and wide up top, a short cone down to the mouth.
    const ENVELOPE: [number, number][] = [[.62,-.2],[1,.45],[1.6,1.15],[2.25,1.95],[2.8,2.85],[3.15,3.8],[3.32,4.75],[3.3,5.65],[3.1,6.5],[2.7,7.25],[2.1,7.85],[1.3,8.25],[0,8.4]];
    // Wiphala colours (they hold the rainbow of the pride flag too), laid out in diagonals across the panels
    const WIPHALA = ['#e4232b','#f47b20','#ffd200','#e6e2da','#00a650','#0072bc','#6c3b97'];
    const GORES = 12, GORE_SEGS = 5;
    const lobe = (f: number) => .935 + .065*Math.sin(Math.PI*f); // each gore bulges between its seams
    // The balloon itself: envelope, basket, burner, the string of lights. `twist` steps the Wiphala colours
    // across the gores; yours is 1, the family's in the shared sky get others so each is recognisable.
    function balloonBody(twist = 1){
      const group = new THREE.Group();
      const ink = new THREE.LineBasicMaterial({ color:0xf0ede8 });
      const faint = new THREE.LineBasicMaterial({ color:0xf0ede8, transparent:true, opacity:.55 });
      const shell = new THREE.MeshBasicMaterial({ color:0x0b0b16, side:THREE.DoubleSide, polygonOffset:true, polygonOffsetFactor:1, polygonOffsetUnits:1 });
      const add = (geo: THREE.BufferGeometry, angle = 18) => {
        group.add(new THREE.Mesh(geo, shell));
        group.add(new THREE.LineSegments(new THREE.EdgesGeometry(geo, angle), ink));
      };
      const lines = (pts: number[], mat: THREE.LineBasicMaterial) => {
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.Float32BufferAttribute(pts, 3));
        group.add(new THREE.LineSegments(geo, mat));
      };
      // twelve inflated gores cut in panels, each panel a Wiphala colour, stepping one colour per gore so they run in diagonals
      const P = ENVELOPE.length, skin: Balloon['skin'] = [], gores: THREE.BufferGeometry[] = [];
      for(let g = 0; g < GORES; g++){
        const lathe = new THREE.LatheGeometry(ENVELOPE.map(([r,y]) => new THREE.Vector2(r, y)), GORE_SEGS, g*Math.PI*2/GORES, Math.PI*2/GORES);
        const lp = lathe.attributes.position as THREE.BufferAttribute;
        for(let i = 0; i <= GORE_SEGS; i++) for(let j = 0; j < P; j++){
          const v = i*P + j, k = lobe(i/GORE_SEGS);
          lp.setX(v, lp.getX(v)*k); lp.setZ(v, lp.getZ(v)*k);
        }
        const geo = lathe.toNonIndexed(); // faces come in pairs per panel row: (segment, row) -> 2 triangles
        lathe.dispose();
        geo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(geo.attributes.position.count*3), 3));
        gores.push(geo);
        const base = new THREE.Color(.55, .55, .55); // under the bloom threshold even at full burn
        const m = new THREE.MeshBasicMaterial({ color:base.clone(), vertexColors:true, side:THREE.DoubleSide, polygonOffset:true, polygonOffsetFactor:1, polygonOffsetUnits:1 });
        skin.push({ m, base });
        group.add(new THREE.Mesh(geo, m));
      }
      // seams: down each gore and around each row of panels
      const seams: number[] = [];
      const at = (j: number, phi: number) => {
        const f = ((phi/(Math.PI*2/GORES)) % 1 + 1) % 1, [r, y] = ENVELOPE[j], k = r*lobe(f)*1.004;
        return [Math.sin(phi)*k, y, Math.cos(phi)*k];
      };
      for(let g = 0; g < GORES; g++) for(let j = 0; j < P-1; j++) seams.push(...at(j, g*Math.PI*2/GORES), ...at(j+1, g*Math.PI*2/GORES));
      for(let j = 1; j < P-1; j++) for(let a = 0; a < GORES*GORE_SEGS; a++){
        seams.push(...at(j, a/(GORES*GORE_SEGS)*Math.PI*2), ...at(j, (a+1)/(GORES*GORE_SEGS)*Math.PI*2));
      }
      lines(seams, new THREE.LineBasicMaterial({ color:0x080810, transparent:true, opacity:.4 }));
      // skirt below the mouth, the burner, and a wicker basket with a rim
      const skirt = new THREE.CylinderGeometry(.6, .46, .55, GORES, 1, true);
      skirt.translate(0, -.47, 0);
      const skirtMat = new THREE.MeshBasicMaterial({ color:new THREE.Color(WIPHALA[0]).multiplyScalar(.5), side:THREE.DoubleSide });
      group.add(new THREE.Mesh(skirt, skirtMat));
      group.add(new THREE.LineSegments(new THREE.EdgesGeometry(skirt, 20), faint));
      const burner = new THREE.CylinderGeometry(.16, .2, .22, 8);
      burner.translate(0, -1.32, 0);
      add(burner, 30);
      const basket = new THREE.BoxGeometry(.86, .62, .86);
      basket.translate(0, -2.24, 0);
      add(basket);
      const rim = new THREE.BoxGeometry(.98, .09, .98);
      rim.translate(0, -1.93, 0);
      add(rim);
      const weave: number[] = [];
      const corners: [number, number][] = [[.43,.43],[.43,-.43],[-.43,-.43],[-.43,.43]];
      for(const y of [-2.12, -2.32]) corners.forEach(([x,z], c) => { const [x2,z2] = corners[(c+1) % 4]; weave.push(x*1.01, y, z*1.01, x2*1.01, y, z2*1.01); });
      lines(weave, faint);
      const ropes: number[] = [];
      for(const [x,z] of corners) ropes.push(x*1.1, -1.9, z*1.1, x*.77, -.74, z*.77, 0, -1.32, 0, x*.77, -.74, z*.77);
      lines(ropes, faint);
      // the eleven words hang under the basket as a string of lights
      const lamps: THREE.MeshBasicMaterial[] = [], bulbs: THREE.Mesh[] = [], home: THREE.Vector3[] = [];
      const lampGeo = new THREE.SphereGeometry(.17, 8, 8);
      for(let k = 0; k < 11; k++){
        const m = new THREE.MeshBasicMaterial({ color:new THREE.Color(COLORS[k % COLORS.length]) });
        const mesh = new THREE.Mesh(lampGeo, m);
        const glow = new THREE.Sprite(new THREE.SpriteMaterial({ map:SPRITE, color:0x000000, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending }));
        glow.scale.setScalar(.8);
        mesh.add(glow);
        mesh.userData.glow = glow.material;
        mesh.position.set(0, -3 - k*.48, 0);
        home.push(mesh.position.clone());
        group.add(mesh);
        bulbs.push(mesh);
        lamps.push(m);
      }
      const threadGeo = new THREE.BufferGeometry();
      threadGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(12*3), 3));
      const thread = new THREE.Line(threadGeo, new THREE.LineBasicMaterial({ color:0xf0ede8, transparent:true, opacity:.45 }));
      thread.frustumCulled = false;
      group.add(thread);
      const engine = new THREE.Mesh(plane, new THREE.MeshBasicMaterial({ map:SPRITE, color:0xff9f1c, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending }));
      engine.position.y = -1.05;
      group.add(engine);
      group.scale.setScalar(BALLOON_SCALE);
      const body = { group, engine, lamps, bulbs, home, thread, skin, gores, skirtMat };
      paintBody(body, null, twist);
      return body;
    }
    // The envelope's colours: each owner designs theirs in the admin (balloon tab), stored with their galaxy.
    // No design: the Wiphala in diagonals, `twist` stepping it differently for each of the family in the shared sky.
    type Look = { palette: string[]; pattern: 'diagonal' | 'gores' | 'bands' | 'checker' };
    function lookIndex(pattern: Look['pattern'], g: number, row: number, n: number, twist: number){
      if(pattern === 'gores') return g % n;
      if(pattern === 'bands') return row % n;
      if(pattern === 'checker') return (Math.floor(row/2) % Math.ceil(n/2)*2 + (g + row) % 2) % n;
      return ((g*twist + row) % n + n) % n;
    }
    function paintBody(body: { gores: THREE.BufferGeometry[]; skirtMat: THREE.MeshBasicMaterial }, look: Look | null, twist = 1){
      const palette = look?.palette?.length ? look.palette : WIPHALA, pattern = look ? look.pattern : 'diagonal', n = palette.length, P = ENVELOPE.length;
      const rgb = palette.map(hexRgb);
      body.gores.forEach((geo, g) => {
        const cols = geo.attributes.color as THREE.BufferAttribute, arr = cols.array as Float32Array;
        for(let f = 0; f < arr.length/9; f++){
          const c = rgb[lookIndex(pattern, g, Math.floor(f/2) % (P-1), n, look ? 1 : twist)];
          for(let v = 0; v < 3; v++) arr.set(c, f*9 + v*3);
        }
        cols.needsUpdate = true;
      });
      body.skirtMat.color.set(palette[0]).multiplyScalar(.5);
    }
    let mainLook: Look | null = null, houseLook: Look | null = null, myLook: Look | null = null, myBody: ReturnType<typeof balloonBody> | null = null;
    function buildBalloon(){
      const body = balloonBody();
      const { group, engine, lamps, bulbs, home, thread, skin } = body;
      myBody = body;
      paintBody(body, myLook || houseLook);
      rig.add(group);

      // what the logo gives back on arrival: a shockwave and the colours of the eleven lights
      const dirs = new Float32Array(BURST*3), tints = new Float32Array(BURST*3);
      for(let i = 0; i < BURST; i++){
        const u = rnd(0, Math.PI*2), v = Math.acos(rnd(-1, 1)), r = rnd(12, 60);
        dirs.set([Math.sin(v)*Math.cos(u)*r, Math.cos(v)*r, Math.sin(v)*Math.sin(u)*r], i*3);
        tints.set(hexRgb(COLORS[i % COLORS.length]), i*3);
      }
      const burstGeo = new THREE.BufferGeometry();
      burstGeo.setAttribute('position', new THREE.BufferAttribute(dirs, 3));
      burstGeo.setAttribute('color', new THREE.BufferAttribute(tints, 3));
      burst = new THREE.Points(burstGeo, new THREE.PointsMaterial({ size:1.1, map:SPRITE, vertexColors:true, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending }));
      burst.visible = false;
      scene.add(burst);
      shock = new THREE.Mesh(new THREE.RingGeometry(.975, 1, 128), new THREE.MeshBasicMaterial({ color:0xf0ede8, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide }));
      shock.visible = false;
      scene.add(shock);
      billboards.push(shock);

      balloon = { group, engine, lamps, bulbs, home, thread, skin, drops:[], tau:rnd(0, 400), peek:0, peekFrom:0, mode:'cruise', spawn:0, t0:0, p0:new THREE.Vector3(), dir:new THREE.Vector3(0,0,1), lit:0, over:false, sx:0, sy:0, onScreen:false };
      placeBalloon();
      buildBasketView();
      paintCanopy(myLook || houseLook);
    }
    // ── From the basket ──
    // Opening a piece while flying, you look at it from inside the basket. A camera-glued set (in `rig`, drawn
    // over everything) frames the edges only: the piece keeps the middle 72% of the screen, untouched.
    //   bottom: woven wicker walls, a leather-padded rim with stitching, hemp ropes lashed at the corners;
    //   top: the burner frame bar with its two cans, and the envelope's underside, Wiphala panels quilted and
    //   lit from inside, rippling in the wind.
    // Every 10-16 s the burner fires on its own: you hear it, the fabric glows, the wicker warms.
    const blastLight = $('blast-light');
    let basketView: THREE.Group | null = null, basketK = 0, nextBlast = 0, blastAt = -1e9, blastPower = 1;
    const basketMats: THREE.Material[] = [];
    let basketLow: THREE.Group, basketHigh: THREE.Group, burnerGlow: THREE.Sprite, flameJet: THREE.Sprite, flameCore: THREE.Sprite;
    let canopyGeo: THREE.BufferGeometry[] = [], canopyBase: Float32Array[] = [];
    const wickerMats: THREE.MeshBasicMaterial[] = [], canopyMats: THREE.MeshBasicMaterial[] = [];
    function wickerTexture(){
      const c = document.createElement('canvas'); c.width = 256; c.height = 128;
      const g = c.getContext('2d')!;
      g.fillStyle = '#120b06'; g.fillRect(0, 0, 256, 128);
      const rowH = 16, stake = 32;
      for(let r = 0; r < 128/rowH; r++) for(let s = 0; s < 256/stake; s++){
        const over = (r + s) % 2 === 0, x = s*stake, y = r*rowH;
        const grad = g.createLinearGradient(0, y, 0, y+rowH);
        grad.addColorStop(0, over ? '#6e4a2a' : '#3e2916');
        grad.addColorStop(.45, over ? '#b88a52' : '#6a4728');
        grad.addColorStop(1, over ? '#4a3019' : '#2a1b0e');
        g.fillStyle = grad;
        g.beginPath(); g.roundRect(x + (over ? 0 : 4), y + 2, stake - (over ? 0 : 8), rowH - 4, 6); g.fill();
      }
      g.fillStyle = 'rgba(0,0,0,.55)'; // the stakes the reeds weave around
      for(let s = 0; s < 256/stake; s++) g.fillRect(s*stake - 1, 0, 3, 128);
      const t = new THREE.CanvasTexture(c);
      t.wrapS = t.wrapT = THREE.RepeatWrapping;
      t.anisotropy = 4;
      return t;
    }
    // flat-shaded meshes still need volume: shade vertex colours by their normal, as if lit from above and in front
    function shade(geo: THREE.BufferGeometry, base: THREE.Color){
      geo.computeVertexNormals();
      const n = geo.attributes.normal as THREE.BufferAttribute, cols = new Float32Array(n.count*3);
      for(let i = 0; i < n.count; i++){
        const k = .45 + .5*Math.max(0, n.getY(i)) + .25*Math.max(0, n.getZ(i));
        cols.set([base.r*k, base.g*k, base.b*k], i*3);
      }
      geo.setAttribute('color', new THREE.BufferAttribute(cols, 3));
      return geo;
    }
    const canopyShade: { geo: THREE.BufferGeometry; k: Float32Array; gi: number; rows: number }[] = [];
    // the underside seen from the basket wears the same design as the envelope
    function paintCanopy(look: Look | null){
      const palette = look?.palette?.length ? look.palette : WIPHALA, pattern = look ? look.pattern : 'diagonal', rgb = palette.map(hexRgb);
      for(const { geo, k, gi, rows } of canopyShade){
        const cols = geo.attributes.color as THREE.BufferAttribute, arr = cols.array as Float32Array;
        for(let f = 0; f < k.length/3; f++){
          const base = rgb[lookIndex(pattern, gi, Math.floor(f/2) % rows, rgb.length, 1)];
          for(let v = 0; v < 3; v++){ const q = k[f*3+v]; arr[(f*3+v)*3] = base[0]*q; arr[(f*3+v)*3+1] = base[1]*q; arr[(f*3+v)*3+2] = base[2]*q; }
        }
        cols.needsUpdate = true;
      }
    }
    function buildBasketView(){
      if(!balloon) return;
      const view = new THREE.Group(), low = new THREE.Group(), high = new THREE.Group();
      view.add(low, high);
      const keep = <T extends THREE.Material>(m: T) => { m.depthTest = false; m.depthWrite = false; m.transparent = true; m.userData.base = m.opacity; basketMats.push(m); return m; };
      const put = <T extends THREE.Object3D>(parent: THREE.Group, o: T, order: number) => { o.renderOrder = order; o.frustumCulled = false; parent.add(o); return o; };
      const solid = (color: number) => keep(new THREE.MeshBasicMaterial({ vertexColors:true, color }));

      // ── the basket: round-cornered, as real ones are. Seen from inside, its rim draws a soft arc: highest in
      // the middle, far from you (~89% down the screen), curving down through the corners out of the frame.
      const H = 1.3, top = -.7, cz = -1.2, A = 1.45, Bz = .75; // plan: an ellipse around you, centre cz
      const plan = (phi: number) => new THREE.Vector3(A*Math.sin(phi), top, cz - Bz*Math.cos(phi));
      const inward = (p: THREE.Vector3) => new THREE.Vector3(-p.x/(A*A), 0, -(p.z - cz)/(Bz*Bz)).normalize();
      const PHI = 1.45, arc: THREE.Vector3[] = [];
      for(let i = 0; i <= 96; i++) arc.push(plan(-PHI + 2*PHI*i/96));
      // the wicker wall: a ribbon hanging from the arc, the weave running along it
      const tex = wickerTexture();
      tex.repeat.set(1, H/1.1);
      const wallMat = keep(new THREE.MeshBasicMaterial({ map:tex, color:new THREE.Color(.82, .78, .74), side:THREE.DoubleSide }));
      wickerMats.push(wallMat);
      const wv: number[] = [], wuv: number[] = [], wix: number[] = [];
      let run = 0;
      arc.forEach((p, i) => {
        if(i) run += p.distanceTo(arc[i-1]);
        wv.push(p.x, top, p.z, p.x, top - H, p.z);
        wuv.push(run/1.6, 1, run/1.6, 0);
        if(i) wix.push((i-1)*2, i*2, (i-1)*2+1, i*2, i*2+1, (i-1)*2+1);
      });
      const wallGeo = new THREE.BufferGeometry();
      wallGeo.setAttribute('position', new THREE.Float32BufferAttribute(wv, 3));
      wallGeo.setAttribute('uv', new THREE.Float32BufferAttribute(wuv, 2));
      wallGeo.setIndex(wix);
      put(low, new THREE.Mesh(wallGeo, wallMat), 20);
      // the leather-padded rim follows the arc, with its stitched seam on the side facing you
      const rimPath = new THREE.CatmullRomCurve3(arc);
      put(low, new THREE.Mesh(shade(new THREE.TubeGeometry(rimPath, 160, .042, 12), new THREE.Color(0x5e3519)), solid(0xffffff)), 22);
      for(const dy of [.026, -.012]){
        const pts = rimPath.getPoints(240).map(p => p.clone().addScaledVector(inward(p), .036).add(new THREE.Vector3(0, dy, 0)));
        const seam = new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), keep(new THREE.LineDashedMaterial({ color:0xe8d2b0, dashSize:.035, gapSize:.03, opacity:.75 })));
        seam.computeLineDistances();
        put(low, seam, 23);
      }
      // corner uprights: leather sleeves tapering a touch, a stitched seam down the side facing you,
      // three straps with small brass buckles. Kept at the screen edges (~97% across), outside any piece.
      for(const sx of [-1, 1]){
        const foot = plan(sx*.93), toward = inward(foot);
        const post = new THREE.CylinderGeometry(.03, .037, 2.4, 16); post.translate(foot.x, top + 1.15, foot.z);
        put(low, new THREE.Mesh(shade(post, new THREE.Color(0x4a2a15)), solid(0xffffff)), 24);
        const seamPts = [0, 1].map(k => new THREE.Vector3(foot.x, top + .05 + k*2.3, foot.z).addScaledVector(toward, .037 - k*.007));
        const seam = new THREE.Line(new THREE.BufferGeometry().setFromPoints(seamPts), keep(new THREE.LineDashedMaterial({ color:0xd9bf98, dashSize:.03, gapSize:.025, opacity:.6 })));
        seam.computeLineDistances();
        put(low, seam, 25);
        for(let k = 0; k < 3; k++){
          const y = top + .3 + k*.5;
          const strap = new THREE.CylinderGeometry(.04, .04, .028, 16); strap.translate(foot.x, y, foot.z);
          put(low, new THREE.Mesh(shade(strap, new THREE.Color(0x22140b)), solid(0xffffff)), 26);
          const buckle = new THREE.BoxGeometry(.03, .034, .008);
          buckle.lookAt(toward); buckle.translate(foot.x + toward.x*.042, y, foot.z + toward.z*.042);
          put(low, new THREE.Mesh(shade(buckle, new THREE.Color(0xb08a3e)), solid(0xffffff)), 27);
        }
      }

      // ── overhead: the burner frame bar and its two cans
      const W = 2.6, far = -1.8; // the frame spans the basket, just in front of you
      const bar = new THREE.CylinderGeometry(.035, .035, W + .2, 10); bar.rotateZ(Math.PI/2); bar.translate(0, .8, far - .15);
      put(high, new THREE.Mesh(shade(bar, new THREE.Color(0x4a4a55)), solid(0xffffff)), 24);
      for(const sx of [-1, 1]){
        const can = new THREE.CylinderGeometry(.045, .05, .12, 14); can.translate(sx*.075, .76, far - .1); // low enough that the flame above them shows
        put(high, new THREE.Mesh(shade(can, new THREE.Color(0x8a8f99)), solid(0xffffff)), 25);
      }
      burnerGlow = put(high, new THREE.Sprite(keep(new THREE.SpriteMaterial({ map:SPRITE, color:0xff9f1c, opacity:0, blending:THREE.AdditiveBlending }))), 26);
      burnerGlow.position.set(0, .88, far - .05);
      burnerGlow.scale.setScalar(.4);
      // the flame itself, roaring up from the cans into the envelope: only ever in the top band
      flameJet = put(high, new THREE.Sprite(keep(new THREE.SpriteMaterial({ map:SPRITE, color:0xff8a1c, opacity:0, blending:THREE.AdditiveBlending }))), 27);
      flameCore = put(high, new THREE.Sprite(keep(new THREE.SpriteMaterial({ map:SPRITE, color:0xfff1c4, opacity:0, blending:THREE.AdditiveBlending }))), 28);
      // the envelope's underside: quilted Wiphala panels, brightest near the burner, shaped so every point sits
      // ~19-26° above the view axis (only the top band of the screen)
      const ROWS = 9, GORE = 16, SEGS = 4, prof: THREE.Vector2[] = [];
      for(let j = 0; j <= ROWS; j++){ const r = 2 + j*1.3, t = j/ROWS; prof.push(new THREE.Vector2(r, r*(.49 - .14*t))); }
      const span = Math.PI*2/GORE;
      for(let gi = 0; gi < GORE; gi++){
        const lathe = new THREE.LatheGeometry(prof, SEGS, gi*span, span);
        const lp = lathe.attributes.position as THREE.BufferAttribute;
        for(let i = 0; i <= SEGS; i++) for(let j = 0; j <= ROWS; j++){ // each gore bulges down between its seams
          const v = i*(ROWS+1) + j;
          lp.setY(v, lp.getY(v) - Math.sin(Math.PI*i/SEGS)*.06*(1 + j*.4));
        }
        const geo = lathe.toNonIndexed(); lathe.dispose();
        const pos = geo.attributes.position as THREE.BufferAttribute, shadeK = new Float32Array(pos.count);
        for(let f = 0; f < pos.count/3; f++) for(let v = 0; v < 3; v++){
          const x = pos.getX(f*3+v), z = pos.getZ(f*3+v), r = Math.hypot(x, z);
          const a = ((Math.atan2(x, z) - gi*span)/span % 1 + 1) % 1, jr = ((r - 2)/1.3) % 1;
          const quilt = (.5 + .5*Math.pow(Math.sin(Math.PI*a), .6))*(.72 + .28*Math.sin(Math.PI*Math.min(1, jr + .001)));
          const lit = 1.15 - .55*(r - 2)/(ROWS*1.3); // the burner lights it from below, near the middle
          shadeK[f*3+v] = quilt*lit;
        }
        geo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(pos.count*3), 3));
        canopyShade.push({ geo, k:shadeK, gi, rows:ROWS });
        const m = keep(new THREE.MeshBasicMaterial({ vertexColors:true, color:new THREE.Color(.5, .47, .43), side:THREE.DoubleSide }));
        canopyMats.push(m);
        put(high, new THREE.Mesh(geo, m), 20);
        canopyGeo.push(geo);
        canopyBase.push((pos.array as Float32Array).slice());
      }
      // load tapes along every other seam
      const tapes: number[] = [];
      for(let gi = 0; gi < GORE; gi += 2) for(let j = 0; j < ROWS; j++){
        const a = gi*span, p0 = prof[j], p1 = prof[j+1];
        tapes.push(Math.sin(a)*p0.x, p0.y - .01, Math.cos(a)*p0.x, Math.sin(a)*p1.x, p1.y - .01, Math.cos(a)*p1.x);
      }
      const tg = new THREE.BufferGeometry(); tg.setAttribute('position', new THREE.Float32BufferAttribute(tapes, 3));
      put(high, new THREE.LineSegments(tg, keep(new THREE.LineBasicMaterial({ color:0xe8dcc8, opacity:.55 }))), 21);

      view.visible = false;
