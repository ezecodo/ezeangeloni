    }
    function placeShip(){
      if(!ship) return;
      const p = route(ship.tau), t = route(ship.tau+.2).sub(p).normalize();
      ship.group.position.copy(p);
      ship.up.addScaledVector(t, -ship.up.dot(t)).normalize(); // carried along, so it never flips at a vertical turn
      ship.group.quaternion.setFromRotationMatrix(new THREE.Matrix4().lookAt(p.clone().add(t), p, ship.up));
      ship.dir.copy(t);
    }
    // While a piece is open the ship slides out from behind it and waits, nose towards open space.
    function peekOut(s: Ship, e: number, now: number){
      const p = pieces[s.peekFrom];
      const dist = camera.position.distanceTo(p.mesh.position), D = dist+5, ratio = D/dist;
      const wide = camera.aspect >= 1.05;
      const at = wide ? new THREE.Vector3(p.w/2*ratio + 1.2, .4, -D) : new THREE.Vector3(.5, -(p.h/2*ratio + 1.7), -D);
      at.x += Math.sin(now*.0011)*.16;
      at.y += Math.sin(now*.0016)*.24;
      const from = focused >= 0 ? new THREE.Vector3(0, 0, -D) : s.group.position.clone();
      const nose = new THREE.Vector3(.84, wide ? .5 : .3, -.25).normalize();
      const q = new THREE.Quaternion().setFromRotationMatrix(new THREE.Matrix4().lookAt(at.clone().add(nose), at, new THREE.Vector3(0,1,0)));
      s.group.position.lerpVectors(from, at, e);
      if(focused >= 0) s.group.quaternion.copy(q); else s.group.quaternion.slerp(q, e);
    }
    function resetTrail(){
      if(!ship) return;
      placeShip();
      const { trail, group } = ship;
      trail.position.set(0,0,0); trail.quaternion.identity(); trail.scale.set(1,1,1);
      const p = trail.geometry.attributes.position as THREE.BufferAttribute;
      for(let i = 0; i < TRAIL; i++) p.setXYZ(i, group.position.x, group.position.y, group.position.z);
      p.needsUpdate = true;
    }
    function setLit(words: number){
      if(!ship) return;
      const lit = Math.min(words, 11), over = words > 11;
      if(lit > ship.lit && !over) playNote(NOTES[(lit-1) % NOTES.length]*(lit === 11 ? 2 : 1));
      ship.lit = lit;
      ship.over = over;
    }
    function updateShip(now: number, dt: number){
      if(!ship) return 0;
      const s = ship;
      const hidden = s.mode === 'away' || (focused >= 0 && s.mode !== 'cruise');
      s.group.visible = !hidden;
      s.trail.visible = focused < 0 && s.peek < .05;
      camera.updateMatrixWorld(); // the screen label must read this frame's camera, not the last one
      rig.position.copy(camera.position);
      rig.quaternion.copy(camera.quaternion);
      rig.updateMatrixWorld(true);
      let energy = 0;
      if(s.mode === 'cruise'){
        if(!reduced) s.tau += dt;
        placeShip();
        const grow = Math.min(1, (now-s.spawn)/900);
        const want = focused >= 0 && !flight ? 1 : 0;
        s.peek += (want-s.peek)*(1-Math.exp(-dt*(want ? 2.4 : 2.8)));
        if(!want && s.peek < .002) s.peek = 0;
        if(focused >= 0) s.peekFrom = focused;
        const e = s.peek*s.peek*(3-2*s.peek);
