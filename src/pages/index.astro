    // ── Pilot ─────────────────────────────────────────────
    // With a joystick (Gamepad API) you fly the balloon through the universe: the camera rides behind it,
    // and pieces open up as you approach them. Built for a digital 8-way stick and 4 buttons (Competition Pro).
    const pad = { x:0, y:0, px:0, py:0, held:[false,false,false,false], prev:[false,false,false,false] };
    interface Homing { t0: number; from: THREE.Vector3; ctrl: THREE.Vector3; to: THREE.Vector3; dur: number; landed: number; }
    let pilot: { pos: THREE.Vector3; vy: number; speed: number; turn: number; heading: number; drift: THREE.Vector3; overview: THREE.Vector3; hudAt: number; selecting: boolean; sel: number; cands: number[]; picked: number[] | null; home: Homing | null; drawing: number; dock: number; dockFree: boolean; undock: number; nearGalaxy: number; auto: { k: number; sun: boolean } | null; lookYaw: number; lookPitch: number; knock: THREE.Vector3 } | null = null;
    let padRepeat = 0;
    let PILOT_R = 150;
    const PILOT_Y = 70, TOP = 22, REVERSE = -7, CLIMB = 12, SINK = -3.5, WIND_PUSH = .25;
    // The keyboard drives the same virtual pad, so everything below works the same without a joystick:
    // WASD always (that's how you take off); arrows, space, E/Enter, Q/Backspace only once you're flying,
    // so before that they keep browsing the archive as always. T (leave a word) and Esc have their own keys.
    const keys = new Set<string>();
    const KB_ALWAYS = ['w','a','s','d'], KB_PILOT = ['arrowup','arrowdown','arrowleft','arrowright',' ','e','enter','q','backspace'];
    window.addEventListener('keydown', e => {
      if(boarded || anyOpen() || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = (e.target as HTMLElement).tagName;
      if(t === 'INPUT' || t === 'TEXTAREA') return;
      const k = e.key.toLowerCase();
      if(KB_ALWAYS.includes(k) || (pilot && KB_PILOT.includes(k))){ keys.add(k); if(pilot) e.preventDefault(); }
    });
    window.addEventListener('keyup', e => keys.delete(e.key.toLowerCase()));
    window.addEventListener('blur', () => keys.clear());
    // Touch drives it too: a stick under the left thumb (it appears where the thumb lands, read in eight
    // directions like the Competition Pro) and four round buttons with the pad's roles under the right one.
    // A tap shorter than a frame is latched so it still counts once
    const tpad = { x:0, y:0, held:[false,false,false,false], latch:[false,false,false,false] };
    let flyWanted = 0;
    if(isTouch) document.body.classList.add('touch');
    window.addEventListener('pointerdown', e => { if(e.pointerType === 'touch') document.body.classList.add('touch'); }, true);
