    // The string of lights swings under the basket; the thread follows whatever is still hanging.
    function swayGarland(s: Balloon, now: number){
      const pos = s.thread.geometry.attributes.position as THREE.BufferAttribute;
      pos.setXYZ(0, 0, -2.55, 0);
      // refuelling, the string of lights reaches out into the nebula's core: a hose for the gas
      let from: THREE.Vector3 | null = null, to: THREE.Vector3 | null = null;
      const e = reach*reach*(3-2*reach);
      if(e > .001 && reachCloud && s.mode === 'pilot'){
        s.group.updateMatrixWorld();
        from = s.group.localToWorld(new THREE.Vector3(0, -2.55, 0));
        to = reachCloud.pos.clone();
      }
      s.bulbs.forEach((b, k) => {
        const h = s.home[k], a = (k+1)*.045;
        const at = new THREE.Vector3(h.x + Math.sin(now*.0013 - k*.35)*a, h.y, h.z + Math.sin(now*.0009 - k*.3)*a*.6);
        if(from && to){
          const t = (k+1)/11, w = from.clone().lerp(to, t);
          w.y -= Math.sin(t*Math.PI)*2.2 - Math.sin(now*.002 + k*.6)*.25; // it sags, and breathes
          at.lerp(s.group.worldToLocal(w), e);
        }
