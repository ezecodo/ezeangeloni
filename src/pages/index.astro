        const burner = new THREE.CylinderGeometry(.16, .2, .22, 8);
        burner.translate(0, -1.32, 0);
        add(burner, 30);
        const basket = new THREE.BoxGeometry(.86, .62, .86);
        basket.translate(0, -2.24, 0);
        add(basket);
        const rim = new THREE.BoxGeometry(.98, .09, .98);
        rim.translate(0, -1.93, 0);
        add(rim);
        const weave: number[] = [];
        for(const y of [-2.12, -2.32]) for(const [a,b] of [[[.43,.43],[.43,-.43]],[[.43,-.43],[-.43,-.43]],[[-.43,-.43],[-.43,.43]],[[-.43,.43],[.43,.43]]] as [number,number][][]) weave.push(a[0]*1.01, y, a[1]*1.01, b[0]*1.01, y, b[1]*1.01);
