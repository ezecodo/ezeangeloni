        ship.t0 = performance.now();
        ship.p0.copy(ship.group.position);
        ship.ctrl.copy(ship.p0).addScaledVector(ship.dir, 34).add(new THREE.Vector3(0, -8, 0));
        // pull back to watch it land: the logo sits low in frame, under the thank-you
        const side = ship.p0.lengthSq() > 1 ? ship.p0.clone().normalize() : new THREE.Vector3(0, 0, 1);
        flyTo(side.multiplyScalar(50).add(new THREE.Vector3(0, 7, 0)), new THREE.Vector3(0, 6, 0), DELIVERY*1000-300);
      }
      if(audioCtx && masterGain){
        const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), g = audioCtx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(55, t);
        osc.frequency.exponentialRampToValueAtTime(1400, t+DELIVERY);
        g.gain.setValueAtTime(.001, t);
        g.gain.exponentialRampToValueAtTime(.42, t+DELIVERY-.1);
        g.gain.exponentialRampToValueAtTime(.001, t+DELIVERY+.05);
        osc.connect(g); g.connect(masterGain);
        osc.start(t); osc.stop(t+DELIVERY+.05);
      }
      setTimeout(() => { msgThanks.style.display = 'block'; }, DELIVERY*1000+500);
      setTimeout(() => { delivering = false; leaveShip(); }, DELIVERY*1000+4300);
    }

    function backOut(){
      if(focused < 0) return;
      const p = pieces[focused];
      p.mat.depthTest = true;
      p.mesh.renderOrder = 0;
      focused = -1;
      document.body.classList.remove('focus');
      btnBack.hidden = true;
      lamp.classList.remove('on');
      showMeta(0);
      const to = overviewPos.lengthSq() ? overviewPos.clone() : new THREE.Vector3(0, overviewR*.34, overviewR);
      flyTo(to, CENTER.clone(), 1700, () => { if(controls){ controls.target.copy(CENTER); controls.enabled = true; } });
      const url = new URL(location.href);
      url.hash = '';
      history.replaceState(null, '', url.toString());
    }
    function stepFocus(d: number){
      const from = focused < 0 ? (d > 0 ? 0 : pieces.length) : focused;
      const to = Math.max(1, Math.min(pieces.length-1, from+d));
      if(to !== focused) focusOn(to, 1100);
    }
    function showMeta(i: number){
      const st = stations[i];
      shown = i;
      const home = st.kind === 'home';
      metaId.textContent = home
        ? `${total} señales`
        : `Nº ${String(st.n).padStart(3,'0')}/${total} · ${st.date.replaceAll('-','·')}`;
      metaCap.textContent = home ? 'pasado observado' : (st.kind === 'text' || st.flood) && focused === i ? '' : st.text;
      act.hidden = !(st.kind === 'set' && focused === i);
      nowEl.textContent = home ? 'Eze Angeloni, Cronovisor' : `${st.date}: ${st.text || 'foto sin título'}`;
    }

    // ── Input ─────────────────────────────────────────────
    const ray = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    let pointerFresh = false, press: { x: number, y: number, t: number } | null = null, wheelAt = 0;
    function pick(){
      ray.setFromCamera(ndc, camera);
      const hit = ray.intersectObjects(pieces.slice(1).map(p => p.mesh), false)[0];
      return hit ? hit.object.userData.i as number : -1;
    }
    function setNdc(e: PointerEvent){
      ndc.set(e.clientX/window.innerWidth*2-1, -(e.clientY/window.innerHeight)*2+1);
    }
    screen.addEventListener('pointermove', e => {
      if(e.pointerType !== 'mouse') return;
      setNdc(e);
      pointerFresh = true;
    });
    screen.addEventListener('pointerdown', e => {
      press = { x:e.clientX, y:e.clientY, t:performance.now() };
