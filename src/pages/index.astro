        const w = worlds.find(x => x.link.galaxy && x.link.galaxy.slug === String(e.g ?? ''));
        if(!w?.link.galaxy?.open){ stopFollow(`${o.name} crossed into a galaxy you can't enter`); return; }
        try { sessionStorage.setItem('cv-follow', JSON.stringify({ name:o.name, t:Date.now() })); } catch {}
        enterGalaxy(w, true);
      }
    }
    // after crossing together: find each other again on the other side
    // keep looking for a minute: the new galaxy takes a while to load, and either of you may arrive first
    setInterval(() => {
      let f: { name: string; t: number } | null = null;
      try { f = JSON.parse(sessionStorage.getItem('cv-follow') || 'null'); } catch {}
      if(!f) return;
      if(Date.now()-f.t > 60000){ sessionStorage.removeItem('cv-follow'); return; }
      if(follow || !pilot) return;
      const o = [...others.values()].find(x => x.name === f!.name);
      if(!o) return;
      sessionStorage.removeItem('cv-follow');
      sendTo(o.id, { k:'join' });
      startFollow(o);
    }, 1000);
    // whoever leads lands for a moment (or the window loses them): you hover where they were and wait a minute
    setInterval(() => {
      if(!follow) return;
      const o = others.get(follow.id), now = performance.now();
      if(!o){ stopFollow(''); return; }
      if(o.vis < .3){
        if(!follow.waiting){ follow.waiting = now; crewMsg.textContent = `waiting for ${o.name} to fly again · burner flies on your own`; }
        else if(now-follow.waiting > 60000) stopFollow(`${o.name} landed`);
      } else if(follow.waiting){ follow.waiting = 0; paintCrew(); }
    }, 1000);
    // ── Voice on an expedition: whoever leads and whoever follows hear each other, as if in the same basket ──
    // Browser to browser (WebRTC), the relay on the VPS (coturn) when the network won't let them meet directly.
    // Whoever leads calls; the microphone is asked for when you invite or go along (a tap), never on loading.
    const calls = new Map<string, { pc: RTCPeerConnection; audio: HTMLAudioElement; pending: RTCIceCandidateInit[] }>();
    let mic: MediaStream | null = null, micAsk: Promise<MediaStream | null> | null = null, muted = false, micDenied = false, ice: RTCIceServer[] | null = null;
    const micBtn = $('mic') as HTMLButtonElement;
    function paintMic(){
      micBtn.hidden = !calls.size;
      if(!calls.size) return;
      const names = [...calls.keys()].map(id => others.get(id)?.name).filter(Boolean).join(', ');
      const live = [...calls.values()].some(c => c.pc.connectionState === 'connected');
      const kb = document.body.classList.contains('touch') ? '' : ' · v';
      micBtn.textContent = !live ? `connecting voice with ${names}…` : micDenied ? `listening to ${names} · no microphone` : muted ? `muted · tap to talk to ${names}${kb}` : `talking with ${names}${kb} mutes`;
      micBtn.classList.toggle('off', muted || micDenied);
      micBtn.classList.toggle('wait', !live);
    }
    function getMic(){
      if(mic) return Promise.resolve(mic);
      if(micAsk) return micAsk;
      if(!navigator.mediaDevices?.getUserMedia){ micDenied = true; return Promise.resolve(null); }
      micAsk = navigator.mediaDevices.getUserMedia({ audio:{ echoCancellation:true, noiseSuppression:true, autoGainControl:true } })
        .then(m => { mic = m; micDenied = false; m.getAudioTracks().forEach(t => t.enabled = !muted); return m; })
        .catch(() => { micDenied = true; return null; })
        .finally(() => { micAsk = null; paintMic(); });
      return micAsk;
    }
    async function iceServers(){
      if(ice) return ice;
      const r = await fetch('/api/frases/sky-turn', { method:'POST', headers:doorHeaders(), body:JSON.stringify({ device:DEVICE }) }).then(r => r.ok ? r.json() : null).catch(() => null);
      return ice = Array.isArray(r?.iceServers) ? r.iceServers : [];
    }
    // one setup per person, even when their first candidates arrive before their offer
    const setups = new Map<string, Promise<{ pc: RTCPeerConnection; audio: HTMLAudioElement; pending: RTCIceCandidateInit[] }>>();
    function call(id: string, offer: boolean){
      if(!setups.has(id)) setups.set(id, setUp(id, offer));
      return setups.get(id)!;
    }
    async function setUp(id: string, offer: boolean){
      const audio = new Audio();
      audio.autoplay = true;
      audio.setAttribute('playsinline', '');
      const c = { pc: new RTCPeerConnection(), audio, pending: [] as RTCIceCandidateInit[] };
      calls.set(id, c);
      paintMic();
      c.pc.setConfiguration({ iceServers: await iceServers() });
      c.pc.onicecandidate = e => { if(e.candidate) sendTo(id, { k:'ice', c:e.candidate.toJSON() }); };
      c.pc.ontrack = e => { audio.srcObject = e.streams[0] || new MediaStream([e.track]); audio.play().catch(() => {}); };
      c.pc.onconnectionstatechange = () => { paintMic(); if(c.pc.connectionState === 'failed') c.pc.restartIce?.(); };
      const m = await getMic();
      if(m) m.getAudioTracks().forEach(t => c.pc.addTrack(t, m));
      else c.pc.addTransceiver('audio', { direction:'recvonly' }); // no microphone: you can still listen
      if(offer){
        await c.pc.setLocalDescription(await c.pc.createOffer());
        sendTo(id, { k:'sdp', d:c.pc.localDescription?.toJSON() });
      }
      return c;
    }
    function hangUp(id: string){
      const c = calls.get(id);
      if(!c) return;
      c.pc.close();
      c.audio.srcObject = null;
      calls.delete(id);
      setups.delete(id);
      if(!calls.size && mic){ mic.getTracks().forEach(t => t.stop()); mic = null; } // the browser's microphone light goes off
      paintMic();
    }
    async function onVoice(o: Other, e: { k?: string; d?: any; c?: any }){
      if(!(crew.has(o.id) || follow?.id === o.id)) return; // only the two on an expedition
      try {
        if(e.k === 'sdp' && e.d?.type){
          const c = await call(o.id, false);
          await c.pc.setRemoteDescription(e.d);
          for(const x of c.pending.splice(0)) await c.pc.addIceCandidate(x).catch(() => {});
          if(e.d.type === 'offer'){
            await c.pc.setLocalDescription(await c.pc.createAnswer());
            sendTo(o.id, { k:'sdp', d:c.pc.localDescription?.toJSON() });
          }
        } else if(e.k === 'ice' && e.c){
          const c = await call(o.id, false);
          if(c.pc.remoteDescription) await c.pc.addIceCandidate(e.c).catch(() => {});
          else c.pending.push(e.c);
        }
      } catch {}
    }
    function toggleMute(){
      if(!calls.size) return;
      if(micDenied){ getMic().then(m => { if(m) for(const c of calls.values()) m.getAudioTracks().forEach(t => c.pc.addTrack(t, m)); }); return; }
      muted = !muted;
      mic?.getAudioTracks().forEach(t => t.enabled = !muted);
      paintMic();
    }
    micBtn.addEventListener('click', () => { touched(); toggleMute(); });
    // a browser that wouldn't play the voice yet (no tap since the page loaded, after crossing) plays it on the next one
    const replay = () => { for(const c of calls.values()) if(c.audio.paused && c.audio.srcObject) c.audio.play().catch(() => {}); };
    window.addEventListener('pointerdown', replay, true); // capture: the touch buttons stop their own events
    window.addEventListener('keydown', replay, true);
    meetForm.addEventListener('submit', e => {
      e.preventDefault();
      const text = meetInput.value.replace(/\s+/g, ' ').trim().slice(0, 200);
      if(!text || !meet) return;
      sendTo(meet.id, { k:'say', text });
      logMeet('you', text);
      meetInput.value = '';
    });
    meetInput.addEventListener('keydown', e => { if(e.key === 'Escape'){ e.stopPropagation(); meetInput.blur(); meetForm.hidden = true; } });
    $('meet-talk').addEventListener('click', () => { touched(); openTalk(); });
    $('meet-gas').addEventListener('click', () => { touched(); giveGas(); });
    $('meet-trip').addEventListener('click', () => { touched(); inviteTrip(); });
    $('meet-yes').addEventListener('click', () => { touched(); acceptTrip(); });
    $('meet-no').addEventListener('click', () => { touched(); if(invitedBy) sendTo(invitedBy, { k:'decline' }); hideInvite(); });
    // touching: the envelopes meet (each about 2.3 across at the balloon's scale, a little taller than wide)
    function crossingTogether(){ // just crossed on an expedition: you arrive at the same spot, no bumping while you find each other
      for(const k of ['cv-follow', 'cv-lead']){ try { const v = JSON.parse(sessionStorage.getItem(k) || 'null'); if(v && Date.now()-v.t < 60000) return true; } catch {} }
      return false;
    }
    function checkBump(now: number){
      if(!pilot || focused >= 0 || pilot.selecting || pilot.home || boarded || crossingTogether()) return;
      for(const o of others.values()){
        if(o.vis < .8 || follow?.id === o.id || crew.has(o.id)) continue; // flying together: no bumping
        const d = centre(pilot.pos).sub(centre(o.body.group.position));
        d.y /= 1.5;
        if(d.length() < 4.6 && now-lastBump > 2500){
          lastBump = now;
          o.flash = now;
          thud();
          pushAway(o, 6);
          sendTo(o.id, { k:'bump' });
          openMeet(o);
        }
      }
      // parting: fly away (or land, or open a piece) and the menu closes
      const o = meet && others.get(meet.id);
      if(meet && (!o || o.vis < .5 || pilot.pos.distanceTo(o.body.group.position) > 28)) closeMeet();
    }
    let meetSyncAt = 0;
    function updateMeeting(now: number){
      checkBump(now);
      if(meet && (!pilot || focused >= 0 || boarded)) closeMeet();
      if(meet && now-meetSyncAt > 500){ meetSyncAt = now; syncMeet(); }
      updateFlows(now);
    }
    if(import.meta.env.DEV) (window as any).__sky = { get others(){ return others; }, get sky(){ return sky; }, get meet(){ return meet; }, ev: onSkyEvent, get focused(){ return focused; }, get stations(){ return stations; }, call, get calls(){ return calls; }, crew };
    galaxyReady.then(() => {
      linkList = GAL ? [] : DEFAULT_LINKS;
      buildSun();
      buildWorlds();
      loadXibalba();
      if(locked) return;
      fetch(BASE + '/links.json', { cache: 'no-store' })
        .then(r => r.ok ? r.json() : null)
        .then(d => { if(Array.isArray(d?.links)){ linkList = d.links; buildWorlds(); } })
        .catch(() => {});
    });
  </script>
</Layout>
