      p.mesh.renderOrder = 0;
      focused = -1;
      document.body.classList.remove('focus');
      btnBack.hidden = true;
      showMeta(0);
    }
    function leaveShip(){
      if(!boarded) return;
      boarded = false;
      cockpit.classList.remove('open', 'flat');
      document.body.classList.remove('aboard');
      if(!renderer || !ship) return;
      const stayed = ship.mode === 'board';
      if(stayed){ ship.mode = 'parked'; setLit(0); }
      flyTo(overviewPos.clone(), CENTER.clone(), 1700, () => {
        if(controls){ controls.target.copy(CENTER); controls.enabled = true; }
        if(stayed && ship){ ship.mode = 'away'; ship.t0 = performance.now()-3800; }
      });
    }
    function impact(now: number){
      if(!ship) return;
      ship.mode = 'away';
      ship.t0 = now;
      impactAt = now;
      logoPulse = 1;
      if(burst && shock && !reduced){ burst.visible = true; shock.visible = true; }
      if(audioCtx && masterGain){
        const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), g = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(130, t);
        osc.frequency.exponentialRampToValueAtTime(34, t+.9);
        g.gain.setValueAtTime(1.3, t);
        g.gain.exponentialRampToValueAtTime(.001, t+1.1);
        osc.connect(g); g.connect(masterGain);
        osc.start(t); osc.stop(t+1.1);
      }
      for(let k = 0; k < 11; k++) setTimeout(() => playNote(NOTES[k % NOTES.length]*2), 90 + k*85); // the eleven words, one last time
    }
    function launch(){
      msgForm.style.display = 'none';
      delivering = true;
      if(ship){
