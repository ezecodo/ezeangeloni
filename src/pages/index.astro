        s.group.scale.setScalar(SHIP_SCALE*(1-Math.pow(1-grow, 3))*(1-e*.56));
      } else if(s.mode === 'launch'){
        // the message is for Eze: a banked run across the universe straight into the logo
        const e = (now-s.t0)/1000, k = Math.min(1, e/DELIVERY), q = reduced ? 1 : Math.pow(k, 2.3), r = 1-q;
        const pos = s.p0.clone().multiplyScalar(r*r).addScaledVector(s.ctrl, 2*r*q);
        const tan = s.ctrl.clone().multiplyScalar(2*r-2*q).addScaledVector(s.p0, -2*r);
        s.group.position.copy(pos);
        if(tan.lengthSq() > 1e-4) s.group.lookAt(pos.clone().add(tan));
        const size = SHIP_SCALE*(1-Math.max(0, (k-.74)/.26));
