      }
      return energy;
    }
    function board(){
      if(boarded) return;
      touched();
      if(!renderer || !ship){ cockpit.classList.add('flat', 'open'); boarded = true; resetForm(); return; }
      if(focused >= 0) backOutNow();
      boarded = true;
      hoverShip = false;
      ship.mode = 'board';
      ship.peek = 0;
      ship.group.scale.setScalar(SHIP_SCALE);
      resetForm();
      if(controls){ controls.enabled = false; overviewPos.copy(camera.position); }
      // from here on it's a physical object in the universe, parked where you caught it
      scene.attach(ship.group);
      scene.attach(ship.trail);
      ship.group.getWorldDirection(ship.dir);
      const p = ship.group.position, t = ship.dir;
      const side = t.clone().cross(new THREE.Vector3(0,1,0)).normalize();
      if(side.dot(camera.position.clone().sub(p)) < 0) side.negate();
      const up = side.clone().cross(t).normalize();
      if(up.y < 0) up.negate();
      const d = 17.4*Math.max(1, Math.pow(1.2/camera.aspect, .5));
      document.body.classList.add('aboard');
      flyTo(p.clone().addScaledVector(side, d).addScaledVector(up, 1.6), p.clone().addScaledVector(up, 4.4), 1900, () => {
        cockpit.classList.add('open');
        setTimeout(() => msgInput.focus(), 200);
      });
    }
    function backOutNow(){
      const p = pieces[focused];
