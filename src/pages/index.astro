---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Eze Angeloni — Cronovisor">
  <Fragment slot="head">
    <meta name="description" content="Cronovisor: pasado observado. Fotos, frases y sets de Eze Angeloni, en sistema propio." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital@0;1&family=Cormorant+Garamond:ital,wght@0,300;1,300;1,400&display=swap" rel="stylesheet" />
    <style is:global>
      @font-face {
        font-family: 'MalvinasSans';
        src: url('/fonts/MalvinasSans-Regular.otf?v=20') format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --bg: #080810; --text: #f0ede8; --muted: rgba(240,237,232,0.5);
        --ink: #fff; --mono: 'DM Mono', monospace; --serif: 'Cormorant Garamond', serif;
        --dial: 10px;
      }
      html, body { width: 100%; height: 100%; overflow: hidden; background: var(--bg); color: var(--text); font-family: var(--mono); cursor: none; overscroll-behavior: none; }
      button { font: inherit; color: inherit; background: none; border: none; cursor: none; }
      a { color: inherit; cursor: none; }
      :focus-visible { outline: 1px solid var(--text); outline-offset: 3px; }
      #screen { position: fixed; inset: 0; width: 100%; height: 100%; touch-action: none; }
      #cursor { position: fixed; width: 5px; height: 5px; background: var(--ink); border-radius: 50%; pointer-events: none; z-index: 9999; transform: translate(-50%,-50%); }
      #cursor::before, #cursor::after { content:''; position:absolute; border-radius:50%; border:1px solid var(--ink); top:50%; left:50%; transform:translate(-50%,-50%); animation: sonar 2.4s ease-out infinite; }
      #cursor::after { animation-delay:1.2s; }
      @keyframes sonar { 0% { width:5px; height:5px; opacity:.8; } 100% { width:70px; height:70px; opacity:0; } }

      /* instrument panel */
      #hud { position: fixed; inset: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); pointer-events: none; z-index: 10; color: var(--ink); font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; }
      #hud button, #hud a { pointer-events: auto; letter-spacing: inherit; text-transform: inherit; text-decoration: none; }
      #top { position: absolute; top: 0; left: 0; right: 0; padding: 1.1rem 1.4rem; display: flex; justify-content: space-between; gap: 1rem; }
      #brand { font-size: inherit; font-weight: 400; padding: .2rem 0; }
      #nav { display: flex; gap: 1.4rem; }
      #nav button { text-transform: inherit; padding: .2rem 0; opacity: .72; transition: opacity .2s; }
      #nav button:hover, #nav button.on { opacity: 1; }
      #nav button.on::before { content: '● '; }
      #btn-me { color: #ff6eb4; }
      #me-menu { position: absolute; right: 1.4rem; top: 3.2rem; display: flex; flex-direction: column; align-items: flex-end; gap: .7rem; padding: .9rem 1rem; background: rgba(8,8,16,.85); border: 1px solid rgba(240,237,232,.16); }
      #me-menu[hidden] { display: none; }
      #me-menu a, #me-menu button { opacity: .85; }
      #me-menu a:hover, #me-menu button:hover { opacity: 1; }
      #signin, #signed-as { margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid rgba(240,237,232,.12); max-width: 34rem; font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
      #signin label { display: block; margin-bottom: .8rem; }
      #signin div { display: flex; gap: 1rem; align-items: baseline; }
      #signin input { flex: 1; min-width: 0; background: transparent; border: 0; border-bottom: 1px solid rgba(240,237,232,.4); color: var(--ink); font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; padding: .2rem 0; outline: none; }
      #signin button, #signed-as button { color: #ff6eb4; letter-spacing: .16em; text-transform: uppercase; font-size: .62rem; }
      #signin-msg { min-height: 1em; margin: .8rem 0 0; color: #ff6eb4; }
      #nav button[hidden] { display: none; }
      #meta { position: absolute; left: 1.4rem; right: 1.4rem; bottom: calc(var(--dial) + .7rem); display: flex; align-items: baseline; gap: 1.2rem; }
      #meta-id { white-space: nowrap; }
      #meta-cap { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.2rem,2.6vw,2rem); letter-spacing: 0; text-transform: none; line-height: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-bottom: .1em; }
      #lamp { width: 7px; height: 7px; border-radius: 50%; background: currentColor; align-self: center; flex-shrink: 0; opacity: .2; transition: opacity .25s; }
      #lamp.on { opacity: 1; }
      #hint { margin-left: auto; white-space: nowrap; opacity: .72; animation: blink 2s steps(2) infinite; }
      #hint[hidden] { display: none; }
      @keyframes blink { 50% { opacity: .25; } }
      #act { position: absolute; right: 1.4rem; bottom: calc(var(--dial) + 3.6rem); width: 112px; height: 112px; border-radius: 50%; background: var(--ink); color: #080810; font-size: .68rem; transition: transform .2s; }
      #act:hover { transform: scale(1.06); }
      #act[hidden] { display: none; }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

      #locked { position: fixed; inset: 0; z-index: 30; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 1rem; background: radial-gradient(ellipse at center, rgba(40,24,60,.5), rgba(8,8,16,.92) 60%); padding: 2rem; }
      #locked[hidden] { display: none; }
      #locked .kicker { font-size: .64rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
      #locked h2 { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(2.6rem, 7vw, 5rem); }
      #locked p:not(.kicker) { font-family: var(--serif); font-size: 1.15rem; max-width: 30rem; color: var(--muted); }
      #locked a { margin-top: 1rem; font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: #6ef9f5; text-decoration: none; border: 1px solid rgba(110,249,245,.45); padding: .6rem .9rem; }
      /* the galaxies marked as on a star chart: a thin ellipse and a catalogue name; off screen, at the edge, pointing */
      #sky-marks { position: fixed; inset: 0; z-index: 11; pointer-events: none; transition: opacity .4s; }
      body.focus #sky-marks, body.aboard #sky-marks, body.selecting #sky-marks { opacity: 0; }
      .sky-mark.open, .sky-mark.closed { pointer-events: auto; } /* a galaxy's name takes you there */
      .sky-mark { position: absolute; left: 0; top: 0; display: flex; align-items: center; gap: .55rem; font-size: .58rem; letter-spacing: .18em; text-transform: uppercase; white-space: nowrap; text-shadow: 0 0 8px rgba(8,8,16,.95); will-change: transform; }
      .sky-mark i { flex: none; width: 46px; height: 20px; border: 1px solid currentColor; border-radius: 50%; transform: rotate(-16deg); opacity: .75; }
      .sky-mark b { display: none; flex: none; font-weight: 400; font-size: .9rem; }
      .sky-mark.edge i { display: none; }
      .sky-mark.edge b { display: inline-block; }
      .sky-mark.open { color: #ffd166; }
      .sky-mark.closed { color: #6ef9f5; opacity: .7; }
      .sky-mark.sun { color: #ffb347; }
      .sky-mark.sun i { border-radius: 50%; width: 22px; height: 22px; transform: none; }
      .sky-mark[hidden] { display: none; }
      /* threads between galaxies */
      #thread-note { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(var(--dial) + 4.2rem); z-index: 12; display: flex; flex-direction: column; gap: .4rem; align-items: center; text-shadow: 0 0 14px rgba(8,8,16,.95); }
      #thread-note[hidden] { display: none; }
      #thread-note div { display: flex; gap: .7rem; align-items: center; font-family: var(--serif); font-style: italic; font-size: 1.05rem; color: #ffd166; }
      #thread-note button, #connect-piece { font-family: var(--mono); font-style: normal; font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; color: #ffd166; border: 1px solid rgba(255,209,102,.45); padding: .35rem .6rem; background: rgba(8,8,16,.5); }
      #thread-note button.cut { color: var(--muted); border-color: rgba(240,237,232,.2); }
      #connect-piece { position: fixed; left: 1.4rem; bottom: calc(var(--dial) + 3rem); z-index: 12; }
      #connect-piece[hidden] { display: none; }
      #link-sheet .link-hint { font-size: .64rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin: -.6rem 0 1rem; }
      #link-search { width: min(520px, 100%); background: rgba(240,237,232,.05); border: 1px solid rgba(240,237,232,.2); color: var(--text); font: inherit; font-size: .8rem; padding: .6rem .8rem; outline: none; margin-bottom: 1.2rem; }
      #link-grid { columns: 6 160px; column-gap: 10px; }
      #link-grid button { display: block; width: 100%; margin-bottom: 10px; break-inside: avoid; border: 1px solid transparent; text-align: left; }
      #link-grid button:hover { border-color: #ffd166; }
      #link-grid img { display: block; width: 100%; }
      #link-grid span { display: block; font-family: var(--serif); font-style: italic; font-size: 1rem; padding: .8rem; background: #15131f; }
      #link-grid small { display: block; font-size: .55rem; letter-spacing: .12em; color: var(--muted); padding: .25rem 0 0; }
      /* only for the galaxy's owner, at one of its pieces */
      #remove-piece { position: fixed; right: 1.4rem; bottom: calc(var(--dial) + 3rem); z-index: 12; font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,63,63,.75); border: 1px solid rgba(255,63,63,.35); padding: .45rem .7rem; background: rgba(8,8,16,.5); }
      #remove-piece:hover { color: #ff3f3f; border-color: #ff3f3f; }
      #remove-piece[hidden] { display: none; }
      /* arriving in a galaxy: its name, like the title of a chapter, then gone */
      #arrival { position: fixed; left: 0; right: 0; top: 22vh; z-index: 13; text-align: center; pointer-events: none; opacity: 0; transition: opacity 1.6s ease; text-shadow: 0 0 24px rgba(8,8,16,.9); }
      #arrival.show { opacity: 1; transition-duration: 1.2s; }
      #arrival p { font-size: .64rem; letter-spacing: .3em; text-transform: uppercase; color: var(--muted); }
      #arrival h2 { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(2.6rem, 7vw, 5.5rem); line-height: 1; margin-top: .5rem; }
      /* Xibalbá: the deeper you go, the darker and redder the edges */
      #xib-dark { position: fixed; inset: 0; z-index: 8; pointer-events: none; opacity: 0; background: radial-gradient(ellipse at center, rgba(20,4,8,.15) 30%, rgba(40,6,10,.85) 100%); }
      #xib-panel { position: fixed; left: 2.4rem; bottom: 5rem; z-index: 12; width: min(380px, 80vw); opacity: 0; pointer-events: none; transition: opacity .6s; text-shadow: 0 0 18px rgba(8,8,16,.95); }
      #xib-panel.show { opacity: 1; pointer-events: auto; }
      #xib-panel .kicker { font-size: .6rem; letter-spacing: .22em; text-transform: uppercase; color: #ffb37a; }
      #xib-name { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 2.6rem; line-height: 1; margin: .4rem 0 .6rem; }
      #xib-where { font-family: var(--serif); font-size: 1.05rem; line-height: 1.4; color: var(--text); }
      #xib-words { list-style: none; margin: .9rem 0; display: flex; flex-direction: column; gap: .35rem; }
      #xib-words li { font-family: var(--serif); font-style: italic; font-size: 1rem; color: rgba(240,237,232,.8); }
      #xib-words li small { font-family: var(--mono); font-style: normal; font-size: .55rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-left: .5rem; }
      #xib-form { display: flex; flex-direction: column; gap: .4rem; }
      #xib-form label { font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
      #xib-form span { display: flex; gap: .4rem; }
      #xib-form input { flex: 1; min-width: 0; background: rgba(8,8,16,.6); border: 1px solid rgba(255,179,122,.35); color: var(--text); font: inherit; font-family: var(--serif); font-size: 1rem; padding: .5rem .6rem; outline: none; }
      #xib-form button { font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: #ffb37a; border: 1px solid rgba(255,179,122,.45); padding: .5rem .7rem; white-space: nowrap; }
      .sky-mark.xib { color: #ffb37a; }
      .sky-mark.xib i { width: 10px; height: 10px; border-radius: 50%; transform: none; background: currentColor; border: none; box-shadow: 0 0 10px currentColor; }
      body.focus #xib-panel, body.aboard #xib-panel { opacity: 0; pointer-events: none; }
      /* crossing into another galaxy: everything goes to light */
      #warp { position: fixed; inset: 0; z-index: 40; pointer-events: none; background: #f0ede8; opacity: 0; transition: opacity .9s ease-in; }
      #warp.on { opacity: 1; }
      /* a world (a piece of Eze's other work): what it is, beside the planet, and the only way out to it */
      #world-info { position: fixed; right: 2.4rem; top: 50%; transform: translateY(-46%); z-index: 12; width: min(400px, 38vw); opacity: 0; pointer-events: none; transition: opacity .45s, transform .45s; text-shadow: 0 0 18px rgba(8,8,16,.9); }
      #world-info.show { opacity: 1; pointer-events: auto; transform: translateY(-50%); }
      #world-kicker { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
      #world-title { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(2rem, 3.6vw, 3.2rem); line-height: 1; margin: .5rem 0 1rem; }
      #world-desc { font-family: var(--serif); font-weight: 300; font-size: 1.12rem; line-height: 1.45; color: var(--text); }
      #world-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1.1rem 0 1.4rem; }
      #world-tags span { font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; padding: .3rem .5rem; border: 1px solid rgba(240,237,232,.22); }
      #world-visit { display: inline-block; font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: #6ef9f5; text-decoration: none; padding: .6rem .9rem; border: 1px solid rgba(110,249,245,.45); background: rgba(8,8,16,.55); }
      #world-visit:hover { background: rgba(110,249,245,.12); }
      #world-visit[hidden] { display: none; }
      /* knocking at a private galaxy's door */
      .knock { display: flex; flex-direction: column; gap: .45rem; margin-top: .2rem; }
      .knock[hidden], .knock [hidden] { display: none; }
      .knock label { font-size: .6rem; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
      .knock span { display: flex; gap: .4rem; }
      .knock input { flex: 1; min-width: 0; background: rgba(8,8,16,.6); border: 1px solid rgba(240,237,232,.25); color: var(--text); font: inherit; font-size: .72rem; padding: .55rem .6rem; outline: none; }
      .knock input:focus { border-color: rgba(110,249,245,.6); }
      .knock button { font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: #6ef9f5; border: 1px solid rgba(110,249,245,.45); padding: .5rem .8rem; white-space: nowrap; }
      .knock-msg { font-family: var(--serif); font-size: 1.05rem; color: var(--text); min-height: 1em; }
      .knock-msg.bad { color: #ff3f3f; font-family: inherit; font-size: .62rem; letter-spacing: .1em; }
      #locked .knock { width: min(420px, 90vw); text-align: left; }
      @media (max-width: 640px) {
        #world-info { right: 1rem; left: 1rem; width: auto; top: auto; bottom: 4.4rem; transform: translateY(12px); }
        #world-info.show { transform: none; }
        #world-title { font-size: 1.9rem; margin: .3rem 0 .6rem; }
        #world-desc { font-size: .98rem; max-height: 30vh; overflow: auto; }
        #world-tags { margin: .7rem 0 .9rem; }
      }

      /* overlays: hard-edged black sheets instead of the old floating glass cards */
      .sheet { position: fixed; inset: 0; z-index: 100; background: var(--bg); overflow-y: auto; opacity: 0; pointer-events: none; transition: opacity .25s steps(4); padding: 4.5rem 1.4rem 3rem; }
      .sheet.open { opacity: 1; pointer-events: all; }
      .close { position: fixed; top: 1.1rem; right: 1.4rem; z-index: 2; font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); padding: .2rem 0; transition: color .2s; }
      .close:hover { color: var(--text); }
      .sheet h2 { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(3.5rem,13vw,11rem); line-height: .9; letter-spacing: -.02em; margin-bottom: 2.5rem; }
      #about-body { columns: 2 22rem; column-gap: 3rem; max-width: 62rem; }
      #about-body p { font-size: .85rem; line-height: 1.9; color: rgba(240,237,232,0.85); margin-bottom: 1.2rem; break-inside: avoid; }

      #balloon-tag { position: fixed; top: 0; left: 0; z-index: 12; font-size: .64rem; letter-spacing: .16em; text-transform: uppercase; color: #6ef9f5; white-space: nowrap; padding: .5rem .7rem; opacity: 0; pointer-events: none; transition: opacity .3s; text-shadow: 0 0 10px rgba(8,8,16,.9); }
      #balloon-tag.show { opacity: 1; pointer-events: auto; }
      #balloon-tag.hot { color: #fff; }
      #balloon-tag:focus-visible { opacity: 1; pointer-events: auto; transform: translate(1.4rem, 3.6rem) !important; }
      body.no3d #balloon-tag { opacity: 1; pointer-events: auto; z-index: 101; transform: translate(1rem, .6rem); }
      #cockpit { position: fixed; inset: 0 0 auto 0; z-index: 20; padding: clamp(3.8rem,9vh,6rem) 1.4rem 1rem; display: flex; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .5s; background: linear-gradient(rgba(8,8,16,.72) 55%, transparent); }
      #cockpit.open { opacity: 1; pointer-events: auto; }
      #cockpit.flat { z-index: 110; bottom: 0; background: var(--bg); }
      #msg-box { width: min(56rem, 100%); }
      #msg-box .subtitle { font-size: .7rem; color: var(--muted); letter-spacing: .16em; text-transform: uppercase; margin-bottom: 1rem; }
      #msg-input { width: 100%; background: none; border: none; color: var(--text); font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.7rem,4.2vw,3.2rem); line-height: 1.15; padding: .2rem 0; resize: none; outline: none; cursor: none; caret-color: #6ef9f5; }
      #msg-input::placeholder { color: rgba(240,237,232,0.28); }
      #msg-footer { display: flex; justify-content: space-between; align-items: center; margin-top: .8rem; }
      #word-count { font-size: .72rem; color: var(--muted); letter-spacing: .1em; }
      #word-count.full { color: #b8f75b; }
      #word-count.over { color: #ff3f3f; }
      #msg-send { font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; padding: .7rem 1.6rem; border: 1px solid #6ef9f5; color: #6ef9f5; transition: background .15s, color .15s; }
      #msg-send:hover:not(:disabled) { background: #6ef9f5; color: var(--bg); }
      #msg-send:disabled { opacity: .3; }
      #msg-thanks { display: none; }
      #msg-thanks p { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(2.6rem,8vw,6rem); margin-bottom: .6rem; }
      #msg-thanks small { font-size: .72rem; color: var(--muted); letter-spacing: .1em; }
      body.aboard #hud, body.aboard #world-info { opacity: 0; pointer-events: none; }
      body.aboard #hud * { pointer-events: none; }
      #pilot-hud { position: fixed; left: 50%; top: 3.4rem; transform: translateX(-50%); z-index: 12; font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity .5s; text-shadow: 0 0 10px rgba(8,8,16,.9); }
      body.pilot #pilot-hud { opacity: .72; }
      body.aboard #pilot-hud { opacity: 0; }
      #pilot-hud .at-piece, #pilot-hud .choosing, body.focus #pilot-hud .flying, body.selecting #pilot-hud .flying { display: none; }
      body.focus #pilot-hud .at-piece { display: inline; }
      body.selecting:not(.focus) #pilot-hud .choosing { display: inline; }
      body.kb #pilot-hud .pad, body:not(.kb) #pilot-hud .kb { display: none; }
      #pilot-hud .wind { display: block; margin-top: .55rem; text-align: center; color: #6ef9f5; }
      #pilot-hud .gas { display: block; margin-top: .45rem; text-align: center; color: #ffd166; }
      #pilot-hud .gas:empty { display: none; }
      #meet { position: fixed; right: 1.6rem; top: 5.4rem; z-index: 13; width: min(330px, 80vw); padding: 1rem 1.1rem .9rem; background: rgba(8,8,16,.78); border: 1px solid rgba(240,237,232,.16); font-size: .6rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
      #meet[hidden] { display: none; }
      #meet h2 { margin: .25rem 0 .8rem; font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 300; font-size: 2.1rem; letter-spacing: 0; text-transform: none; line-height: 1; }
      .meet-acts { display: flex; gap: .5rem; }
      .meet-acts button { flex: 1; padding: .6rem .4rem; border: 1px solid rgba(240,237,232,.3); color: var(--ink); letter-spacing: .16em; text-transform: uppercase; font-size: .58rem; }
      #meet-trip { border-color: rgba(255,110,180,.5); color: #ff6eb4; }
      #meet-invite { margin-top: .8rem; padding-top: .7rem; border-top: 1px solid rgba(240,237,232,.14); }
      #meet-invite p { margin: 0 0 .6rem; color: #ff6eb4; line-height: 1.6; }
      #pilot-hud .crew { display: block; margin-top: .45rem; text-align: center; color: #ff6eb4; }
      #pilot-hud .crew:empty { display: none; }
      #meet-gas { border-color: rgba(255,209,102,.5); color: #ffd166; }
      .meet-acts button:disabled { opacity: .3; }
      body.touch .kb-only { display: none; }
      #meet-log { list-style: none; margin: .7rem 0 0; padding: 0; max-height: 9.5rem; overflow-y: auto; display: flex; flex-direction: column; gap: .35rem; }
      #meet-log:empty { display: none; }
      #meet-log li { font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; letter-spacing: 0; text-transform: none; color: var(--ink); line-height: 1.25; }
