      basketK += (want - basketK)*(1-Math.exp(-dt*(want ? 2 : 4)));
      basketView.visible = basketK > .01;
      if(!basketView.visible){ nextBlast = 0; blastLight.style.opacity = '0'; return; }
      const k = basketK, e = k*k*(3-2*k);
      for(const m of basketMats) m.opacity = m.userData.base*Math.min(1, k*1.4);
      // arrival: the basket rises from below, the canopy comes down from above
      basketLow.position.y = -(1-e)*.55;
      basketHigh.position.y = (1-e)*.9;
      if(reduced) return;
      // the burner fires on its own every so often
      if(!nextBlast) nextBlast = now + rnd(3500, 6000);
      if(k > .9 && now > nextBlast){ blastAt = now; nextBlast = now + rnd(10000, 16000); burnerBreath(1.4, .35); }
      const b = Math.max(0, Math.min(1, (now-blastAt)/150))*Math.exp(-Math.max(0, now-blastAt-150)/(700*blastPower))*blastPower;
      (burnerGlow.material as THREE.SpriteMaterial).opacity = Math.min(1, .15 + b*.85)*e;
      burnerGlow.scale.setScalar(.36 + Math.min(1, b)*.22 + Math.sin(now*.03)*.02); // small: its light must stay in the canopy, off the piece
      // a tongue of fire rising from the cans, flickering; its lowest point stays above ~6% of the screen
      const fire = Math.min(1, b), flick = 1 + .12*Math.sin(now*.047) + .08*Math.sin(now*.031 + 1);
      for(const [sp, w, h, o] of [[flameJet, .34, .9, .95], [flameCore, .14, .55, 1]] as [THREE.Sprite, number, number, number][]){
        sp.scale.set(w*flick*(.6 + .4*fire), h*flick*fire, 1);
        sp.position.set(0, .8 + sp.scale.y*.42, -1.9); // from the mouths of the cans, roaring up
        (sp.material as THREE.SpriteMaterial).opacity = fire*o*e;
      }
      for(const m of canopyMats) m.color.setRGB(.5 + b*.6, .47 + b*.45, .43 + b*.18); // the fabric lit near white-gold
      for(const m of wickerMats) m.color.setRGB(.82 + b*.4, .78 + b*.22, .74 - b*.05);
      // firelight floods the whole view around the piece (the piece itself is cut out, untouched)
      const wash = Math.min(1, Math.max(0, b - .15)*.8)*e;
      blastLight.style.opacity = String(wash);
      if(wash > .01 && focused >= 0) frameOf(pieces[focused], blastLight, 0);
