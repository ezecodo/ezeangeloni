        p.opacity += (opacityT-p.opacity)*ease;
        p.grow += ((isHov && !home ? (pilot?.selecting ? 1.35 : 2.1) : 1)-p.grow)*ease;
        // far away it is a star; close up, or under the cursor, the star opens into the original piece
        const starT = home || isOn || isHov ? 0 : 1-Math.min(1, Math.max(0, (near-.1)/.62));
        p.starMix += (starT-p.starMix)*ease;
