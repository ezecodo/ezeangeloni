      const wide = camera.aspect >= 1.05;
      const at = wide ? new THREE.Vector3(p.w/2*ratio + 1.2, .4, -D) : new THREE.Vector3(.5, -(p.h/2*ratio + 1.7), -D);
      at.x += Math.sin(now*.0011)*.16;
      at.y += Math.sin(now*.0016)*.24;
      const from = focused >= 0 ? new THREE.Vector3(0, 0, -D) : s.group.position.clone();
      const q = upright(now*.0002);
      s.group.position.lerpVectors(from, at, e);
      if(focused >= 0) s.group.quaternion.copy(q); else s.group.quaternion.slerp(q, e);
