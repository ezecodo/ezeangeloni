    }
    // Its own route, in view space: incommensurate waves, so it never repeats and always stays in frame.
    function route(tau: number){
      const depth = 94 + 16*Math.sin(tau*.067+2);
      const hh = depth*Math.tan(camera.fov*Math.PI/360), hw = hh*camera.aspect;
      const x = (Math.sin(tau*.113) + .4*Math.sin(tau*.047+1))/1.4;
      const y = (Math.sin(tau*.081+1) + .4*Math.sin(tau*.037))/1.4;
      return new THREE.Vector3(x*hw*.8, y*hh*.66, -depth);
    }
    function placeShip(){
      if(!ship) return;
      const p = route(ship.tau), t = route(ship.tau+.2).sub(p).normalize();
      ship.group.position.copy(p);
      if(ship.kind === 'balloon'){
        // a balloon doesn't point where it goes: it stays upright, turns slowly, leans a little into the wind
        ship.group.position.y += Math.sin(ship.tau*1.3)*.5;
        ship.group.quaternion.copy(upright(ship.tau*.2, -t.x*.1));
        ship.dir.copy(t);
        return;
      }
      ship.up.addScaledVector(t, -ship.up.dot(t)).normalize(); // carried along, so it never flips at a vertical turn
      ship.group.quaternion.setFromRotationMatrix(new THREE.Matrix4().lookAt(p.clone().add(t), p, ship.up));
      ship.dir.copy(t);
    }
    function upright(yaw: number, lean = 0){
      return new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,0,1), lean).multiply(new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(0,1,0), yaw));
    }
    // While a piece is open the ship slides out from behind it and waits, nose towards open space.
    function peekOut(s: Ship, e: number, now: number){
      const p = pieces[s.peekFrom];
      const dist = camera.position.distanceTo(p.mesh.position), D = dist+5, ratio = D/dist;
      const wide = camera.aspect >= 1.05;
      const at = wide ? new THREE.Vector3(p.w/2*ratio + 1.2, .4, -D) : new THREE.Vector3(.5, -(p.h/2*ratio + 1.7), -D);
      at.x += Math.sin(now*.0011)*.16;
      at.y += Math.sin(now*.0016)*.24;
      const from = focused >= 0 ? new THREE.Vector3(0, 0, -D) : s.group.position.clone();
      const nose = new THREE.Vector3(.84, wide ? .5 : .3, -.25).normalize();
      const q = s.kind === 'balloon' ? upright(now*.0002)
        : new THREE.Quaternion().setFromRotationMatrix(new THREE.Matrix4().lookAt(at.clone().add(nose), at, new THREE.Vector3(0,1,0)));
      s.group.position.lerpVectors(from, at, e);
