---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Eze Angeloni — Cronovisor">
  <Fragment slot="head">
    <meta name="description" content="Cronovisor: pasado observado. Fotos, frases y sets de Eze Angeloni, en sistema propio." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital@0;1&family=Cormorant+Garamond:ital,wght@0,300;1,300;1,400&display=swap" rel="stylesheet" />
    <style is:global>
      @font-face {
        font-family: 'MalvinasSans';
        src: url('/fonts/MalvinasSans-Regular.otf?v=20') format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --bg: #080810; --text: #f0ede8; --muted: rgba(240,237,232,0.5);
        --ink: #fff; --mono: 'DM Mono', monospace; --serif: 'Cormorant Garamond', serif;
        --dial: 10px;
      }
      html, body { width: 100%; height: 100%; overflow: hidden; background: var(--bg); color: var(--text); font-family: var(--mono); cursor: none; overscroll-behavior: none; }
      button { font: inherit; color: inherit; background: none; border: none; cursor: none; }
      a { color: inherit; cursor: none; }
      :focus-visible { outline: 1px solid var(--text); outline-offset: 3px; }
      #screen { position: fixed; inset: 0; width: 100%; height: 100%; touch-action: none; }
      #cursor { position: fixed; width: 5px; height: 5px; background: var(--ink); border-radius: 50%; pointer-events: none; z-index: 9999; transform: translate(-50%,-50%); }
      #cursor::before, #cursor::after { content:''; position:absolute; border-radius:50%; border:1px solid var(--ink); top:50%; left:50%; transform:translate(-50%,-50%); animation: sonar 2.4s ease-out infinite; }
      #cursor::after { animation-delay:1.2s; }
      @keyframes sonar { 0% { width:5px; height:5px; opacity:.8; } 100% { width:70px; height:70px; opacity:0; } }

      /* instrument panel */
      #hud { position: fixed; inset: 0; pointer-events: none; z-index: 10; color: var(--ink); font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; }
      #hud button, #hud a { pointer-events: auto; letter-spacing: inherit; text-transform: inherit; text-decoration: none; }
      #top { position: absolute; top: 0; left: 0; right: 0; padding: 1.1rem 1.4rem; display: flex; justify-content: space-between; gap: 1rem; }
      #brand { font-size: inherit; font-weight: 400; padding: .2rem 0; }
      #nav { display: flex; gap: 1.4rem; }
      #nav button { text-transform: inherit; padding: .2rem 0; opacity: .72; transition: opacity .2s; }
      #nav button:hover, #nav button.on { opacity: 1; }
      #nav button.on::before { content: '● '; }
      #nav button[hidden] { display: none; }
      #meta { position: absolute; left: 1.4rem; right: 1.4rem; bottom: calc(var(--dial) + .7rem); display: flex; align-items: baseline; gap: 1.2rem; }
      #meta-id { white-space: nowrap; }
      #meta-cap { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.2rem,2.6vw,2rem); letter-spacing: 0; text-transform: none; line-height: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-bottom: .1em; }
      #lamp { width: 7px; height: 7px; border-radius: 50%; background: currentColor; align-self: center; flex-shrink: 0; opacity: .2; transition: opacity .25s; }
      #lamp.on { opacity: 1; }
      #hint { margin-left: auto; white-space: nowrap; opacity: .72; animation: blink 2s steps(2) infinite; }
      #hint[hidden] { display: none; }
      @keyframes blink { 50% { opacity: .25; } }
      #act { position: absolute; right: 1.4rem; bottom: calc(var(--dial) + 3.6rem); width: 112px; height: 112px; border-radius: 50%; background: var(--ink); color: #080810; font-size: .68rem; transition: transform .2s; }
      #act:hover { transform: scale(1.06); }
      #act[hidden] { display: none; }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

      #trapo-fab { position: fixed; top: 0; left: 0; z-index: 12; font-family: 'MalvinasSans', sans-serif; font-size: 1.6rem; letter-spacing: .01em; color: var(--ink); text-decoration: none; white-space: nowrap; text-shadow: 0 0 14px rgba(8,8,16,.55); transition: opacity .4s; }
      body.focus #trapo-fab { opacity: 0; pointer-events: none; }

      /* overlays: hard-edged black sheets instead of the old floating glass cards */
      .sheet { position: fixed; inset: 0; z-index: 100; background: var(--bg); overflow-y: auto; opacity: 0; pointer-events: none; transition: opacity .25s steps(4); padding: 4.5rem 1.4rem 3rem; }
      .sheet.open { opacity: 1; pointer-events: all; }
      .close { position: fixed; top: 1.1rem; right: 1.4rem; z-index: 2; font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); padding: .2rem 0; transition: color .2s; }
      .close:hover { color: var(--text); }
      .sheet h2 { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(3.5rem,13vw,11rem); line-height: .9; letter-spacing: -.02em; margin-bottom: 2.5rem; }
      #about-body { columns: 2 22rem; column-gap: 3rem; max-width: 62rem; }
      #about-body p { font-size: .85rem; line-height: 1.9; color: rgba(240,237,232,0.85); margin-bottom: 1.2rem; break-inside: avoid; }

      #ship-tag { position: fixed; top: 0; left: 0; z-index: 12; font-size: .64rem; letter-spacing: .16em; text-transform: uppercase; color: #6ef9f5; white-space: nowrap; padding: .5rem .7rem; opacity: 0; pointer-events: none; transition: opacity .3s; text-shadow: 0 0 10px rgba(8,8,16,.9); }
      #ship-tag.show { opacity: 1; pointer-events: auto; }
      #ship-tag.hot { color: #fff; }
      #ship-tag:focus-visible { opacity: 1; pointer-events: auto; transform: translate(1.4rem, 3.6rem) !important; }
      body.no3d #ship-tag { opacity: 1; pointer-events: auto; z-index: 101; transform: translate(1rem, .6rem); }
      #cockpit { position: fixed; inset: 0 0 auto 0; z-index: 20; padding: clamp(3.8rem,9vh,6rem) 1.4rem 1rem; display: flex; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .5s; background: linear-gradient(rgba(8,8,16,.72) 55%, transparent); }
      #cockpit.open { opacity: 1; pointer-events: auto; }
      #cockpit.flat { z-index: 110; bottom: 0; background: var(--bg); }
      #msg-box { width: min(56rem, 100%); }
      #msg-box .subtitle { font-size: .7rem; color: var(--muted); letter-spacing: .16em; text-transform: uppercase; margin-bottom: 1rem; }
      #msg-input { width: 100%; background: none; border: none; color: var(--text); font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(1.7rem,4.2vw,3.2rem); line-height: 1.15; padding: .2rem 0; resize: none; outline: none; cursor: none; caret-color: #6ef9f5; }
      #msg-input::placeholder { color: rgba(240,237,232,0.28); }
      #msg-footer { display: flex; justify-content: space-between; align-items: center; margin-top: .8rem; }
      #word-count { font-size: .72rem; color: var(--muted); letter-spacing: .1em; }
      #word-count.full { color: #b8f75b; }
      #word-count.over { color: #ff3f3f; }
      #msg-send { font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; padding: .7rem 1.6rem; border: 1px solid #6ef9f5; color: #6ef9f5; transition: background .15s, color .15s; }
      #msg-send:hover:not(:disabled) { background: #6ef9f5; color: var(--bg); }
      #msg-send:disabled { opacity: .3; }
      #msg-thanks { display: none; }
      #msg-thanks p { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(2.6rem,8vw,6rem); margin-bottom: .6rem; }
      #msg-thanks small { font-size: .72rem; color: var(--muted); letter-spacing: .1em; }
      body.aboard #hud, body.aboard #trapo-fab { opacity: 0; pointer-events: none; }
      body.aboard #hud * { pointer-events: none; }

      #index-grid { columns: 5 200px; column-gap: 10px; }
      .cell { display: block; width: 100%; margin-bottom: 10px; break-inside: avoid; text-align: left; position: relative; transition: opacity .15s; }
      .cell img { display: block; width: 100%; height: auto; background: rgba(240,237,232,0.05); }
      .cell-text { display: block; padding: .9rem .8rem 1.1rem; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.3rem; line-height: 1.15; color: var(--bg); overflow-wrap: anywhere; }
      .cell-id { display: block; padding: .35rem 0 0; font-size: .6rem; letter-spacing: .12em; color: var(--muted); }
      #index-grid:hover .cell { opacity: .45; }
      #index-grid .cell:hover, #index-grid .cell:focus-visible { opacity: 1; }

      #set-sheet { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #2a0d24, #080810 45%, #1b0f33); }
      #set-box { width: min(760px, 100%); margin: auto; }
      #set-artwork { width: 148px; aspect-ratio: 1; margin-bottom: 1.6rem; display: none; overflow: hidden; }
      #set-artwork img { width: 100%; height: 100%; object-fit: cover; display: block; }
      #set-artwork.show { display: block; }
      #set-title { font-family: var(--serif); font-size: clamp(2.6rem,9vw,6.5rem); font-weight: 300; font-style: italic; line-height: .95; letter-spacing: -.01em; }
      #set-date { font-size: .72rem; color: var(--muted); letter-spacing: .2em; text-transform: uppercase; margin-top: 1rem; }
      #set-player { margin-top: 2.6rem; display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
      #set-play { width: 64px; height: 64px; border-radius: 50%; border: 1px solid var(--text); display: flex; align-items: center; justify-content: center; transition: background .15s; padding: 0; flex-shrink: 0; }
      #set-play:hover { background: rgba(240,237,232,0.12); }
      #set-play:active { transform: scale(.96); }
      #set-play svg { width: 22px; height: 22px; fill: var(--text); }
      #set-progress-row { flex: 1; min-width: 220px; display: flex; align-items: center; gap: .8rem; }
      #set-time-current, #set-time-total { font-size: .7rem; color: var(--muted); letter-spacing: .08em; min-width: 42px; }
      #set-time-total { text-align: right; }
      #set-seek { flex: 1; position: relative; height: 22px; display: flex; align-items: center; touch-action: none; }
      #set-seek-track { position: absolute; left: 0; right: 0; height: 2px; background: rgba(240,237,232,0.12); overflow: hidden; }
      #set-seek-buffer { position: absolute; left: 0; top: 0; bottom: 0; background: rgba(240,237,232,0.18); transition: width .2s ease; }
      #set-seek-fill { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(90deg, #ff6eb4, #c77dff); }
      #set-seek-thumb { position: absolute; top: 50%; transform: translate(-50%, -50%); width: 11px; height: 11px; border-radius: 50%; background: var(--text); opacity: 0; transition: opacity .2s; pointer-events: none; }
      #set-seek:hover #set-seek-thumb, #set-seek.dragging #set-seek-thumb { opacity: 1; }
      #set-copy { color: var(--muted); font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; padding: .4rem 0; transition: color .2s; }
      #set-copy:hover { color: var(--text); }
      #set-copy.copied { color: #b8f75b; }
      #set-tracklist { margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid rgba(240,237,232,0.12); display: none; max-height: 240px; overflow-y: auto; }
      #set-tracklist.show { display: block; }
      .tl-row { display: flex; gap: .9rem; padding: .5rem .2rem; transition: background .2s; }
      .tl-row:hover { background: rgba(240,237,232,0.05); }
      .tl-row.active { background: linear-gradient(90deg, rgba(255,110,180,0.12), transparent); }
      .tl-time { font-size: .68rem; color: var(--muted); letter-spacing: .05em; min-width: 56px; flex-shrink: 0; padding-top: .15rem; }
      .tl-row.active .tl-time { color: #ff6eb4; }
      .tl-label { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: 1.1rem; line-height: 1.3; color: rgba(240,237,232,0.75); }
      .tl-row.active .tl-label { color: var(--text); }

      @media (max-width: 768px) {
        #top { padding: .9rem 1rem; }
        #nav { gap: .8rem; white-space: nowrap; }
        body.focus #brand { display: none; }
        body.focus #top { justify-content: flex-end; }
        #meta { left: 1rem; right: 1rem; gap: .7rem; }
        #hud { font-size: .6rem; letter-spacing: .1em; }
        #trapo-fab { font-size: 1.2rem; }
        .sheet { padding: 3.6rem 1rem 2rem; }
        .close { right: 1rem; top: .9rem; }
        #set-seek-thumb { opacity: 1; width: 13px; height: 13px; }
        #index-grid { columns: 2; }
      }
      @media (hover: none), (max-width: 768px) {
        html, body, button, a, #msg-input { cursor: auto; }
        #cursor { display: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        #cursor::before, #cursor::after, #hint { animation: none; }
      }
    </style>
  </Fragment>

  <div id="cursor"></div>
  <canvas id="screen" aria-hidden="true"></canvas>

  <div id="hud">
    <header id="top">
      <h1 id="brand"><button id="home">Cronovisor</button></h1>
      <nav id="nav" aria-label="main">
        <button id="btn-back" hidden>← all</button>
        <button id="btn-scan" aria-pressed="false">scan</button>
        <button id="btn-index">index</button>
        <button id="btn-about">about</button>
        <button id="btn-sound" aria-pressed="true">sound</button>
      </nav>
    </header>
    <button id="act" hidden>play set</button>
    <div id="meta">
      <span id="lamp"></span>
      <span id="meta-id"></span>
      <span id="meta-cap"></span>
      <span id="hint">drag to orbit · click a signal</span>
    </div>
  </div>
  <p id="now" class="sr" aria-live="polite"></p>
  <a id="trapo-fab" href="https://trapos.xyz" target="_blank" rel="noopener">Fábrica de trapos</a>

  <div id="index-sheet" class="sheet">
    <button class="close" id="index-close">close ✕</button>
    <h2>Pasado observado</h2>
    <div id="index-grid"></div>
  </div>

  <button id="ship-tag">leave a word</button>
  <div id="cockpit">
    <button class="close" id="msg-close">leave ship ✕</button>
    <div id="msg-box">
      <div id="msg-form">
        <p class="subtitle" id="msg-subtitle">this ship carries exactly 11 words. make them count.</p>
        <textarea id="msg-input" rows="3" placeholder="eleven words, no more, no less..."></textarea>
        <div id="msg-footer">
          <span id="word-count">0 / 11</span>
          <button id="msg-send" disabled>launch</button>
        </div>
      </div>
      <div id="msg-thanks">
        <p>thank you ✦</p>
        <small>your words are now part of this space</small>
      </div>
    </div>
  </div>

  <div id="set-sheet" class="sheet">
    <button class="close" id="set-close">close ✕</button>
    <div id="set-box">
      <div id="set-artwork"><img id="set-artwork-img" alt=""></div>
      <h2 id="set-title"></h2>
      <p id="set-date"></p>
      <div id="set-player">
        <button id="set-play" aria-label="play">
          <svg id="set-play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <div id="set-progress-row">
          <span id="set-time-current">0:00</span>
          <div id="set-seek">
            <div id="set-seek-track">
              <div id="set-seek-buffer"></div>
              <div id="set-seek-fill"></div>
            </div>
            <div id="set-seek-thumb"></div>
          </div>
          <span id="set-time-total">--:--</span>
        </div>
        <button id="set-copy">copy link</button>
      </div>
      <div id="set-tracklist"></div>
      <audio id="set-audio" preload="metadata"></audio>
    </div>
  </div>

  <div id="about-sheet" class="sheet">
    <button class="close" id="about-close">close ✕</button>
    <h2>About</h2>
    <div id="about-body">
      <p>Hey, I'm Eze. I build things for the web — from the database to the pixel.</p>
      <p>Originally from Argentina, now based in Barcelona, I've spent years at the intersection of technology and culture. I've helped organize theatre festivals, been part of interdisciplinary collectives, and worked on projects that use culture as a bridge between societies. That background shapes how I approach every line of code — with purpose, context, and people in mind.</p>
      <p>On the technical side, I'm a full-stack developer working with Next.js, React, and Node — building editorial platforms, CMS systems, and interactive experiences.</p>
      <p>Currently available for freelance work. If you've got something interesting brewing, I'd love to hear about it.</p>
    </div>
  </div>

  <script>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
    import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
    import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
    import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';

    const COLORS = ['#ff3f3f','#ff9f1c','#6ef9f5','#b8f75b','#c77dff','#ff6eb4','#38bdf8','#ffd166'];
    const NOTES =  [392, 440, 523, 587, 659, 349, 466, 311];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouch = window.matchMedia('(hover: none)').matches;
    const $ = (id: string) => document.getElementById(id)!;
    function rnd(a: number, b: number){ return a + Math.random()*(b-a); }
    function hexRgb(h: string){ return [1,3,5].map(i => parseInt(h.slice(i,i+2),16)/255); }

    // ── Sound ─────────────────────────────────────────────
    let audioCtx: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let staticGain: GainNode | null = null;
    let staticFilter: BiquadFilterNode | null = null;
    let soundOn = localStorage.getItem('sound') !== 'off';
    function ensureAudio(){
      if(audioCtx){ if(audioCtx.state === 'suspended') audioCtx.resume(); return; }
      audioCtx = new AudioContext();
      masterGain = audioCtx.createGain();
      masterGain.gain.value = soundOn ? 0.18 : 0;
      masterGain.connect(audioCtx.destination);
      const noise = audioCtx.createBuffer(1, audioCtx.sampleRate*2, audioCtx.sampleRate);
      const data = noise.getChannelData(0);
      for(let i = 0; i < data.length; i++) data[i] = Math.random()*2 - 1;
      const src = audioCtx.createBufferSource();
      src.buffer = noise; src.loop = true;
      staticFilter = audioCtx.createBiquadFilter();
      staticFilter.type = 'bandpass'; staticFilter.Q.value = 0.8;
      staticGain = audioCtx.createGain();
      staticGain.gain.value = 0;
      src.connect(staticFilter); staticFilter.connect(staticGain); staticGain.connect(masterGain);
      src.start();
    }
    function playNote(freq: number){
      if(!audioCtx || !masterGain) return;
      const t = audioCtx.currentTime;
      function layer(f: number, type: OscillatorType, vol: number, dur: number, pitchDrop = 1){
        const osc = audioCtx!.createOscillator();
        const g = audioCtx!.createGain();
        osc.connect(g); g.connect(masterGain!);
        osc.type = type;
        osc.frequency.setValueAtTime(f, t);
        if(pitchDrop !== 1) osc.frequency.exponentialRampToValueAtTime(f * pitchDrop, t + dur * 0.6);
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + dur);
        osc.start(t); osc.stop(t + dur);
      }
      layer(freq,     'sine',     1.0,  0.35, 0.75); // main — suave con pitch drop
      layer(freq/2,   'triangle', 0.5,  0.18);        // bass — cuerpo, corto
      layer(freq*2,   'sine',     0.15, 0.2);         // shimmer — brillo suave
    }
    let songPlaying = false;
    // Note frequencies
    const G4=392, A4=440, B4=493.88, C5=523.25, D5=587.33, E4=329.63, D4=293.66, C4=261.63;
    // [freq, duration_seconds] — 0 = rest
    const REDEMPTION: [number,number][] = [
      // "Old pi-rates, yes, they rob I"
      [G4,.4],[B4,.4],[A4,.3],[G4,.3],[E4,.4],[D4,.3],[E4,.3],[G4,.7],
      // "Sold I to the mer-chant ships"
      [G4,.4],[B4,.4],[A4,.3],[G4,.3],[E4,.4],[D4,.3],[C4,.3],[D4,.7],
      // "Mi-nutes af-ter they took I"
      [E4,.4],[D4,.3],[E4,.3],[G4,.4],[E4,.3],[D4,.7],
      // "From the bot-tom-less pit"
      [G4,.4],[B4,.4],[A4,.3],[G4,.3],[E4,.8],
      [0,.5],
      // "Won't you help to sing"
      [G4,.4],[G4,.25],[A4,.25],[B4,.4],[A4,.3],[G4,.7],
      // "These songs of free-dom"
      [G4,.4],[A4,.3],[B4,.4],[A4,.3],[G4,.3],[E4,.7],
      // "'Cause all I ev-er had"
      [G4,.4],[G4,.25],[A4,.25],[B4,.4],[A4,.3],[G4,.3],[E4,.3],[D4,.5],
      // "Re-demp-tion songs"
      [G4,.4],[B4,.4],[D5,.4],[C5,.3],[B4,.9],
      [0,.3],
      // "Re-demp-tion songs" (repeat, hold)
      [G4,.4],[B4,.4],[D5,.4],[C5,.3],[B4,1.4],
    ];
    async function playSong(){
      if(songPlaying || !audioCtx || !masterGain) return;
      songPlaying = true;
      for(const [freq, dur] of REDEMPTION){
        if(!songPlaying) break;
        if(freq > 0){
          const osc = audioCtx.createOscillator();
          const g = audioCtx.createGain();
          osc.connect(g); g.connect(masterGain);
          osc.type = 'triangle';
          osc.frequency.value = freq;
          g.gain.setValueAtTime(0.9, audioCtx.currentTime);
          g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur * 0.85);
          osc.start(); osc.stop(audioCtx.currentTime + dur);
        }
        await new Promise(r => setTimeout(r, dur * 1000));
      }
      songPlaying = false;
    }
    const btnSound = $('btn-sound');
    function syncSound(){
      btnSound.classList.toggle('on', soundOn);
      btnSound.setAttribute('aria-pressed', String(soundOn));
      if(masterGain) masterGain.gain.value = soundOn ? 0.18 : 0;
      if(!soundOn) songPlaying = false;
    }
    function toggleSound(){
      soundOn = !soundOn;
      try { localStorage.setItem('sound', soundOn ? 'on' : 'off'); } catch {}
      syncSound();
    }
    btnSound.addEventListener('click', toggleSound);
    syncSound();
    window.addEventListener('pointerdown', ensureAudio);
    window.addEventListener('keydown', ensureAudio);

    // ── Stations ──────────────────────────────────────────
    interface TrackPoint { at: number; label: string; }
    interface SetMeta { slug: string; title: string; date: string; audio: string; artwork?: string; tracklist?: TrackPoint[]; duration?: number; bpm?: number; musicalKey?: string; }
    interface Station {
      kind: 'home' | 'photo' | 'text' | 'set';
      n: number;            // archive number, oldest = 1
      date: string;
      text: string;         // frase, caption or set title
      src?: string;
      set?: SetMeta;
      tint: string;
      flood: boolean;       // full-colour plate instead of type on the void
    }
    let stations: Station[] = [{ kind:'home', n:0, date:'', text:'', tint:'#c77dff', flood:false }];
    let total = 0;

    function buildStations(frases: {texto?: string, imagen?: string, caption?: string, fecha?: string}[], sets: SetMeta[]){
      const merged = [
        ...frases.filter(f => f.imagen || f.texto).map(f => ({ date: f.fecha || '', f, s: null as SetMeta | null })),
        ...sets.map(s => ({ date: s.date || '', f: null, s })),
      ].sort((a,b) => a.date.localeCompare(b.date));
      const out: Station[] = merged.map((m, i) => {
        const n = i + 1, tint = COLORS[n % COLORS.length];
        if(m.s) return { kind:'set', n, date:m.date, text:m.s.title, src:m.s.artwork, set:m.s, tint:'#ff6eb4', flood:!m.s.artwork };
        if(m.f!.imagen) return { kind:'photo', n, date:m.date, text:m.f!.caption || '', src:m.f!.imagen, tint, flood:false };
        return { kind:'text', n, date:m.date, text:m.f!.texto!, tint, flood: n % 3 === 0 };
      });
      total = out.length;
      stations = [stations[0], ...out.reverse()]; // newest at the centre: distance is time
    }

    // ── Cards ─────────────────────────────────────────────
    // Sets a frase as big as the plate allows, so one word hits harder than a paragraph.
    function fitText(c: CanvasRenderingContext2D, text: string, boxW: number, boxH: number){
      const font = (s: number) => `italic 300 ${s}px 'Cormorant Garamond', serif`;
      const wrap = (s: number) => {
        c.font = font(s);
        const lines: string[] = [];
        let line = '';
        for(const w of text.trim().split(/\s+/)){
          if(c.measureText(w).width > boxW) return null;
          const next = line ? line + ' ' + w : w;
          if(c.measureText(next).width > boxW){ lines.push(line); line = w; } else line = next;
        }
        lines.push(line);
        return lines.length * s * .98 <= boxH ? lines : null;
      };
      let lo = 10, hi = Math.floor(boxH), best = wrap(lo) || [text];
      while(hi - lo > 1){
        const mid = (lo + hi) >> 1;
        const r = wrap(mid);
        if(r){ lo = mid; best = r; } else hi = mid;
      }
      c.font = font(lo);
      return { lines: best, size: lo };
    }
    let logo: HTMLImageElement | null = null;
    function renderCard(st: Station, S: number){
      const cv = document.createElement('canvas');
      cv.width = cv.height = S;
      const c = cv.getContext('2d')!;
      if(st.kind === 'home'){
        const h = S*.68, w = h*1447.5/1821.75;
        if(logo?.complete && logo.naturalWidth){
          const lc = document.createElement('canvas');
          lc.width = Math.round(w); lc.height = Math.round(h);
          const l = lc.getContext('2d')!;
          l.drawImage(logo, 0, 0, lc.width, lc.height);
          l.globalCompositeOperation = 'source-in';
          l.fillStyle = '#f0ede8'; l.fillRect(0, 0, lc.width, lc.height);
          c.drawImage(lc, (S-w)/2, S*.02, w, h);
        }
        c.textAlign = 'center'; c.textBaseline = 'middle'; c.fillStyle = '#f0ede8';
        c.font = `300 ${S*.085}px 'Cormorant Garamond', serif`;
        c.fillText('A N G E L O N I', S/2, S*.8);
        c.font = `${S*.021}px 'DM Mono', monospace`;
        c.globalAlpha = .6;
        c.fillText('D E V E L O P E R  ·  B U I L D E R  ·  E X P L O R E R', S/2, S*.88);
        return cv;
      }
      if(!st.flood && st.kind === 'text' && S > 512){ c.fillStyle = 'rgba(8,8,16,.72)'; c.fillRect(0, 0, S, S); }
      if(st.kind === 'set'){
        const g = c.createLinearGradient(0, 0, S, S);
        g.addColorStop(0, '#ff6eb4'); g.addColorStop(1, '#c77dff');
        c.fillStyle = g; c.fillRect(0, 0, S, S);
      } else if(st.flood){
        c.fillStyle = st.tint; c.fillRect(0, 0, S, S);
      }
      const px = S*.08, box = S-px*2;
      const { lines, size } = fitText(c, st.text, box, box);
      c.fillStyle = st.flood ? '#080810' : '#f0ede8';
      c.textBaseline = 'alphabetic'; c.textAlign = 'left';
      const lh = size*.98;
      const y0 = px + (box - lines.length*lh)/2 + lh*.78;
      lines.forEach((l, i) => c.fillText(l, px, y0 + i*lh));
      return cv;
    }

    // ── Space ─────────────────────────────────────────────
    interface Piece {
      star?: THREE.Mesh; starMat?: THREE.ShaderMaterial; stage?: string; beat: number; bright: number; starMix: number;
      st: Station; i: number; mesh: THREE.Mesh; mat: THREE.ShaderMaterial;
      w: number; h: number; lo?: THREE.Texture; hi?: THREE.Texture; hiBusy?: boolean;
      opacity: number; reveal: number; grow: number; halo?: THREE.Mesh;
    }
    const screen = $('screen') as HTMLCanvasElement;
    let renderer: THREE.WebGLRenderer | null = null;
    try { renderer = new THREE.WebGLRenderer({ canvas:screen, antialias:true, powerPreference:'high-performance' }); }
    catch { renderer = null; }
    const DPR = Math.min(window.devicePixelRatio || 1, 1.75);
    THREE.ColorManagement.enabled = false;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, window.innerWidth/window.innerHeight, .1, 900);
    const controls = renderer ? new OrbitControls(camera, screen) : null;
    const plane = new THREE.PlaneGeometry(1, 1);
    const CENTER = new THREE.Vector3();
    let overviewR = 112;
    const blank = new THREE.Texture();

    // far pieces are halftone signals in their tint; approaching resolves them to the untouched original
    const VERT = `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix*modelViewMatrix*vec4(position,1.); }`;
    const FRAG = `precision highp float;
      varying vec2 vUv;
      uniform sampler2D uMap;
      uniform vec3 uTint;
      uniform float uHas, uReveal, uOpacity, uCell, uGain;
      void main(){
        vec4 s = uHas > .5 ? texture2D(uMap, vUv) : vec4(uTint*.3, 1.);
        if(s.a < .01) discard;
        vec2 g = mat2(.966,-.259,.259,.966)*gl_FragCoord.xy/uCell;
        float l = clamp(dot(s.rgb, vec3(.299,.587,.114))*.8, 0., 1.);
        float dots = smoothstep(.09,-.09,length(fract(g)-.5)-.68*sqrt(l));
        gl_FragColor = vec4(mix(uTint*dots, s.rgb, uReveal)*uGain, s.a*uOpacity);
      }`;

    // ── Stellar life ──────────────────────────────────────
    // Age comes from the piece's date on every visit, so the universe grows old by itself.
    // Log time: a piece changes fast at first and slowly after, like attention does.
    const DAY = 864e5;
    const NOW = Date.now() + (parseFloat(new URLSearchParams(location.search).get('days') || '0') || 0)*DAY; // ?days=365 previews the future
    const SPAN: Record<string, number> = { set:200, photo:365, text:520 }; // the massive live fast, as in real stars
    const MASS: Record<string, number> = { set:1.5, photo:1, text:.75 };
    const STAGES = [
      { at:0,   name:'protostar',     color:'#ff9a6b', size:6.5, bright:.8,  beat:1.5, core:.1,  cloud:1, spike:0, ring:0 },
      { at:.25, name:'young star',    color:'#a9d6ff', size:7,   bright:2,   beat:.5,  core:.16, cloud:0, spike:1, ring:0 },
      { at:.55, name:'main sequence', color:'#ffe7ac', size:5.4, bright:1.25,beat:.14, core:.14, cloud:0, spike:0, ring:0 },
      { at:.9,  name:'red giant',     color:'#ff5a3c', size:10,  bright:.85, beat:.06, core:.3,  cloud:0, spike:0, ring:0 },
      { at:.97, name:'white dwarf',   color:'#dfe9ff', size:3,   bright:.9,  beat:0,   core:.05, cloud:0, spike:0, ring:1 },
    ];
    function stellar(st: Station){
      const age = st.date ? Math.max(0, (NOW-Date.parse(st.date))/DAY) : 1e5;
      const span = SPAN[st.kind] || 365;
      const life = Math.min(1, Math.log1p(age)/Math.log1p(span));
      const mix = (a: number, b: number, t: number) => a + (b-a)*t;
      let i = STAGES.length-1;
      while(i > 0 && STAGES[i].at > life) i--;
      const A = STAGES[i], B = STAGES[Math.min(i+1, STAGES.length-1)];
      const t = B === A ? 0 : Math.min(1, (life-A.at)/(B.at-A.at));
      const ca = hexRgb(A.color), cb = hexRgb(B.color);
      const s = {
        name:A.name, life, color:[0,1,2].map(k => mix(ca[k], cb[k], t)),
        size:mix(A.size, B.size, t)*(MASS[st.kind] || 1), bright:mix(A.bright, B.bright, t), beat:mix(A.beat, B.beat, t),
        core:mix(A.core, B.core, t), cloud:mix(A.cloud, B.cloud, t), spike:mix(A.spike, B.spike, t), ring:mix(A.ring, B.ring, t),
      };
      if(st.kind === 'set' && life >= 1){ // heavy stars don't fade: they go supernova and leave a nebula
        Object.assign(s, { name:'supernova remnant', color:hexRgb('#ff6eb4'), size:17, bright:1, beat:.04, core:.03, cloud:.55, spike:0, ring:1 });
      }
      return s;
    }
    const STAR_VERT = `varying vec2 vUv; void main(){ vUv = uv; gl_Position = projectionMatrix*modelViewMatrix*vec4(position,1.); }`;
    const STAR_FRAG = `precision highp float;
      varying vec2 vUv;
      uniform vec3 uColor, uTint;
      uniform float uTime, uBright, uCore, uCloud, uSpike, uRing, uOpacity, uSeed;
      void main(){
        vec2 p = (vUv-.5)*2.;
        float d = length(p), a = atan(p.y, p.x);
        float rough = .5+.5*sin(a*3.+uSeed+uTime*.3)*sin(a*5.-uTime*.2+d*7.);
        vec3 col = uColor*(smoothstep(uCore, uCore*.45, d)*1.6 + pow(max(0.,1.-d),3.)*.6)*(1.-uCloud*.5);
        col += vec3(1.)*smoothstep(uCore*.55, 0., d)*.7;
        col += uColor*uSpike*1.2*(exp(-abs(p.y)*60.)*pow(max(0.,1.-abs(p.x)),4.) + exp(-abs(p.x)*60.)*pow(max(0.,1.-abs(p.y)),4.));
        col += uTint*uCloud*.7*pow(max(0.,1.-d),1.6)*(.45+.55*rough);
        col += uTint*uRing*.6*exp(-pow((d-.62)/.07,2.))*(.6+.4*rough);
        col *= uBright*smoothstep(1.,.86,d)*uOpacity;
        gl_FragColor = vec4(col, 1.);
      }`;
    function buildStar(p: Piece){
      const s = stellar(p.st);
      p.stage = s.name;
      p.beat = s.beat;
      p.bright = s.bright;
      p.starMat = new THREE.ShaderMaterial({
        vertexShader:STAR_VERT, fragmentShader:STAR_FRAG, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending,
        uniforms:{
          uColor:{value:new THREE.Vector3(...s.color)}, uTint:{value:new THREE.Vector3(...hexRgb(p.st.tint))},
          uTime:{value:0}, uBright:{value:s.bright}, uCore:{value:s.core}, uCloud:{value:s.cloud}, uSpike:{value:s.spike}, uRing:{value:s.ring},
          uOpacity:{value:0}, uSeed:{value:p.st.n*1.7},
        },
      });
      p.star = new THREE.Mesh(plane, p.starMat);
      p.star.position.copy(p.mesh.position);
      p.star.scale.set(s.size, s.size, 1);
      scene.add(p.star);
      billboards.push(p.star);
    }

    function makeRng(seed: number){
      return () => {
        seed = (seed + 0x6D2B79F5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    let pieces: Piece[] = [];
    let thread: THREE.Line | null = null, dust: THREE.Points | null = null;
    const billboards: THREE.Object3D[] = [];

    function makeLabel(text: string){
      const cv = document.createElement('canvas');
      cv.width = 256; cv.height = 48;
      const c = cv.getContext('2d')!;
      c.font = "26px 'DM Mono', monospace"; c.fillStyle = '#f0ede8'; c.textAlign = 'center'; c.textBaseline = 'middle';
      c.fillText(text, 128, 24);
      const mesh = new THREE.Mesh(plane, new THREE.MeshBasicMaterial({ map:new THREE.CanvasTexture(cv), transparent:true, opacity:.5, depthWrite:false }));
      mesh.scale.set(10.6, 2, 1);
      billboards.push(mesh);
      scene.add(mesh);
      return mesh;
    }
    // Months are clusters on a spiral: same month stays together, older months sit further out.
    function layout(){
      const months = [...new Set(stations.slice(1).map(s => s.date.slice(0,7)))].sort().reverse();
      const spots = new Map<string, THREE.Vector3>();
      months.forEach((m, k) => {
        const f = months.length > 1 ? k/(months.length-1) : 0;
        const a = k*1.24 + .6, r = 34 + f*58;
        spots.set(m, new THREE.Vector3(Math.cos(a)*r, (k % 2 ? 1 : -1)*(8 + f*18), Math.sin(a)*r));
      });
      const count = new Map<string, number>();
      stations.forEach(s => { const m = s.date.slice(0,7); count.set(m, (count.get(m) || 0) + 1); });
      const out = stations.map(s => {
        if(s.kind === 'home') return new THREE.Vector3();
        const m = s.date.slice(0,7), rng = makeRng(s.n*7919);
        const spread = 9 + Math.sqrt(count.get(m)!)*3.8;
        const u = rng()*Math.PI*2, v = Math.acos(2*rng()-1), r = spread*Math.cbrt(rng());
        return spots.get(m)!.clone().add(new THREE.Vector3(Math.sin(v)*Math.cos(u)*r, Math.cos(v)*r, Math.sin(v)*Math.sin(u)*r));
      });
      // a few relaxation passes so plates don't sit on top of each other
      for(let pass = 0; pass < 24; pass++){
        for(let a = 1; a < out.length; a++) for(let b = a+1; b < out.length; b++){
          const d = out[a].clone().sub(out[b]), len = d.length();
          if(len < 8.5 && len > 1e-3) { d.multiplyScalar((8.5-len)/len*.5); out[a].add(d); out[b].sub(d); }
        }
        for(let a = 1; a < out.length; a++){ // keep the logo clear
          const len = out[a].length();
          if(len < 19) out[a].multiplyScalar(19/len);
        }
      }
      months.forEach(m => {
        const p = spots.get(m)!;
        makeLabel(m.replace('-','·')).position.copy(p).add(new THREE.Vector3(0, 13 + Math.sqrt(count.get(m)!)*3.4, 0));
      });
      return out;
    }
    function setSize(p: Piece, aspect: number){
      const home = p.st.kind === 'home';
      const big = p.st.kind === 'set' ? 1.4 : 1;
      if(home){ p.w = p.h = 24; }
      else if(aspect >= 1){ p.w = 8.4*big; p.h = p.w/aspect; }
      else { p.h = 8*big; p.w = p.h*aspect; }
      p.mesh.scale.set(p.w, p.h, 1);
    }
    function setMap(p: Piece, tex: THREE.Texture){
      p.mat.uniforms.uMap.value = tex;
      p.mat.uniforms.uHas.value = 1;
    }
    function buildSpace(){
      const spots = layout();
      pieces = stations.map((st, i) => {
        const mat = new THREE.ShaderMaterial({
          vertexShader:VERT, fragmentShader:FRAG, transparent:true, depthWrite:false,
          uniforms:{ uMap:{value:blank}, uTint:{value:new THREE.Vector3(...hexRgb(st.tint))}, uHas:{value:0}, uReveal:{value:0}, uOpacity:{value:0}, uCell:{value:4*DPR}, uGain:{value:.74} },
        });
        const mesh = new THREE.Mesh(plane, mat);
        mesh.position.copy(spots[i]);
        mesh.userData.i = i;
        scene.add(mesh);
        billboards.push(mesh);
        const p: Piece = { st, i, mesh, mat, w:4, h:4, opacity:0, reveal:0, grow:1, beat:0, bright:1, starMix:1 };
        setSize(p, st.src ? .75 : 1);
        if(st.kind !== 'home') buildStar(p);
        if(st.kind === 'set'){
          p.halo = new THREE.Mesh(new THREE.RingGeometry(.98, 1, 96), new THREE.MeshBasicMaterial({ color:0xff6eb4, transparent:true, opacity:.7, depthWrite:false }));
          p.halo.position.copy(mesh.position);
          scene.add(p.halo);
          billboards.push(p.halo);
        }
        return p;
      });
      buildThread();
      buildDust();
      buildShip();
      cards();
      queuePhotos();
    }
    // The chronology is one continuous curve; pulses run along it from the present into the past.
    function buildThread(){
      const pts = pieces.map(p => p.mesh.position.clone());
      const curve = new THREE.CatmullRomCurve3(pts, false, 'centripetal');
      const N = pts.length*14;
      const geo = new THREE.BufferGeometry().setFromPoints(curve.getPoints(N));
      const at = new Float32Array(N+1), col = new Float32Array((N+1)*3);
      for(let i = 0; i <= N; i++){
        at[i] = i/N;
        const q = pieces[Math.min(pieces.length-1, Math.round(i/N*(pieces.length-1)))];
        col.set(hexRgb(q.st.tint), i*3);
      }
      geo.setAttribute('aT', new THREE.BufferAttribute(at, 1));
      geo.setAttribute('aC', new THREE.BufferAttribute(col, 3));
      thread = new THREE.Line(geo, new THREE.ShaderMaterial({
        transparent:true, depthWrite:false, blending:THREE.AdditiveBlending,
        uniforms:{ uTime:{value:0}, uDim:{value:1} },
        vertexShader:`attribute float aT; attribute vec3 aC; varying float vT; varying vec3 vC;
          void main(){ vT = aT; vC = aC; gl_Position = projectionMatrix*modelViewMatrix*vec4(position,1.); }`,
        fragmentShader:`precision highp float; varying float vT; varying vec3 vC; uniform float uTime, uDim;
          void main(){
            float p = pow(fract(vT*5.-uTime*.05), 18.);
            gl_FragColor = vec4(vC*(.34+p*2.6)*uDim, 1.);
          }`,
      }));
      scene.add(thread);
    }
    function buildDust(){
      const rng = makeRng(23), N = 5200, pos = new Float32Array(N*3), col = new Float32Array(N*3);
      for(let i = 0; i < N; i++){
        const q = pieces[1 + Math.floor(rng()*(pieces.length-1))];
        const r = 2 + Math.pow(rng(), 2)*24, u = rng()*Math.PI*2, v = Math.acos(2*rng()-1);
        pos.set([q.mesh.position.x + Math.sin(v)*Math.cos(u)*r, q.mesh.position.y + Math.cos(v)*r*.8, q.mesh.position.z + Math.sin(v)*Math.sin(u)*r], i*3);
        const c = hexRgb(q.st.tint), b = .2 + rng()*.6;
        col.set([c[0]*b, c[1]*b, c[2]*b], i*3);
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      dust = new THREE.Points(geo, new THREE.PointsMaterial({ size:.55, map:SPRITE, vertexColors:true, transparent:true, opacity:.8, depthWrite:false, blending:THREE.AdditiveBlending }));
      scene.add(dust);
    }
    function cards(){
      pieces.forEach(p => {
        if(p.st.src) return;
        p.lo?.dispose();
        p.lo = new THREE.CanvasTexture(renderCard(p.st, p.st.kind === 'home' ? 1400 : 512));
        p.lo.anisotropy = 4;
        if(!p.hi) setMap(p, p.lo);
      });
    }
    // Thumbnails stream in from the centre outwards, a few at a time.
    function queuePhotos(){
      const queue = pieces.filter(p => p.st.src);
      const next = () => {
        const p = queue.shift();
        if(!p) return;
        const img = new Image();
        img.onerror = next;
        img.onload = () => {
          const S = 384, k = Math.min(1, S/Math.max(img.naturalWidth, img.naturalHeight));
          const cv = document.createElement('canvas');
          cv.width = Math.round(img.naturalWidth*k); cv.height = Math.round(img.naturalHeight*k);
          cv.getContext('2d')!.drawImage(img, 0, 0, cv.width, cv.height);
          setSize(p, img.naturalWidth/img.naturalHeight);
          p.lo = new THREE.CanvasTexture(cv);
          p.lo.anisotropy = 4;
          if(!p.hi) setMap(p, p.lo);
          next();
        };
        img.src = p.st.src!;
      };
      for(let k = 0; k < 5; k++) next();
    }
    function loadHi(p: Piece){
      if(p.hi || p.hiBusy || p.st.kind === 'home') return;
      if(!p.st.src){
        p.hi = new THREE.CanvasTexture(renderCard(p.st, 1536));
        p.hi.anisotropy = 8;
        setMap(p, p.hi);
        return;
      }
      p.hiBusy = true;
      const img = new Image();
      img.onload = () => {
        p.hiBusy = false;
        p.hi = new THREE.Texture(img);
        p.hi.anisotropy = 8;
        p.hi.needsUpdate = true;
        setMap(p, p.hi);
      };
      img.onerror = () => { p.hiBusy = false; };
      img.src = p.st.src;
    }
    function dropHi(p: Piece){
      if(!p.hi) return;
      p.hi.dispose();
      p.hi = undefined;
      if(p.lo) setMap(p, p.lo);
    }
    function roundSprite(){
      const cv = document.createElement('canvas');
      cv.width = cv.height = 32;
      const c = cv.getContext('2d')!;
      const g = c.createRadialGradient(16, 16, 0, 16, 16, 16);
      g.addColorStop(0, '#fff'); g.addColorStop(.45, 'rgba(255,255,255,.6)'); g.addColorStop(1, 'rgba(255,255,255,0)');
      c.fillStyle = g; c.fillRect(0, 0, 32, 32);
      return new THREE.CanvasTexture(cv);
    }
    const SPRITE = roundSprite();
    function buildStars(){
      const rng = makeRng(11), N = 2600, pos = new Float32Array(N*3), col = new Float32Array(N*3);
      for(let i = 0; i < N; i++){
        const u = rng()*Math.PI*2, v = Math.acos(2*rng()-1), r = 90 + rng()*330;
        pos.set([Math.sin(v)*Math.cos(u)*r, Math.cos(v)*r, Math.sin(v)*Math.sin(u)*r], i*3);
        const c = rng() < .12 ? hexRgb(COLORS[Math.floor(rng()*COLORS.length)]) : [.94,.93,.91];
        const b = .25 + rng()*.75;
        col.set([c[0]*b, c[1]*b, c[2]*b], i*3);
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
