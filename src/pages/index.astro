      const waiting = focused >= 0 && s.peek > .6;
      const show = s.onScreen && s.mode === 'cruise' && (focused < 0 || waiting) && !boarded && !flight;
      shipTag.classList.toggle('show', show);
      const label = focused >= 0 ? 'keep travelling' : 'leave a word';
      if(shipTag.textContent !== label) shipTag.textContent = label;
      if(show){
        const x = Math.max(76, Math.min(window.innerWidth-76, s.sx));
