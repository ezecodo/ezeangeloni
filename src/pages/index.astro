      if(!reduced && !frozen){ stars.rotation.y += dt*.004; nebula.rotation.y += dt*.0015; }
      placeSelector();
      if(composer && bloom && lens){
        bloom.strength = BLOOM*(1-calm) + logoPulse*.8;
        bloom.enabled = !lowPower && bloom.strength > .01;
        lens.uniforms.uEnergy.value = reduced ? 0 : flightEnergy;
        lens.uniforms.uGrain.value = 1-calm;
        lens.uniforms.uTime.value = now*.001;
        composer.render();
      }
    }

    // ── Sheets ────────────────────────────────────────────
    const sheets = { index:$('index-sheet'), about:$('about-sheet'), set:$('set-sheet') };
    function openSheet(s: HTMLElement){ stopScan(); hint.hidden = true; s.classList.add('open'); }
    function closeSheets(){
      if(sheets.set.classList.contains('open')) closeSetModal();
      Object.values(sheets).forEach(s => s.classList.remove('open'));
      $('link-sheet').classList.remove('open');
    }
    $('link-close').addEventListener('click', closeSheets);
    $('btn-about').addEventListener('click', () => openSheet(sheets.about));
    $('about-close').addEventListener('click', closeSheets);
    $('btn-index').addEventListener('click', openIndex);
    $('index-close').addEventListener('click', closeSheets);
    $('home').addEventListener('click', () => { touched(); if(worldAt >= 0) leaveWorld(); else backOut(); });

    function openIndex(){ openSheet(sheets.index); }
    function buildIndex(){
      const grid = $('index-grid');
      grid.innerHTML = '';
      stations.forEach((st, i) => {
        if(st.kind === 'home') return;
        const cell = document.createElement('button');
        cell.className = 'cell';
        cell.dataset.i = String(i);
        if(st.src){
          const img = document.createElement('img');
          img.loading = 'lazy'; img.alt = st.text; img.src = thumbOf(st.src);
          img.onerror = () => { if(img.src.includes('/images/t/')) img.src = st.src!; };
          cell.appendChild(img);
        } else {
          const tx = document.createElement('span');
          tx.className = 'cell-text';
          tx.textContent = st.text;
          tx.style.background = st.kind === 'set' ? 'linear-gradient(135deg,#ff6eb4,#c77dff)' : st.tint;
          cell.appendChild(tx);
        }
