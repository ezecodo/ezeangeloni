    const craftParam = new URLSearchParams(location.search).get('craft');
    let craft: Craft = craftParam === 'ship' || craftParam === 'balloon' ? craftParam : Math.random() < .5 ? 'ship' : 'balloon';
    // Cruising, the ship lives in this rig glued to the camera: orbiting and zooming the universe never move it.
    const rig = new THREE.Group();
    scene.add(rig);
    const HULL: [number, number][] = [[0,5.4],[.3,4.5],[.62,3],[.86,.8],[.92,-1.4],[.76,-2.9],[.52,-3.5]];
    const hullR = (z: number) => {
      for(let i = 1; i < HULL.length; i++){
        if(z >= HULL[i][1]){
          const [r0,z0] = HULL[i-1], [r1,z1] = HULL[i];
          return r1 + (r0-r1)*(z-z1)/(z0-z1);
        }
      }
