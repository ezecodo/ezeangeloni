    // ── Ship ──────────────────────────────────────────────
    // The message carrier: patrols the limbo with one cargo light per word, leaves when it holds eleven.
    // Two crafts carry the words: the ship, or a hot air balloon that lets its eleven lights go. One per visit, `b` swaps.
    type Craft = 'ship' | 'balloon';
    interface Body {
      kind: Craft; scale: number; group: THREE.Group; engine: THREE.Mesh; lamps: THREE.MeshBasicMaterial[][];
