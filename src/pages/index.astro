          for(let a = 0; a <= 96; a++) pts.push(envelopeAt(j, a/96*Math.PI*2).multiplyScalar(1.006).setY(ENVELOPE[j][1]));
          group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), j === 5 ? ink : faint));
        }
