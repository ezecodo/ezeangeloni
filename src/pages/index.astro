---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Eze Angeloni">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Mono:ital@0;1&family=Cormorant+Garamond:ital,wght@0,300;1,300;1,400&family=Playfair+Display:ital@1&family=Lora:ital@1&family=Libre+Baskerville:ital@1&family=EB+Garamond:ital@1&family=Crimson+Text:ital@1&display=swap" rel="stylesheet" />
    <style>
      @font-face {
        font-family: 'MalvinasSans';
        src: url('/fonts/MalvinasSans-Regular.otf?v=19') format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --bg: #080810; --text: #f0ede8; --muted: rgba(240,237,232,0.3);
      }
      html, body { width: 100%; height: 100%; overflow: hidden; background: var(--bg); color: var(--text); font-family: 'Syne', sans-serif; cursor: none; }
      canvas { position: fixed; inset: 0; width: 100%; height: 100%; will-change: transform; touch-action: none; }
      #cursor { position: fixed; width: 5px; height: 5px; background: var(--text); border-radius: 50%; pointer-events: none; z-index: 9999; transform: translate(-50%,-50%); }
      #cursor::before, #cursor::after { content:''; position:absolute; border-radius:50%; border:1px solid rgba(240,237,232,0.5); top:50%; left:50%; transform:translate(-50%,-50%); animation: sonar 2.4s ease-out infinite; }
      #cursor::after { animation-delay:1.2s; }
      #cursor.on-bubble::before, #cursor.on-bubble::after { border-color: rgba(110,249,245,0.8); animation-duration:1.2s; }
      @keyframes sonar { 0% { width:5px; height:5px; opacity:.8; } 100% { width:70px; height:70px; opacity:0; } }
      #hero { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 4vh; text-align: center; pointer-events: none; z-index: 10; gap: 8px; }
      #hero h1 { font-size: clamp(3rem,8vw,7rem); font-weight: 800; letter-spacing: -0.03em; opacity: 0; animation: fadeUp 1.2s cubic-bezier(.16,1,.3,1) .3s forwards; }
      #hero p { font-family: 'DM Mono', monospace; font-size: clamp(.7rem,1.5vw,.95rem); letter-spacing: .25em; text-transform: uppercase; color: var(--muted); opacity: 0; animation: fadeUp 1.2s cubic-bezier(.16,1,.3,1) .6s forwards; }
      #hint { position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%); font-family: 'DM Mono', monospace; font-size: .7rem; letter-spacing: .2em; color: var(--muted); text-transform: uppercase; z-index: 10; pointer-events: none; opacity: 0; animation: fadeUp 1s ease 1.5s forwards; }
      #trapo-fab { position: fixed; top: 0; left: 0; z-index: 50; font-family: 'MalvinasSans', sans-serif; font-size: 2.2rem; letter-spacing: .01em; color: var(--text); text-decoration: none; cursor: pointer; white-space: nowrap; transition: color .2s; will-change: transform; }
      #trapo-fab:hover { color: #38bdf8; }
      @media (max-width: 768px) {
        #trapo-fab { font-size: 1.4rem; }
      }
      #modal-overlay { position: fixed; inset: 0; background: rgba(8,8,16,0.85); backdrop-filter: blur(12px); z-index: 100; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .4s ease; }
      #modal-overlay.open { opacity: 1; pointer-events: all; }
      #modal { background: rgba(240,237,232,0.04); border: 1px solid rgba(240,237,232,0.1); border-radius: 16px; padding: 3rem; max-width: 680px; width: 90%; max-height: 80vh; overflow-y: auto; position: relative; transform: translateY(30px); transition: transform .4s cubic-bezier(.16,1,.3,1); }
      #modal-overlay.open #modal { transform: translateY(0); }
      #modal h2 { font-family: 'Cormorant Garamond', serif; font-size: clamp(2rem,5vw,3.5rem); font-weight: 300; letter-spacing: .3em; text-transform: uppercase; margin-bottom: 1.5rem; }
      #modal p { font-family: 'DM Mono', monospace; font-size: .85rem; line-height: 1.9; color: rgba(240,237,232,0.85); }
      #modal-close { position: absolute; top: 1.2rem; right: 1.5rem; background: none; border: none; color: var(--muted); font-size: 1.5rem; cursor: pointer; line-height: 1; transition: color .2s; }
      #modal-close:hover { color: var(--text); }
      #frase-overlay { position: fixed; inset: 0; background: rgba(8,8,16,0.88); backdrop-filter: blur(16px); z-index: 100; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .4s ease; }
      #frase-overlay.open { opacity: 1; pointer-events: all; }
      #frase-box { max-width: 600px; width: 88%; position: relative; transform: translateY(24px); transition: transform .4s cubic-bezier(.16,1,.3,1); text-align: center; padding: 1rem; }
      #frase-overlay.open #frase-box { transform: translateY(0); }
      #frase-accent { width: 32px; height: 1px; background: currentColor; margin: 0 auto 2rem; opacity: .4; }
      #frase-text { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.6rem,5vw,3rem); font-weight: 300; font-style: italic; line-height: 1.45; letter-spacing: .01em; color: var(--text); }
      #frase-close { position: absolute; top: -1rem; right: -.5rem; background: none; border: none; color: var(--muted); font-size: 1.4rem; cursor: pointer; line-height: 1; transition: color .2s; padding: .5rem; }
      #frase-close:hover { color: var(--text); }
      #msg-overlay { position: fixed; inset: 0; background: rgba(8,8,16,0.85); backdrop-filter: blur(12px); z-index: 100; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .4s ease; }
      #msg-overlay.open { opacity: 1; pointer-events: all; }
      #msg-box { background: rgba(240,237,232,0.04); border: 1px solid rgba(240,237,232,0.1); border-radius: 16px; padding: 2.5rem; max-width: 520px; width: 90%; position: relative; transform: translateY(30px); transition: transform .4s cubic-bezier(.16,1,.3,1); }
      #msg-overlay.open #msg-box { transform: translateY(0); }
      #msg-box h2 { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.8rem,4vw,2.8rem); font-weight: 300; letter-spacing: .3em; text-transform: uppercase; margin-bottom: .5rem; }
      #msg-box .subtitle { font-family: 'DM Mono', monospace; font-size: .72rem; color: var(--muted); letter-spacing: .15em; margin-bottom: 1.8rem; }
      #msg-input { width: 100%; background: rgba(240,237,232,0.06); border: 1px solid rgba(240,237,232,0.15); border-radius: 8px; color: var(--text); font-family: 'DM Mono', monospace; font-size: .9rem; padding: .9rem 1rem; resize: none; outline: none; transition: border-color .2s; line-height: 1.7; }
      #msg-input:focus { border-color: rgba(240,237,232,0.4); }
      #msg-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; }
      #word-count { font-family: 'DM Mono', monospace; font-size: .72rem; color: var(--muted); }
      #word-count.full { color: #b8f75b; }
      #word-count.over { color: #ff3f3f; }
      #msg-send { background: rgba(240,237,232,0.08); border: 1px solid rgba(240,237,232,0.2); color: var(--text); font-family: 'DM Mono', monospace; font-size: .75rem; letter-spacing: .15em; text-transform: uppercase; padding: .6rem 1.4rem; border-radius: 6px; cursor: pointer; transition: background .2s, border-color .2s; }
      #msg-send:hover { background: rgba(240,237,232,0.15); border-color: rgba(240,237,232,0.4); }
      #msg-send:disabled { opacity: .3; cursor: default; }
      #msg-close { position: absolute; top: 1.2rem; right: 1.5rem; background: none; border: none; color: var(--muted); font-size: 1.5rem; cursor: pointer; transition: color .2s; }
      #msg-close:hover { color: var(--text); }
      #set-overlay { position: fixed; inset: 0; background: rgba(8,8,16,0.9); backdrop-filter: blur(18px); z-index: 100; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .4s ease; overflow-y: auto; padding: 2rem 1rem; }
      #set-overlay.open { opacity: 1; pointer-events: all; }
      #set-box { max-width: 620px; width: 92%; position: relative; transform: translateY(28px); transition: transform .5s cubic-bezier(.16,1,.3,1); text-align: center; padding: 1.5rem 1rem; max-height: 100%; }
      #set-overlay.open #set-box { transform: translateY(0); }
      #set-artwork { width: 84px; height: 84px; border-radius: 50%; margin: 0 auto 1.2rem; display: none; overflow: hidden; box-shadow: 0 0 40px rgba(255,110,180,0.35), 0 0 0 1px rgba(255,110,180,0.4); }
      #set-artwork img { width: 100%; height: 100%; object-fit: cover; display: block; }
      #set-artwork.show { display: block; }
      #set-accent { width: 32px; height: 1px; background: #ff6eb4; margin: 0 auto 1.8rem; opacity: .5; }
      #set-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.8rem,4.5vw,3rem); font-weight: 300; font-style: italic; letter-spacing: .02em; color: var(--text); line-height: 1.2; }
      #set-date { font-family: 'DM Mono', monospace; font-size: .72rem; color: var(--muted); letter-spacing: .25em; text-transform: uppercase; margin-top: .8rem; }
      #set-tracklist { margin-top: 1.8rem; padding-top: 1.4rem; border-top: 1px solid rgba(240,237,232,0.08); display: none; text-align: left; max-height: 240px; overflow-y: auto; }
      #set-tracklist.show { display: block; }
      .tl-row { display: flex; gap: .9rem; padding: .55rem .2rem; cursor: pointer; border-radius: 6px; transition: background .2s, color .2s; }
      .tl-row:hover { background: rgba(240,237,232,0.04); }
      .tl-row.active { background: linear-gradient(90deg, rgba(255,110,180,0.08), rgba(199,125,255,0.05)); }
      .tl-time { font-family: 'DM Mono', monospace; font-size: .68rem; color: var(--muted); letter-spacing: .05em; min-width: 56px; flex-shrink: 0; padding-top: .15rem; }
      .tl-row.active .tl-time { color: #ff6eb4; }
      .tl-label { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 300; font-size: 1rem; line-height: 1.35; color: rgba(240,237,232,0.75); }
      .tl-row.active .tl-label { color: var(--text); }
      #set-player { margin-top: 2.4rem; display: flex; flex-direction: column; align-items: center; gap: 1.2rem; }
      #set-play { width: 64px; height: 64px; border-radius: 50%; border: 1px solid rgba(240,237,232,0.25); background: rgba(240,237,232,0.04); color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .2s, border-color .2s, transform .2s; padding: 0; }
      #set-play:hover { background: rgba(240,237,232,0.08); border-color: rgba(240,237,232,0.5); }
      #set-play:active { transform: scale(.96); }
      #set-play svg { width: 22px; height: 22px; fill: var(--text); }
      #set-progress-row { width: 100%; max-width: 520px; display: flex; align-items: center; gap: .8rem; }
      #set-time-current, #set-time-total { font-family: 'DM Mono', monospace; font-size: .7rem; color: var(--muted); letter-spacing: .08em; min-width: 42px; }
      #set-time-total { text-align: right; }
      #set-seek { flex: 1; position: relative; height: 22px; cursor: pointer; display: flex; align-items: center; }
      #set-seek-track { position: absolute; left: 0; right: 0; height: 2px; background: rgba(240,237,232,0.12); border-radius: 2px; overflow: hidden; }
      #set-seek-buffer { position: absolute; left: 0; top: 0; bottom: 0; background: rgba(240,237,232,0.18); transition: width .2s ease; }
      #set-seek-fill { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(90deg, #ff6eb4, #c77dff); border-radius: 2px; }
      #set-seek-thumb { position: absolute; top: 50%; transform: translate(-50%, -50%); width: 11px; height: 11px; border-radius: 50%; background: var(--text); opacity: 0; transition: opacity .2s; pointer-events: none; box-shadow: 0 0 12px rgba(199,125,255,0.5); }
      #set-seek:hover #set-seek-thumb, #set-seek.dragging #set-seek-thumb { opacity: 1; }
      #set-meta { display: flex; gap: 1.2rem; align-items: center; justify-content: center; margin-top: .4rem; }
      #set-copy { background: none; border: none; color: var(--muted); font-family: 'DM Mono', monospace; font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; cursor: pointer; padding: .4rem .6rem; transition: color .2s; }
      #set-copy:hover { color: var(--text); }
      #set-copy.copied { color: #b8f75b; }
      #set-close { position: absolute; top: -1rem; right: -.5rem; background: none; border: none; color: var(--muted); font-size: 1.4rem; cursor: pointer; line-height: 1; transition: color .2s; padding: .5rem; }
      #set-close:hover { color: var(--text); }
      @media (max-width: 768px) {
        #set-play { width: 56px; height: 56px; }
        #set-play svg { width: 18px; height: 18px; }
        #set-seek-thumb { opacity: 1; width: 13px; height: 13px; }
      }
      #img-overlay { position: fixed; inset: 0; background: rgba(8,8,16,0.92); backdrop-filter: blur(16px); z-index: 100; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; opacity: 0; pointer-events: none; transition: opacity .3s ease; cursor: pointer; }
      #img-overlay.open { opacity: 1; pointer-events: all; }
      #img-overlay img { max-width: 90vw; max-height: 85vh; border-radius: 8px; object-fit: contain; transform: scale(0.92); transition: transform .4s cubic-bezier(.16,1,.3,1), opacity .3s ease; box-shadow: 0 0 60px rgba(0,0,0,0.6); }
      #img-overlay.open img { transform: scale(1); }
      #img-overlay img.loading { opacity: 0; }
      #img-loader { width: 32px; height: 32px; border: 2px solid rgba(240,237,232,0.15); border-top-color: rgba(240,237,232,0.7); border-radius: 50%; animation: spin .8s linear infinite; display: none; }
      #img-overlay.loading #img-loader { display: block; }
      #img-overlay.loading img { display: none; }
      @keyframes spin { to { transform: rotate(360deg); } }
      #img-close { position: fixed; top: 1.5rem; right: 1.5rem; background: none; border: none; color: rgba(240,237,232,0.5); font-size: 1.5rem; cursor: pointer; z-index: 101; transition: color .2s; }
      #img-close:hover { color: var(--text); }
      #msg-thanks { text-align: center; padding: 1rem 0; }
      #msg-thanks p { font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 300; letter-spacing: .2em; margin-bottom: .8rem; }
      #msg-thanks small { font-family: 'DM Mono', monospace; font-size: .72rem; color: var(--muted); letter-spacing: .1em; }
      @keyframes fadeUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
      @keyframes logoGlow {
        0%   { filter: brightness(0) invert(1) drop-shadow(0 0 0px transparent); }
        15%  { filter: brightness(0) invert(1) drop-shadow(0 0 18px #6ef9f5) drop-shadow(0 0 40px #6ef9f580); }
        30%  { filter: brightness(0) invert(1) drop-shadow(0 0 18px #c77dff) drop-shadow(0 0 40px #c77dff80); }
        50%  { filter: brightness(0) invert(1) drop-shadow(0 0 18px #ff6eb4) drop-shadow(0 0 40px #ff6eb480); }
        65%  { filter: brightness(0) invert(1) drop-shadow(0 0 18px #b8f75b) drop-shadow(0 0 40px #b8f75b80); }
        80%  { filter: brightness(0) invert(1) drop-shadow(0 0 18px #ff9f1c) drop-shadow(0 0 40px #ff9f1c80); }
        100% { filter: brightness(0) invert(1) drop-shadow(0 0 0px transparent); }
      }
      #logo { width: clamp(16rem,40vw,30rem); margin-bottom: -8rem; filter: brightness(0) invert(1); animation: fadeUp 1.2s cubic-bezier(.16,1,.3,1) .3s forwards, logoGlow 6s ease-in-out 1.5s infinite; opacity: 0; }
      @media (max-width: 768px) {
        html, body { cursor: auto; touch-action: manipulation; }
        canvas { touch-action: none; }
        #cursor, #cursor::before, #cursor::after { display: none; }
        #hero { justify-content: center; padding-top: 0; gap: 0; transform: translateY(-6vh); }
        #logo { width: 48vw; margin-bottom: -2.8rem; }
        #hero-name { font-size: clamp(.95rem,5vw,1.4rem) !important; letter-spacing: .35em !important; }
        #hero-sub { font-size: clamp(.6rem,3vw,.78rem); letter-spacing: .18em; }
        #hint { font-size: .58rem; bottom: 1.2rem; }
      }
    </style>
  </Fragment>

  <div id="cursor"></div>
  <canvas id="canvas"></canvas>
  <div id="hero">
    <img id="logo" src="/eZe.svg" alt="eZe" />
    <p id="hero-name" style="font-family: 'Cormorant Garamond', serif; font-size: clamp(1.2rem,3.5vw,2.4rem); font-weight: 300; letter-spacing: .5em; text-transform: uppercase; color: var(--text); opacity: 0; animation: fadeUp 1.2s cubic-bezier(.16,1,.3,1) .5s forwards; padding-left: .5em;">angeloni</p>
    <p id="hero-sub">Developer · Builder · Explorer</p>
  </div>
  <div id="hint">explore the circles</div>
  <a id="trapo-fab" href="/tu-trapo">Fábrica de trapos</a>

  <div id="msg-overlay">
    <div id="msg-box">
      <button id="msg-close">✕</button>
      <div id="msg-form">
        <h2>Leave a word</h2>
        <p class="subtitle">exactly 11 words. make them count.</p>
        <textarea id="msg-input" rows="3" placeholder="eleven words, no more, no less..."></textarea>
        <div id="msg-footer">
          <span id="word-count">0 / 11</span>
          <button id="msg-send" disabled>send</button>
        </div>
      </div>
      <div id="msg-thanks" style="display:none">
        <p>thank you ✦</p>
        <small>your words are now part of this space</small>
      </div>
    </div>
  </div>

  <div id="img-overlay">
    <button id="img-close">✕</button>
    <div id="img-loader"></div>
    <img id="img-full" src="" alt="" />
  </div>

  <div id="frase-overlay">
    <div id="frase-box">
      <button id="frase-close">✕</button>
      <div id="frase-accent"></div>
      <p id="frase-text"></p>
    </div>
  </div>

  <div id="set-overlay">
    <div id="set-box">
      <button id="set-close">✕</button>
      <div id="set-artwork"><img id="set-artwork-img" alt=""></div>
      <div id="set-accent"></div>
      <h2 id="set-title"></h2>
      <p id="set-date"></p>
      <div id="set-player">
        <button id="set-play" aria-label="play">
          <svg id="set-play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <div id="set-progress-row">
          <span id="set-time-current">0:00</span>
          <div id="set-seek">
            <div id="set-seek-track">
              <div id="set-seek-buffer"></div>
              <div id="set-seek-fill"></div>
            </div>
            <div id="set-seek-thumb"></div>
          </div>
          <span id="set-time-total">--:--</span>
        </div>
        <div id="set-meta">
          <button id="set-copy">copy link</button>
        </div>
      </div>
      <div id="set-tracklist"></div>
      <audio id="set-audio" preload="metadata"></audio>
    </div>
  </div>

  <div id="modal-overlay">
    <div id="modal">
      <button id="modal-close">✕</button>
      <h2>About</h2>
      <p>Hey, I'm Eze. I build things for the web — from the database to the pixel.</p>
      <p style="margin-top:1.2rem">Originally from Argentina, now based in Barcelona, I've spent years at the intersection of technology and culture. I've helped organize theatre festivals, been part of interdisciplinary collectives, and worked on projects that use culture as a bridge between societies. That background shapes how I approach every line of code — with purpose, context, and people in mind.</p>
      <p style="margin-top:1.2rem">On the technical side, I'm a full-stack developer working with Next.js, React, and Node — building editorial platforms, CMS systems, and interactive experiences.</p>
      <p style="margin-top:1.2rem">Currently available for freelance work. If you've got something interesting brewing, I'd love to hear about it.</p>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const cursor = document.getElementById('cursor')!;

    let W = canvas.width = window.innerWidth;
    let H = canvas.height = window.innerHeight;
    let mouse = { x: -999, y: -999 };
    const COLORS = ['#ff3f3f','#ff9f1c','#6ef9f5','#b8f75b','#c77dff','#ff6eb4','#38bdf8','#ffd166'];
    const NOTES =  [392, 440, 523, 587, 659, 349, 466, 311];
    let audioCtx: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let lastSoundTime = 0;
    const SOUND_COOLDOWN = 180;
    function playNote(freq: number) {
      const now = performance.now();
      if (now - lastSoundTime < SOUND_COOLDOWN) return;
      lastSoundTime = now;
      if (!audioCtx) { audioCtx = new AudioContext(); masterGain = audioCtx.createGain(); masterGain.gain.value = 0.18; masterGain.connect(audioCtx.destination); }
      const t = audioCtx.currentTime;
      function layer(f: number, type: OscillatorType, vol: number, dur: number, pitchDrop = 1){
        const osc = audioCtx!.createOscillator();
        const g = audioCtx!.createGain();
        osc.connect(g); g.connect(masterGain!);
        osc.type = type;
        osc.frequency.setValueAtTime(f, t);
        if(pitchDrop !== 1) osc.frequency.exponentialRampToValueAtTime(f * pitchDrop, t + dur * 0.6);
        g.gain.setValueAtTime(vol, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + dur);
        osc.start(t); osc.stop(t + dur);
      }
      layer(freq,     'sine',     1.0,  0.35, 0.75); // main — suave con pitch drop
      layer(freq/2,   'triangle', 0.5,  0.18);        // bass — cuerpo, corto
      layer(freq*2,   'sine',     0.15, 0.2);         // shimmer — brillo suave
    }
    let songPlaying = false;
    // Note frequencies
    const G4=392, A4=440, B4=493.88, C5=523.25, D5=587.33, E4=329.63, D4=293.66, C4=261.63;
    // [freq, duration_seconds] — 0 = rest
    const REDEMPTION: [number,number][] = [
      // "Old pi-rates, yes, they rob I"
      [G4,.4],[B4,.4],[A4,.3],[G4,.3],[E4,.4],[D4,.3],[E4,.3],[G4,.7],
      // "Sold I to the mer-chant ships"
      [G4,.4],[B4,.4],[A4,.3],[G4,.3],[E4,.4],[D4,.3],[C4,.3],[D4,.7],
