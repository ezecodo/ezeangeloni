      } else if(pilot && focused < 0){
        flightEnergy = updatePilot(dt, now);
      } else if(focused < 0 && controls?.enabled){
        controls.autoRotate = !reduced && now-lastInput > 2600;
        controls.update();
        look.copy(controls.target);
      }
      if(windMotes) windMotes.visible = !!pilot && focused < 0 && !boarded;
      flightEnergy = Math.max(flightEnergy, updateBalloon(now, dt));
      updateSky(now, dt);
      updateMeeting(now);
      updateTour(now, dt);
      updateGas(dt, frozen ? 0 : dt, now);
      updateWorlds(frozen ? 0 : dt);
      updateBeacons(now);
      updateXibalba(now);
      manageThumbs(now);
      if(pointerFresh && balloon && focused < 0 && !flight && !boarded){
        const near = balloon.mode === 'cruise' && Math.hypot((ndc.x+1)/2*window.innerWidth-balloon.sx, (1-ndc.y)/2*window.innerHeight-balloon.sy) < 56;
        if(near !== hoverBalloon){
          hoverBalloon = near;
          balloonTag.classList.toggle('hot', near);
          metaCap.textContent = near ? 'leave a word' : 'pasado observado';
          if(near) playNote(NOTES[4]);
        }
      }
      if(pointerFresh && focused < 0 && !flight && !boarded && !pilot?.selecting && pieces.length){
        pointerFresh = false;
        const w = pickWorld();
        if(w !== hoverWorld){
          hoverWorld = w;
          if(w >= 0){ hovered = -1; showWorldMeta(w); playNote(NOTES[5]); }
          else showMeta(0);
        }
        const i = w >= 0 ? -1 : pick();
        if(i !== hovered && w < 0){
          hovered = i;
          if(i > 0){ showMeta(i); playNote(NOTES[pieces[i].st.n % NOTES.length]); }
          else { showMeta(0); if(i === 0){ metaCap.textContent = 'leave a word'; playNote(NOTES[4]); } }
        }
      } else if(focused >= 0 || flight || boarded) hovered = -1;

      if(staticGain && staticFilter && audioCtx){
        staticGain.gain.setTargetAtTime(flightEnergy*.13, audioCtx.currentTime, .05);
        staticFilter.frequency.setTargetAtTime(500 + camera.position.length()*18, audioCtx.currentTime, .1);
      }
      if(scanning && focused >= 0 && !flight){
        const st = stations[focused];
        const dwell = 4200 + Math.min(st.text.length, 140)*30;
        if(now-lockedAt > dwell){ if(focused < pieces.length-1) focusOn(focused+1, 1300); else { stopScan(); backOut(); } }
      }
      for(const b of billboards) b.quaternion.copy(camera.quaternion);
      for(const p of pieces){
        const d = camera.position.distanceTo(p.mesh.position);
        const home = p.st.kind === 'home';
        const near = 1-Math.min(1, Math.max(0, (d-22)/42));
        const isOn = p.i === focused, isHov = p.i === hovered;
        const farReveal = p.st.kind === 'photo' ? .64 : .1;
        const revealT = home || isOn || isHov ? 1 : farReveal + near*(1-farReveal);
        let opacityT = 1;
        if(focused >= 0) opacityT = isOn ? 1 : Math.abs(p.i-focused) === 1 ? .05 : .012;
        else if(boarded) opacityT = home && delivering ? 1 : .28;
        else if(pilot?.selecting) opacityT = isHov || pilot.cands.includes(p.i) ? 1 : .22; // the chosen few stay lit
        else if(hovered > 0 && !isHov) opacityT = .4;
