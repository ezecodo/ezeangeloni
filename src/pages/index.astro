    function updateShip(now: number, dt: number){
      if(!ship) return 0;
      const s = ship;
      const hidden = s.mode === 'away' || (focused >= 0 && s.mode !== 'cruise');
      s.group.visible = !hidden;
      s.trail.visible = s.kind === 'ship' && focused < 0 && s.peek < .05;
      camera.updateMatrixWorld(); // the screen label must read this frame's camera, not the last one
      rig.position.copy(camera.position);
      rig.quaternion.copy(camera.quaternion);
      rig.updateMatrixWorld(true);
      let energy = 0;
      if(s.mode === 'cruise'){
        if(!reduced) s.tau += dt*(s.kind === 'balloon' ? .55 : 1); // a balloon drifts
        placeShip();
        const grow = Math.min(1, (now-s.spawn)/900);
        const want = focused >= 0 && !flight ? 1 : 0;
        s.peek += (want-s.peek)*(1-Math.exp(-dt*(want ? 2.4 : 2.8)));
        if(!want && s.peek < .002) s.peek = 0;
        if(focused >= 0) s.peekFrom = focused;
        const e = s.peek*s.peek*(3-2*s.peek);
        if(s.peek > 0) peekOut(s, e, now);
        s.group.scale.setScalar(s.scale*(1-Math.pow(1-grow, 3))*(1-e*.56));
      } else if(s.mode === 'launch' && s.kind === 'balloon'){
        // the balloon lets its words go: one light at a time, they fall down to the logo and the balloon rises, lighter
        const e = (now-s.t0)/1000, travel = DELIVERY.balloon - 10*LET_GO;
        const up = 1-Math.exp(-e*.7);
        s.group.position.copy(s.p0).add(new THREE.Vector3(0, up*RISE, 0));
        s.group.quaternion.copy(upright(now*.0002));
        let arrived = 0;
        s.drops.forEach((d, k) => {
          const b = s.bulbs[k], u = reduced ? 1 : Math.max(0, Math.min(1, (e-k*LET_GO)/travel));
          if(u > 0 && b.parent === s.group){ scene.attach(b); playNote(NOTES[k % NOTES.length]); }
          if(b.parent === s.group) return;
          const q = u*u*(3-2*u), r = 1-q;
          b.position.copy(d.from).multiplyScalar(r*r).addScaledVector(d.ctrl, 2*r*q); // the logo is at the origin
          b.position.x += Math.sin(u*Math.PI*3 + k)*Math.sin(Math.PI*u)*1.2; // swaying as it falls
          b.scale.setScalar(s.scale*(1 + 2.4*Math.min(1, u*5)*(1-u*u))); // brightest while falling, small again as it lands
          b.visible = u < 1;
          if(u >= 1) arrived++;
        });
        energy = up > .9 ? .1 : .25;
        if(arrived === 11) impact(now);
      } else if(s.mode === 'launch'){
        // the message is for Eze: a banked run across the universe straight into the logo
        const e = (now-s.t0)/1000, k = Math.min(1, e/DELIVERY.ship), q = reduced ? 1 : Math.pow(k, 2.3), r = 1-q;
        const pos = s.p0.clone().multiplyScalar(r*r).addScaledVector(s.ctrl, 2*r*q);
        const tan = s.ctrl.clone().multiplyScalar(2*r-2*q).addScaledVector(s.p0, -2*r);
        s.group.position.copy(pos);
        if(tan.lengthSq() > 1e-4) s.group.lookAt(pos.clone().add(tan));
        const size = s.scale*(1-Math.max(0, (k-.74)/.26));
        s.group.scale.set(size, size, size*(1 + k*k*3.2));
        energy = Math.sin(Math.PI*k)*.6;
        if(k >= 1 || reduced) impact(now);
      } else if(s.mode === 'away' && !boarded && now-s.t0 > 5000){
        s.mode = 'cruise';
        s.lit = 0; s.over = false; s.v = 0; s.spawn = now;
        rig.attach(s.group);
        rig.attach(s.trail);
        s.group.rotation.set(0,0,0);
        s.bulbs.forEach((b, k) => { s.group.add(b); b.position.copy(s.home[k]); b.quaternion.identity(); b.scale.setScalar(1); b.visible = true; });
        s.drops = [];
        s.tau += 20; // comes back somewhere else
        resetTrail();
      }
      if(impactAt){
        const e = (now-impactAt)/1000;
        logoPulse = novaImpact ? 0 : Math.exp(-e*1.5);
        energy = Math.max(energy, Math.exp(-e*4)*.9);
        if(burst && shock){
          const grow = 1-Math.exp(-e*2.2);
          burst.scale.setScalar(grow + .02);
          (burst.material as THREE.PointsMaterial).opacity = Math.max(0, 1-e/2.6);
          shock.scale.set(2 + grow*90, 2 + grow*90, 1);
          (shock.material as THREE.MeshBasicMaterial).opacity = Math.max(0, 1-e/1.5);
          if(e > 2.6){ burst.visible = false; shock.visible = false; impactAt = 0; logoPulse = 0; }
        }
      }
      const idle = s.mode === 'cruise' ? Math.floor(now*.006) % 11 : -1;
      s.lamps.forEach((row, k) => row.forEach(m => {
        const c = s.over ? hexRgb('#ff3f3f') : hexRgb(COLORS[k % COLORS.length]);
        const on = s.over ? (Math.floor(now*.008) % 2 ? 1.4 : .2) : k < s.lit ? 1.7 : k === idle ? 1 : .1;
        m.color.setRGB(c[0]*on, c[1]*on, c[2]*on);
        const g = s.bulbs[k]?.parent === s.group ? .22 : .6; // a soft halo while hanging, a bright one while falling
        s.bulbs[k]?.userData.glow?.color.setRGB(c[0]*on*g, c[1]*on*g, c[2]*on*g);
      }));
      const full = s.lit === 11 && !s.over;
      let power = s.mode === 'launch' ? 9 : full ? 3.6 : 1.5;
      if(s.kind === 'balloon'){
        // the burner fires in bursts, steady once the eleven words are aboard, a long blast when letting go
        const blast = Math.pow(Math.max(0, Math.sin(now*.0007)), 14);
        power = s.mode === 'launch' ? 1.2 + 4*Math.exp(-(now-s.t0)/900) : full ? 2.6 : .5 + blast*2.2;
        swayGarland(s, now);
        // the envelope glows from inside with each burst, warmest at full burn
        const heat = Math.min(1, (power-.5)/3);
        s.skin.forEach(({ m, base }) => m.color.copy(base).multiplyScalar(1 + heat*2.6).lerp(new THREE.Color(0xff9f1c), heat*.12));
      }
      const flame = (s.kind === 'balloon' ? .55 : 1)*power*(1 + .16*Math.sin(now*.05) + .08*Math.sin(now*.083));
      s.engine.scale.set(flame, flame, 1);
      s.engine.quaternion.copy(s.group.quaternion).invert().multiply(camera.quaternion);

      const p = s.trail.geometry.attributes.position as THREE.BufferAttribute;
      (p.array as Float32Array).copyWithin(3, 0, (TRAIL-1)*3);
      const at = s.group.getWorldPosition(new THREE.Vector3());
      const tip = s.trail.worldToLocal(at.clone());
      p.setXYZ(0, tip.x, tip.y, tip.z);
      if(s.peek > .05) for(let i = 1; i < TRAIL; i++) p.setXYZ(i, tip.x, tip.y, tip.z); // no trail while waiting
      p.needsUpdate = true;

      const v = at.project(camera);
      s.sx = (v.x+1)/2*window.innerWidth;
      s.sy = (1-v.y)/2*window.innerHeight;
      s.onScreen = v.z < 1 && Math.abs(v.x) < .96 && Math.abs(v.y) < .9;
      const waiting = focused >= 0 && s.peek > .6;
      const show = s.onScreen && s.mode === 'cruise' && (focused < 0 || waiting) && !boarded && !flight;
      shipTag.classList.toggle('show', show);
      const label = focused >= 0 ? 'keep travelling' : 'leave a word';
      if(shipTag.textContent !== label) shipTag.textContent = label;
      if(show){
        const x = Math.max(76, Math.min(window.innerWidth-76, s.sx));
        shipTag.style.transform = `translate(${x}px, ${s.sy}px) translate(-50%, ${s.kind === 'balloon' ? (waiting ? 44 : 60) : (waiting ? 52 : 34)}px)`;
      }
      return energy;
    }
    function board(){
      if(boarded) return;
      touched();
      if(!renderer || !ship){ cockpit.classList.add('flat', 'open'); boarded = true; resetForm(); return; }
      if(focused >= 0) backOutNow();
      boarded = true;
      hoverShip = false;
      ship.mode = 'board';
      ship.peek = 0;
      ship.group.scale.setScalar(ship.scale);
      resetForm();
      if(controls){ controls.enabled = false; overviewPos.copy(camera.position); }
      // from here on it's a physical object in the universe, parked where you caught it
      scene.attach(ship.group);
      scene.attach(ship.trail);
      if(ship.kind === 'balloon') ship.group.quaternion.copy(upright(ship.tau*.2)); // upright in the world, not in the camera that carried it
      ship.group.getWorldDirection(ship.dir);
      const p = ship.group.position, t = ship.dir;
      const side = t.clone().cross(new THREE.Vector3(0,1,0)).normalize();
      if(side.dot(camera.position.clone().sub(p)) < 0) side.negate();
      const up = side.clone().cross(t).normalize();
      if(up.y < 0) up.negate();
      const tall = ship.kind === 'balloon'; // the balloon hangs its lights low: frame it a bit further and lower
      const d = (tall ? 19 : 17.4)*Math.max(1, Math.pow(1.2/camera.aspect, .5));
      document.body.classList.add('aboard');
      flyTo(p.clone().addScaledVector(side, d).addScaledVector(up, 1.6), p.clone().addScaledVector(up, tall ? 2.4 : 4.4), 1900, () => {
        cockpit.classList.add('open');
        setTimeout(() => msgInput.focus(), 200);
      });
    }
    function backOutNow(){
      const p = pieces[focused];
      p.mat.depthTest = true;
      p.mesh.renderOrder = 0;
      focused = -1;
      document.body.classList.remove('focus');
      btnBack.hidden = true;
      showMeta(0);
    }
    function leaveShip(){
      if(!boarded) return;
      boarded = false;
      cockpit.classList.remove('open', 'flat');
      document.body.classList.remove('aboard');
      if(!renderer || !ship) return;
      const stayed = ship.mode === 'board';
      if(stayed){ ship.mode = 'parked'; setLit(0); }
      flyTo(overviewPos.clone(), CENTER.clone(), 1700, () => {
        if(controls){ controls.target.copy(CENTER); controls.enabled = true; }
        if(stayed && ship){ ship.mode = 'away'; ship.t0 = performance.now()-3800; }
      });
    }
    // A set past its span explodes once per visitor; after that only the nebula remains.
    function supernovas(){
      const p = pieces.find(q => q.stage === 'supernova remnant' && !localStorage.getItem('nova:'+q.st.set?.slug));
      if(!p || !burst || !shock || reduced) return;
      try { localStorage.setItem('nova:'+p.st.set!.slug, '1'); } catch {}
      burst.position.copy(p.mesh.position);
      shock.position.copy(p.mesh.position);
      burst.visible = shock.visible = true;
      impactAt = performance.now();
      novaImpact = true;
      playNote(NOTES[0]/2);
    }
    function impact(now: number){
      if(!ship) return;
      ship.mode = 'away';
      ship.t0 = now;
      impactAt = now;
      novaImpact = false;
      burst?.position.set(0,0,0);
      shock?.position.set(0,0,0);
      logoPulse = 1;
      if(burst && shock && !reduced){ burst.visible = true; shock.visible = true; }
      if(audioCtx && masterGain){
        const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), g = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(130, t);
        osc.frequency.exponentialRampToValueAtTime(34, t+.9);
        g.gain.setValueAtTime(1.3, t);
        g.gain.exponentialRampToValueAtTime(.001, t+1.1);
        osc.connect(g); g.connect(masterGain);
        osc.start(t); osc.stop(t+1.1);
      }
      for(let k = 0; k < 11; k++) setTimeout(() => playNote(NOTES[k % NOTES.length]*2), 90 + k*85); // the eleven words, one last time
    }
    function launch(){
      msgForm.style.display = 'none';
      delivering = true;
      const kind = ship?.kind ?? craft, T = DELIVERY[kind];
      if(ship && kind === 'balloon'){
        ship.mode = 'launch';
        ship.t0 = performance.now();
        ship.p0.copy(ship.group.position);
        ship.group.updateMatrixWorld(true);
        ship.drops = ship.bulbs.map((b, k) => {
          const from = b.getWorldPosition(new THREE.Vector3());
          const ctrl = from.clone().multiplyScalar(.5).add(new THREE.Vector3(rnd(-3, 3), -9 - k*.5, rnd(-3, 3)));
          return { from, ctrl, gone:false };
        });
        // watch from the side of its fall: the balloon on one edge, the logo on the other
        const p0 = ship.p0, span = Math.max(8, p0.length());
        // frame from the logo (origin) to the top of the risen balloon
        const top = p0.clone().add(new THREE.Vector3(0, RISE + 7.6*ship.scale, 0));
        const mid = top.clone().multiplyScalar(.5);
        const across = p0.clone().cross(new THREE.Vector3(0, 1, 0));
        if(across.lengthSq() < 1e-4) across.set(1, 0, 0);
        across.normalize();
        if(across.dot(camera.position.clone().sub(mid)) < 0) across.negate();
        const D = Math.max(34, span*1.25/Math.min(camera.aspect, 1.5), (Math.abs(top.y) + 10)*1.6);
        flyTo(mid.clone().addScaledVector(across, D).add(new THREE.Vector3(0, 3, 0)), mid.clone().add(new THREE.Vector3(0, 3, 0)), 1600);
      } else if(ship){
        ship.mode = 'launch';
        ship.t0 = performance.now();
        ship.p0.copy(ship.group.position);
        ship.ctrl.copy(ship.p0).addScaledVector(ship.dir, 34).add(new THREE.Vector3(0, -8, 0));
        // pull back to watch it land: the logo sits low in frame, under the thank-you
        const side = ship.p0.lengthSq() > 1 ? ship.p0.clone().normalize() : new THREE.Vector3(0, 0, 1);
        flyTo(side.multiplyScalar(50).add(new THREE.Vector3(0, 7, 0)), new THREE.Vector3(0, 6, 0), T*1000-300);
      }
      if(audioCtx && masterGain && kind === 'balloon'){
        // the burner: one long breath of filtered noise
        const t = audioCtx.currentTime, len = 1.8;
        const buf = audioCtx.createBuffer(1, audioCtx.sampleRate*len, audioCtx.sampleRate), data = buf.getChannelData(0);
        for(let i = 0; i < data.length; i++) data[i] = Math.random()*2 - 1;
        const src = audioCtx.createBufferSource(), f = audioCtx.createBiquadFilter(), g = audioCtx.createGain();
        src.buffer = buf;
        f.type = 'bandpass'; f.Q.value = .7;
        f.frequency.setValueAtTime(900, t);
        f.frequency.exponentialRampToValueAtTime(300, t+len);
        g.gain.setValueAtTime(.001, t);
        g.gain.exponentialRampToValueAtTime(.9, t+.12);
        g.gain.exponentialRampToValueAtTime(.001, t+len);
        src.connect(f); f.connect(g); g.connect(masterGain);
        src.start(t); src.stop(t+len);
      } else if(audioCtx && masterGain){
        const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), g = audioCtx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(55, t);
        osc.frequency.exponentialRampToValueAtTime(1400, t+T);
        g.gain.setValueAtTime(.001, t);
        g.gain.exponentialRampToValueAtTime(.42, t+T-.1);
        g.gain.exponentialRampToValueAtTime(.001, t+T+.05);
        osc.connect(g); g.connect(masterGain);
        osc.start(t); osc.stop(t+T+.05);
      }
      setTimeout(() => { msgThanks.style.display = 'block'; }, T*1000+500);
      setTimeout(() => { delivering = false; leaveShip(); }, T*1000+4300);
    }
    // Swap the craft in flight (hidden key `b`): the same route, the other body.
    function swapCraft(){
      craft = craft === 'ship' ? 'balloon' : 'ship';
      craftText();
      if(!ship || boarded || ship.mode !== 'cruise') return;
      const old = ship.group, parent = old.parent ?? rig;
      parent.remove(old);
      old.traverse((o: THREE.Object3D) => { const m = o as THREE.Mesh; m.geometry?.dispose(); (m.material as THREE.Material | undefined)?.dispose(); });
      const body = buildBody(craft);
      parent.add(body.group);
      Object.assign(ship, body, { drops:[], lit:0, over:false, spawn:performance.now() });
      resetTrail();
      playNote(NOTES[craft === 'balloon' ? 1 : 4]);
    }
    function craftText(){
      const balloon = craft === 'balloon';
      $('msg-close').textContent = balloon ? 'leave balloon ✕' : 'leave ship ✕';
      $('msg-subtitle').textContent = balloon ? 'this balloon carries exactly 11 words. it will let them go.' : 'this ship carries exactly 11 words. make them count.';
      msgSend.textContent = balloon ? 'let go' : 'launch';
    }

    function backOut(){
      if(focused < 0) return;
      const p = pieces[focused];
      p.mat.depthTest = true;
      p.mesh.renderOrder = 0;
      focused = -1;
      document.body.classList.remove('focus');
      btnBack.hidden = true;
      lamp.classList.remove('on');
      showMeta(0);
      const to = overviewPos.lengthSq() ? overviewPos.clone() : new THREE.Vector3(0, overviewR*.34, overviewR);
      flyTo(to, CENTER.clone(), 1700, () => { if(controls){ controls.target.copy(CENTER); controls.enabled = true; } });
      const url = new URL(location.href);
      url.hash = '';
      history.replaceState(null, '', url.toString());
    }
    function stepFocus(d: number){
      const from = focused < 0 ? (d > 0 ? 0 : pieces.length) : focused;
      const to = Math.max(1, Math.min(pieces.length-1, from+d));
      if(to !== focused) focusOn(to, 1100);
    }
    function showMeta(i: number){
      const st = stations[i];
      shown = i;
      const home = st.kind === 'home';
      metaId.textContent = home
        ? `${total} señales`
        : `Nº ${String(st.n).padStart(3,'0')}/${total} · ${st.date.replaceAll('-','·')} · ${pieces[i]?.stage || ''}`;
      metaCap.textContent = home ? 'pasado observado' : (st.kind === 'text' || st.flood) && focused === i ? '' : st.text;
      act.hidden = !(st.kind === 'set' && focused === i);
      nowEl.textContent = home ? 'Eze Angeloni, Cronovisor' : `${st.date}: ${st.text || 'foto sin título'}`;
    }

    // ── Input ─────────────────────────────────────────────
    const ray = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    let pointerFresh = false, press: { x: number, y: number, t: number } | null = null, wheelAt = 0;
    function pick(){
      ray.setFromCamera(ndc, camera);
      const hit = ray.intersectObjects(pieces.slice(1).map(p => p.mesh), false)[0];
      return hit ? hit.object.userData.i as number : -1;
    }
    function setNdc(e: PointerEvent){
      ndc.set(e.clientX/window.innerWidth*2-1, -(e.clientY/window.innerHeight)*2+1);
    }
    screen.addEventListener('pointermove', e => {
      if(e.pointerType !== 'mouse') return;
      setNdc(e);
      pointerFresh = true;
    });
    screen.addEventListener('pointerdown', e => {
      press = { x:e.clientX, y:e.clientY, t:performance.now() };
      touched();
    });
    window.addEventListener('pointerup', e => {
      if(!press) return;
      const dx = e.clientX-press.x, dy = e.clientY-press.y, quick = performance.now()-press.t < 500;
      press = null;
      if(e.target !== screen || boarded) return;
      if(focused >= 0 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)){ stepFocus(dx < 0 ? 1 : -1); return; }
      if(Math.hypot(dx, dy) > 7 || !quick) return;
      if(focused < 0 && ship && ship.mode === 'cruise' && Math.hypot(e.clientX-ship.sx, e.clientY-ship.sy) < 56){ board(); return; }
      if(focused >= 0 && ship && ship.peek > .5 && Math.hypot(e.clientX-ship.sx, e.clientY-ship.sy) < 64){ backOut(); return; }
      setNdc(e);
      const i = pick();
      if(focused < 0){ if(i > 0) focusOn(i); }
      else if(i !== focused) { if(i > 0) focusOn(i, 1100); else backOut(); }
    });
    screen.addEventListener('wheel', e => {
      touched();
      if(focused < 0 || boarded) return;
      const now = performance.now();
      if(now-wheelAt < 650 || Math.abs(e.deltaY)+Math.abs(e.deltaX) < 8) return;
      wheelAt = now;
      stepFocus((Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX) > 0 ? 1 : -1);
    }, { passive:true });
    btnBack.addEventListener('click', () => { touched(); backOut(); });

    window.addEventListener('keydown', e => {
      if(e.key === 'Escape'){
        if(boarded){ if(!delivering) leaveShip(); }
        else if(anyOpen()) closeSheets();
        else { touched(); backOut(); }
        return;
      }
      if(boarded || anyOpen() || e.metaKey || e.ctrlKey || e.altKey) return;
      const tag = (e.target as HTMLElement).tagName;
      if(e.key === ' ' && tag === 'BUTTON') return;
      switch(e.key){
        case 'ArrowDown': case 'ArrowRight': case 'PageDown': case ' ': case 'j': touched(); stepFocus(1); e.preventDefault(); break;
        case 'ArrowUp': case 'ArrowLeft': case 'PageUp': case 'k': touched(); stepFocus(-1); e.preventDefault(); break;
        case 'Home': touched(); backOut(); e.preventDefault(); break;
        case 'End': touched(); focusOn(pieces.length-1); e.preventDefault(); break;
        case 'i': openIndex(); break;
        case 't': board(); break;
        case 'b': swapCraft(); break;
        case 'm': toggleSound(); break;
        case '1': playSong(); break;
      }
    });

    function resize(){
      if(!renderer) return;
      const W = window.innerWidth, H = window.innerHeight;
      renderer.setPixelRatio(DPR);
      renderer.setSize(W, H, false);
      camera.aspect = W/H;
      camera.updateProjectionMatrix();
      overviewR = 112*Math.max(1, Math.pow(1.2/camera.aspect, .8));
      if(controls) controls.maxDistance = overviewR*1.5;
      composer?.setPixelRatio(DPR);
      composer?.setSize(W, H);
    }
    window.addEventListener('resize', resize);

    let lastFrame = 0, calm = 0, slowAvg = 1/60, lowPower = false;
    function frame(now: number){
      requestAnimationFrame(frame);
      if(!renderer || document.hidden || anyOpen()){ lastFrame = now; return; }
      const dt = Math.min(now-lastFrame, 100)/1000;
      lastFrame = now;
      const ease = 1-Math.exp(-dt*6);
      // slow device: drop bloom and resolution rather than the frame rate
      slowAvg = slowAvg*.97 + dt*.03;
      if(!lowPower && now > 8000 && slowAvg > .04){
        lowPower = true;
        renderer.setPixelRatio(1);
        composer?.setPixelRatio(1);
      }
      let flightEnergy = 0;
      if(flight){
        const t = Math.min(1, (now-flight.t0)/flight.dur);
        const k = t < .5 ? 4*t*t*t : 1-Math.pow(-2*t+2, 3)/2;
        camera.position.lerpVectors(flight.fromP, flight.toP, k);
        camera.position.y += Math.sin(Math.PI*k)*flight.arc;
        look.lerpVectors(flight.fromL, flight.toL, Math.min(1, k*1.25));
        camera.lookAt(look);
        flightEnergy = Math.sin(Math.PI*t);
        if(t >= 1){ const f = flight; flight = null; f.done?.(); }
      } else if(focused < 0 && controls?.enabled){
        controls.autoRotate = !reduced && now-lastInput > 2600;
        controls.update();
        look.copy(controls.target);
      }
      flightEnergy = Math.max(flightEnergy, updateShip(now, dt));
      if(pointerFresh && ship && focused < 0 && !flight && !boarded){
        const near = ship.mode === 'cruise' && Math.hypot((ndc.x+1)/2*window.innerWidth-ship.sx, (1-ndc.y)/2*window.innerHeight-ship.sy) < 56;
        if(near !== hoverShip){
          hoverShip = near;
          shipTag.classList.toggle('hot', near);
          metaCap.textContent = near ? 'leave a word' : 'pasado observado';
          if(near) playNote(NOTES[4]);
        }
      }
      if(pointerFresh && focused < 0 && !flight && !boarded && pieces.length){
        pointerFresh = false;
        const i = pick();
        if(i !== hovered){
          hovered = i;
          if(i > 0){ showMeta(i); playNote(NOTES[pieces[i].st.n % NOTES.length]); }
          else showMeta(0);
        }
      } else if(focused >= 0 || flight || boarded) hovered = -1;

      if(staticGain && staticFilter && audioCtx){
        staticGain.gain.setTargetAtTime(flightEnergy*.13, audioCtx.currentTime, .05);
        staticFilter.frequency.setTargetAtTime(500 + camera.position.length()*18, audioCtx.currentTime, .1);
      }
      if(scanning && focused >= 0 && !flight){
        const st = stations[focused];
        const dwell = 4200 + Math.min(st.text.length, 140)*30;
        if(now-lockedAt > dwell){ if(focused < pieces.length-1) focusOn(focused+1, 1300); else { stopScan(); backOut(); } }
      }
      for(const b of billboards) b.quaternion.copy(camera.quaternion);
      for(const p of pieces){
        const d = camera.position.distanceTo(p.mesh.position);
        const home = p.st.kind === 'home';
        const near = 1-Math.min(1, Math.max(0, (d-22)/42));
        const isOn = p.i === focused, isHov = p.i === hovered;
        const farReveal = p.st.kind === 'photo' ? .64 : .1;
        const revealT = home || isOn || isHov ? 1 : farReveal + near*(1-farReveal);
        let opacityT = 1;
        if(focused >= 0) opacityT = isOn ? 1 : Math.abs(p.i-focused) === 1 ? .05 : .012;
        else if(boarded) opacityT = home && delivering ? 1 : .28;
        else if(hovered > 0 && !isHov) opacityT = .4;
        p.reveal += (revealT-p.reveal)*ease;
        p.opacity += (opacityT-p.opacity)*ease;
        p.grow += ((isHov ? 2.1 : 1)-p.grow)*ease;
        // far away it is a star; close up, or under the cursor, the star opens into the original piece
        const starT = home || isOn || isHov ? 0 : 1-Math.min(1, Math.max(0, (near-.1)/.62));
        p.starMix += (starT-p.starMix)*ease;
        p.mesh.scale.set(p.w*p.grow, p.h*p.grow, 1);
        p.mat.uniforms.uReveal.value = p.reveal;
        p.mat.uniforms.uOpacity.value = p.opacity*(1-p.starMix);
        if(p.starMat){
          const u = p.starMat.uniforms;
          u.uTime.value = now*.001;
          u.uOpacity.value = p.opacity*p.starMix;
          u.uBright.value = p.bright*(1 + (reduced ? 0 : .28*Math.sin(now*.001*p.beat*Math.PI*2 + p.st.n)));
        }
        p.mat.uniforms.uGain.value = home ? 1 + logoPulse*1.8 : isOn || isHov ? 1 : .74;
        if(p.halo){
          const s = Math.max(p.w, p.h)*(.85 + .05*Math.sin(now*.0016));
          p.halo.scale.set(s, s, 1);
          (p.halo.material as THREE.MeshBasicMaterial).opacity = p.opacity*.7;
        }
      }
      calm += ((focused >= 0 ? 1 : 0)-calm)*ease; // 1 = at a piece, nothing may touch it
      const dim = 1-calm*.72;
      if(thread){
        const u = (thread.material as THREE.ShaderMaterial).uniforms;
        u.uTime.value = now*.001;
        u.uDim.value = 1-calm*.9;
      }
      if(dust) (dust.material as THREE.PointsMaterial).opacity = .8*(1-calm*.85);
      (nebula.material as THREE.ShaderMaterial).uniforms.uDim.value = dim;
      if(!reduced){ stars.rotation.y += dt*.004; nebula.rotation.y += dt*.0015; }
      if(composer && bloom && lens){
        bloom.strength = BLOOM*(1-calm) + logoPulse*.8;
        bloom.enabled = !lowPower && bloom.strength > .01;
        lens.uniforms.uEnergy.value = reduced ? 0 : flightEnergy;
        lens.uniforms.uGrain.value = 1-calm;
        lens.uniforms.uTime.value = now*.001;
        composer.render();
      }
    }

    // ── Sheets ────────────────────────────────────────────
    const sheets = { index:$('index-sheet'), about:$('about-sheet'), set:$('set-sheet') };
    function openSheet(s: HTMLElement){ stopScan(); hint.hidden = true; s.classList.add('open'); }
    function closeSheets(){
      if(sheets.set.classList.contains('open')) closeSetModal();
      Object.values(sheets).forEach(s => s.classList.remove('open'));
    }
    $('btn-about').addEventListener('click', () => openSheet(sheets.about));
    $('about-close').addEventListener('click', closeSheets);
    $('btn-index').addEventListener('click', openIndex);
    $('index-close').addEventListener('click', closeSheets);
    $('home').addEventListener('click', () => { touched(); backOut(); });

    function openIndex(){ openSheet(sheets.index); }
    function buildIndex(){
      const grid = $('index-grid');
      grid.innerHTML = '';
      stations.forEach((st, i) => {
        if(st.kind === 'home') return;
        const cell = document.createElement('button');
        cell.className = 'cell';
        if(st.src){
          const img = document.createElement('img');
          img.loading = 'lazy'; img.alt = st.text; img.src = st.src;
          cell.appendChild(img);
        } else {
          const tx = document.createElement('span');
          tx.className = 'cell-text';
          tx.textContent = st.text;
          tx.style.background = st.kind === 'set' ? 'linear-gradient(135deg,#ff6eb4,#c77dff)' : st.tint;
          cell.appendChild(tx);
        }
        const id = document.createElement('span');
        id.className = 'cell-id';
        id.textContent = `${String(st.n).padStart(3,'0')} · ${st.date}${st.src && st.text ? ' · ' + st.text : ''}`;
        cell.appendChild(id);
        cell.addEventListener('click', () => { closeSheets(); touched(); focusOn(i); });
        grid.appendChild(cell);
      });
    }

    // Set / DJ audio player
    const setArtwork = $('set-artwork');
    const setArtworkImg = $('set-artwork-img') as HTMLImageElement;
    const setTitle = $('set-title');
    const setDate = $('set-date');
    const setAudio = $('set-audio') as HTMLAudioElement;
    const setPlay = $('set-play') as HTMLButtonElement;
    const setPlayIcon = $('set-play-icon') as unknown as SVGElement;
    const setSeek = $('set-seek');
    const setSeekFill = $('set-seek-fill');
    const setSeekBuffer = $('set-seek-buffer');
    const setSeekThumb = $('set-seek-thumb');
    const setTimeCurrent = $('set-time-current');
    const setTimeTotal = $('set-time-total');
    const setCopy = $('set-copy') as HTMLButtonElement;
    const setTracklist = $('set-tracklist');
    let currentSet: SetMeta | null = null;
    let activeTrackIdx = -1;
    const PLAY_SVG = '<path d="M8 5v14l11-7z"/>';
    const PAUSE_SVG = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';
    function fmtTime(s: number){
      if(!isFinite(s) || s < 0) return '0:00';
      const m = Math.floor(s/60), sec = Math.floor(s%60);
      return `${m}:${sec.toString().padStart(2,'0')}`;
    }
    function syncPlayIcon(){
      setPlayIcon.innerHTML = setAudio.paused ? PLAY_SVG : PAUSE_SVG;
      setPlay.setAttribute('aria-label', setAudio.paused ? 'play' : 'pause');
    }
    function renderTracklist(meta: SetMeta){
      const tl = meta.tracklist || [];
      setTracklist.innerHTML = '';
      activeTrackIdx = -1;
      if(!tl.length){ setTracklist.classList.remove('show'); return; }
      tl.forEach((t, i) => {
        const row = document.createElement('div');
        row.className = 'tl-row';
        row.dataset.idx = String(i);
        row.innerHTML = `<span class="tl-time">${fmtTime(t.at)}</span><span class="tl-label"></span>`;
        (row.querySelector('.tl-label') as HTMLElement).textContent = t.label;
        row.addEventListener('click', () => { setAudio.currentTime = t.at; if(setAudio.paused) setAudio.play().catch(()=>{}); });
        setTracklist.appendChild(row);
      });
      setTracklist.classList.add('show');
    }
    function updateActiveTrack(){
      if(!currentSet?.tracklist?.length) return;
      const t = setAudio.currentTime;
      let idx = -1;
      for(let i = 0; i < currentSet.tracklist.length; i++){
        if(currentSet.tracklist[i].at <= t) idx = i; else break;
      }
      if(idx !== activeTrackIdx){
        activeTrackIdx = idx;
        const rows = setTracklist.querySelectorAll('.tl-row');
        rows.forEach((r, i) => r.classList.toggle('active', i === idx));
      }
    }
    function openSetModal(meta: SetMeta){
      currentSet = meta;
      setTitle.textContent = meta.title;
      const meta_extras: string[] = [];
      if (meta.date) meta_extras.push(meta.date);
      if (meta.bpm && meta.bpm > 0) meta_extras.push(meta.bpm.toFixed(1) + ' BPM');
      if (meta.musicalKey) meta_extras.push(meta.musicalKey);
      setDate.textContent = meta_extras.join(' · ');
      if(meta.artwork){
        setArtworkImg.src = meta.artwork;
        setArtwork.classList.add('show');
      } else {
        setArtwork.classList.remove('show');
        setArtworkImg.src = '';
      }
      renderTracklist(meta);
      setAudio.src = meta.audio;
      setAudio.currentTime = 0;
      setSeekFill.style.width = '0%';
      setSeekBuffer.style.width = '0%';
      setSeekThumb.style.left = '0%';
      setTimeCurrent.textContent = '0:00';
      setTimeTotal.textContent = '--:--';
      // restore last position from localStorage
      try {
        const saved = localStorage.getItem('set:'+meta.slug);
        if(saved){
          const t = parseFloat(saved);
          if(isFinite(t) && t > 5) setAudio.currentTime = t;
        }
      } catch {}
      setCopy.textContent = 'copy link';
      setCopy.classList.remove('copied');
      syncPlayIcon();
      openSheet(sheets.set);
      // push slug to URL without reload, so refreshing keeps the player open
      try {
        const u = new URL(location.href);
        u.searchParams.set('set', meta.slug);
        history.replaceState(null, '', u.toString());
      } catch {}
    }
    function closeSetModal(){
      sheets.set.classList.remove('open');
      setAudio.pause();
      syncPlayIcon();
      try {
        const u = new URL(location.href);
        u.searchParams.delete('set');
        history.replaceState(null, '', u.toString());
      } catch {}
    }
    setPlay.addEventListener('click', () => {
      if(setAudio.paused) setAudio.play().catch(()=>{}); else setAudio.pause();
      syncPlayIcon();
    });
    setAudio.addEventListener('play', syncPlayIcon);
    setAudio.addEventListener('pause', syncPlayIcon);
    setAudio.addEventListener('loadedmetadata', () => {
      setTimeTotal.textContent = fmtTime(setAudio.duration);
    });
    setAudio.addEventListener('timeupdate', () => {
      if(!setAudio.duration) return;
      const pct = (setAudio.currentTime / setAudio.duration) * 100;
      setSeekFill.style.width = pct + '%';
      setSeekThumb.style.left = pct + '%';
      setTimeCurrent.textContent = fmtTime(setAudio.currentTime);
      updateActiveTrack();
      if(currentSet){
        try { localStorage.setItem('set:'+currentSet.slug, String(setAudio.currentTime)); } catch {}
      }
    });
    setAudio.addEventListener('progress', () => {
      if(!setAudio.duration || setAudio.buffered.length === 0) return;
      const end = setAudio.buffered.end(setAudio.buffered.length - 1);
      setSeekBuffer.style.width = ((end / setAudio.duration) * 100) + '%';
    });
    setAudio.addEventListener('ended', () => {
      if(currentSet){ try { localStorage.removeItem('set:'+currentSet.slug); } catch {} }
      syncPlayIcon();
    });
    let seekDragging = false;
    function seekTo(clientX: number){
      const rect = setSeek.getBoundingClientRect();
      const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      if(setAudio.duration){
        setAudio.currentTime = pct * setAudio.duration;
        setSeekFill.style.width = (pct*100)+'%';
        setSeekThumb.style.left = (pct*100)+'%';
      }
    }
    setSeek.addEventListener('pointerdown', e => {
      seekDragging = true;
      setSeek.classList.add('dragging');
      setSeek.setPointerCapture(e.pointerId);
      seekTo(e.clientX);
    });
    setSeek.addEventListener('pointermove', e => { if(seekDragging) seekTo(e.clientX); });
    setSeek.addEventListener('pointerup', e => {
      seekDragging = false;
      setSeek.classList.remove('dragging');
      try { setSeek.releasePointerCapture(e.pointerId); } catch {}
    });
    setCopy.addEventListener('click', async () => {
      if(!currentSet) return;
      const url = `${location.origin}${location.pathname}?set=${encodeURIComponent(currentSet.slug)}`;
      try {
        await navigator.clipboard.writeText(url);
        setCopy.textContent = 'copied ✦';
        setCopy.classList.add('copied');
        setTimeout(() => { setCopy.textContent = 'copy link'; setCopy.classList.remove('copied'); }, 1800);
      } catch {
        setCopy.textContent = 'copy failed';
      }
    });
    $('set-close').addEventListener('click', closeSheets);
    act.addEventListener('click', () => { const s = stations[shown]; if(s?.set) openSetModal(s.set); });

    // Message modal
    const msgInput = $('msg-input') as HTMLTextAreaElement;
    const wordCount = $('word-count');
    const msgSend = $('msg-send') as HTMLButtonElement;
    const msgForm = $('msg-form');
    const msgThanks = $('msg-thanks');

    msgInput.addEventListener('input', () => {
      const words = msgInput.value.trim() === '' ? 0 : msgInput.value.trim().split(/\s+/).filter(w=>w.length>0).length;
      wordCount.textContent = `${words} / 11`;
      wordCount.className = words === 11 ? 'full' : words > 11 ? 'over' : '';
      setLit(words);
      msgSend.disabled = words !== 11;
    });

    msgSend.addEventListener('click', async () => {
      msgSend.disabled = true;
      msgSend.textContent = craft === 'balloon' ? 'lighting the burner...' : 'igniting...';
      try {
        const res = await fetch('https://n8n.ezeangeloni.xyz/webhook/mensaje', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mensaje: msgInput.value.trim() })
        });
        if(res.ok){
          launch();
        } else {
          wordCount.textContent = 'something went wrong, try again';
        }
      } catch(e) {
        wordCount.textContent = 'connection error';
      }
      craftText();
      msgSend.disabled = false;
    });

    function resetForm(){
      msgInput.value = ''; wordCount.textContent = '0 / 11'; wordCount.className = '';
      msgSend.disabled = true; msgForm.style.display = 'block'; msgThanks.style.display = 'none';
      setLit(0);
    }
    craftText();
    shipTag.addEventListener('click', () => { if(focused >= 0){ touched(); backOut(); } else board(); });
    $('msg-close').addEventListener('click', () => { if(!delivering) leaveShip(); });

    const cursor = $('cursor');
    window.addEventListener('mousemove', e => { cursor.style.left = e.clientX+'px'; cursor.style.top = e.clientY+'px'; });
    if(isTouch) hint.textContent = 'drag · tap a signal';

    // ── Boot ──────────────────────────────────────────────
    const logoImg = new Image();
    logoImg.onload = () => { logo = logoImg; if(pieces.length) cards(); };
    logoImg.src = '/eZe.svg';
    const fontsReady = Promise.all([
      document.fonts.load("italic 300 40px 'Cormorant Garamond'"),
      document.fonts.load("300 40px 'Cormorant Garamond'"),
      document.fonts.load("10px 'DM Mono'"),
    ]).catch(() => {});

    Promise.all([
      fetch('/frases.json').then(r => r.json()).catch(() => ({ frases: [] })),
      fetch('/sets.json').then(r => r.json()).catch(() => ({ sets: [] })),
      fontsReady,
    ]).then(([frasesData, setsData]) => {
      buildStations(frasesData.frases || [], setsData.sets || []);
      buildIndex();
      if(!renderer){ // no WebGL: the contact sheet is the whole site
        $('index-close').hidden = true;
        document.body.classList.add('no3d');
        openIndex();
        return;
      }
      resize();
      buildSpace();
      showMeta(0);
      if(controls){
        controls.enableDamping = true; controls.dampingFactor = .06;
        controls.enablePan = false; controls.minDistance = 16;
        controls.autoRotateSpeed = .28; controls.enabled = false;
      }
      const home = new THREE.Vector3(0, overviewR*.34, overviewR);
      const urlSet = new URLSearchParams(location.search).get('set');
      const byHash = parseInt(location.hash.slice(1), 10);
      const i = urlSet
        ? stations.findIndex(s => s.set?.slug === urlSet)
        : stations.findIndex(s => s.n === byHash && s.kind !== 'home');
      if(i > 0){
        camera.position.copy(home);
        overviewPos.copy(home);
        hint.hidden = true;
        focusOn(i, 0);
        if(urlSet) openSetModal(stations[i].set!);
      } else {
        camera.position.set(0, 1, 15);
        look.copy(CENTER);
        camera.lookAt(look);
        flyTo(home, CENTER.clone(), 3200, () => { if(controls){ controls.target.copy(CENTER); controls.enabled = true; } supernovas(); });
      }
      lastInput = performance.now();
      requestAnimationFrame(frame);
    });

    const trapoFab = $('trapo-fab') as HTMLAnchorElement;
    let tfX = rnd(0, Math.max(0, window.innerWidth - trapoFab.offsetWidth));
    const TF_TOP = 50, TF_BOTTOM = 130; // keeps clear of the nav and the readout
    let tfY = rnd(TF_TOP, Math.max(TF_TOP, window.innerHeight - trapoFab.offsetHeight - TF_BOTTOM));
    let tfVx = rnd(0.15, 0.35) * (Math.random() < 0.5 ? -1 : 1);
    let tfVy = rnd(0.15, 0.35) * (Math.random() < 0.5 ? -1 : 1);
    function driveTrapoFab(){
      const w = trapoFab.offsetWidth, h = trapoFab.offsetHeight;
      tfX += tfVx; tfY += tfVy;
      if (tfX < 0) { tfX = 0; tfVx *= -1; }
      if (tfX + w > window.innerWidth) { tfX = window.innerWidth - w; tfVx *= -1; }
      if (tfY < TF_TOP) { tfY = TF_TOP; tfVy *= -1; }
      if (tfY + h > window.innerHeight - TF_BOTTOM) { tfY = window.innerHeight - TF_BOTTOM - h; tfVy *= -1; }
      trapoFab.style.transform = `translate(${tfX}px, ${tfY}px)`;
      requestAnimationFrame(driveTrapoFab);
    }
    if(!reduced) requestAnimationFrame(driveTrapoFab);
    else trapoFab.style.transform = `translate(${tfX}px, ${tfY}px)`;
  </script>
</Layout>
