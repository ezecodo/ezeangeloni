    }

    // Set / DJ audio player
    const setArtwork = $('set-artwork');
    const setArtworkImg = $('set-artwork-img') as HTMLImageElement;
    const setTitle = $('set-title');
    const setDate = $('set-date');
    const setAudio = $('set-audio') as HTMLAudioElement;
    const setPlay = $('set-play') as HTMLButtonElement;
    const setPlayIcon = $('set-play-icon') as unknown as SVGElement;
    const setSeek = $('set-seek');
    const setSeekFill = $('set-seek-fill');
    const setSeekBuffer = $('set-seek-buffer');
    const setSeekThumb = $('set-seek-thumb');
    const setTimeCurrent = $('set-time-current');
    const setTimeTotal = $('set-time-total');
    const setCopy = $('set-copy') as HTMLButtonElement;
    const setTracklist = $('set-tracklist');
    let currentSet: SetMeta | null = null;
    let activeTrackIdx = -1;
    const PLAY_SVG = '<path d="M8 5v14l11-7z"/>';
    const PAUSE_SVG = '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>';
    function fmtTime(s: number){
      if(!isFinite(s) || s < 0) return '0:00';
      const m = Math.floor(s/60), sec = Math.floor(s%60);
      return `${m}:${sec.toString().padStart(2,'0')}`;
    }
    function syncPlayIcon(){
      setPlayIcon.innerHTML = setAudio.paused ? PLAY_SVG : PAUSE_SVG;
      setPlay.setAttribute('aria-label', setAudio.paused ? 'play' : 'pause');
    }
    function renderTracklist(meta: SetMeta){
      const tl = meta.tracklist || [];
      setTracklist.innerHTML = '';
      activeTrackIdx = -1;
      if(!tl.length){ setTracklist.classList.remove('show'); return; }
      tl.forEach((t, i) => {
        const row = document.createElement('div');
        row.className = 'tl-row';
        row.dataset.idx = String(i);
        row.innerHTML = `<span class="tl-time">${fmtTime(t.at)}</span><span class="tl-label"></span>`;
        (row.querySelector('.tl-label') as HTMLElement).textContent = t.label;
        row.addEventListener('click', () => { setAudio.currentTime = t.at; if(setAudio.paused) setAudio.play().catch(()=>{}); });
        setTracklist.appendChild(row);
      });
      setTracklist.classList.add('show');
    }
    function updateActiveTrack(){
      if(!currentSet?.tracklist?.length) return;
      const t = setAudio.currentTime;
      let idx = -1;
      for(let i = 0; i < currentSet.tracklist.length; i++){
        if(currentSet.tracklist[i].at <= t) idx = i; else break;
      }
      if(idx !== activeTrackIdx){
        activeTrackIdx = idx;
        const rows = setTracklist.querySelectorAll('.tl-row');
        rows.forEach((r, i) => r.classList.toggle('active', i === idx));
      }
    }
    function openSetModal(meta: SetMeta){
      currentSet = meta;
      setTitle.textContent = meta.title;
      const meta_extras: string[] = [];
      if (meta.date) meta_extras.push(meta.date);
      if (meta.bpm && meta.bpm > 0) meta_extras.push(meta.bpm.toFixed(1) + ' BPM');
      if (meta.musicalKey) meta_extras.push(meta.musicalKey);
      setDate.textContent = meta_extras.join(' · ');
      if(meta.artwork){
        setArtworkImg.src = meta.artwork;
        setArtwork.classList.add('show');
      } else {
        setArtwork.classList.remove('show');
        setArtworkImg.src = '';
      }
      renderTracklist(meta);
      setAudio.src = meta.audio;
      setAudio.currentTime = 0;
      setSeekFill.style.width = '0%';
      setSeekBuffer.style.width = '0%';
      setSeekThumb.style.left = '0%';
      setTimeCurrent.textContent = '0:00';
      setTimeTotal.textContent = '--:--';
      // restore last position from localStorage
      try {
        const saved = localStorage.getItem('set:'+meta.slug);
        if(saved){
          const t = parseFloat(saved);
          if(isFinite(t) && t > 5) setAudio.currentTime = t;
        }
      } catch {}
      setCopy.textContent = 'copy link';
      setCopy.classList.remove('copied');
      syncPlayIcon();
      openSheet(sheets.set);
      // push slug to URL without reload, so refreshing keeps the player open
      try {
        const u = new URL(location.href);
        u.searchParams.set('set', meta.slug);
        history.replaceState(null, '', u.toString());
      } catch {}
    }
    function closeSetModal(){
      sheets.set.classList.remove('open');
      setAudio.pause();
