    function board(){
      if(boarded) return;
      touched();
      if(!renderer || !balloon){ cockpit.classList.add('flat', 'open'); boarded = true; resetForm(); return; }
      if(focused >= 0) backOutNow();
      boarded = true;
      hoverBalloon = false;
      balloon.mode = 'board';
      balloon.peek = 0;
      balloon.group.scale.setScalar(BALLOON_SCALE);
      resetForm();
      if(controls){ controls.enabled = false; overviewPos.copy(pilot ? pilot.overview : camera.position); }
      if(pilot){ endSelection(); if(pilot.home) gas = 1; pilot = null; burnerOn = false; document.body.classList.remove('pilot'); }
      // from here on it's a physical object in the universe, parked where you caught it, upright in the world
      scene.attach(balloon.group);
      balloon.group.quaternion.copy(upright(balloon.tau*.2));
      balloon.group.getWorldDirection(balloon.dir);
      const p = balloon.group.position, t = balloon.dir;
      const side = t.clone().cross(new THREE.Vector3(0,1,0)).normalize();
      if(side.dot(camera.position.clone().sub(p)) < 0) side.negate();
      const up = side.clone().cross(t).normalize();
      if(up.y < 0) up.negate();
      const d = 19*Math.max(1, Math.pow(1.2/camera.aspect, .5));
      document.body.classList.add('aboard');
      flyTo(p.clone().addScaledVector(side, d).addScaledVector(up, 1.6), p.clone().addScaledVector(up, 2.4), 1900, () => {
        cockpit.classList.add('open');
        setTimeout(() => msgInput.focus(), 200);
      });
    }
    function backOutNow(){
      const p = pieces[focused];
