    // ── Flight ────────────────────────────────────────────
    let focused = -1, hovered = -1, shown = -1, lastInput = 0, lockedAt = 0, scanning = false;
    interface Flight { fromP: THREE.Vector3; toP: THREE.Vector3; fromL: THREE.Vector3; toL: THREE.Vector3; t0: number; dur: number; arc: number; done?: () => void; }
    let flight: Flight | null = null;
    const look = new THREE.Vector3();
    const overviewPos = new THREE.Vector3();
