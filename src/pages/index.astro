        const t = audioCtx.currentTime, osc = audioCtx.createOscillator(), g = audioCtx.createGain();
        osc.type = 'sine'; osc.frequency.setValueAtTime(62, t); osc.frequency.exponentialRampToValueAtTime(38, t+1.6);
        g.gain.setValueAtTime(.001, t); g.gain.exponentialRampToValueAtTime(.9, t+.08); g.gain.exponentialRampToValueAtTime(.001, t+1.7);
        osc.connect(g); g.connect(masterGain); osc.start(t); osc.stop(t+1.7);
      }
      setTimeout(() => { leaving = false; blastPower = 1; if(focused >= 0) backOut(false, true); }, 1200);
    }
    function backOut(toPause = false, roaring = false){
      if(focused < 0) return;
      if(pilot && !toPause){
        // back to flying: the burners roar, the envelope lights up and the balloon lifts off a touch
        burstAt = performance.now();
        pilot.vy = Math.max(pilot.vy, 7);
        if(!roaring) burnerBreath(1.6, .6);
      }
      if(pilot) pilot.picked = null; // leaving a piece any other way forgets the pause it came from
      const p = pieces[focused];
      p.mat.depthTest = true;
      p.mesh.renderOrder = 0;
      focused = -1;
      document.body.classList.remove('focus');
      btnBack.hidden = true;
      lamp.classList.remove('on');
      showMeta(0);
      if(pilot) flight = null; // back behind the balloon: the chase camera takes it from here
      else {
        const to = overviewPos.lengthSq() ? overviewPos.clone() : overviewHome();
        flyTo(to, CENTER.clone(), 1700, () => { if(controls){ controls.target.copy(CENTER); controls.enabled = true; } });
      }
      const url = new URL(location.href);
      url.hash = '';
      history.replaceState(null, '', url.toString());
    }
    function stepFocus(d: number){
      const from = focused < 0 ? (d > 0 ? 0 : pieces.length) : focused;
      const to = Math.max(1, Math.min(pieces.length-1, from+d));
      if(to !== focused) focusOn(to, 1100);
    }
    function showMeta(i: number){
      const st = stations[i];
      shown = i;
      const home = st.kind === 'home';
      metaId.textContent = home
        ? `${total} señales`
        : `Nº ${String(st.n).padStart(3,'0')}/${total} · ${st.date.replaceAll('-','·')} · ${pieces[i]?.stage || ''}`;
      metaCap.textContent = home ? 'pasado observado' : (st.kind === 'text' || st.flood) && focused === i ? '' : st.text;
      act.hidden = !(st.kind === 'set' && focused === i);
      nowEl.textContent = home ? 'Eze Angeloni, Cronovisor' : `${st.date}: ${st.text || 'foto sin título'}`;
    }

    // ── Input ─────────────────────────────────────────────
    const ray = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    let pointerFresh = false, press: { x: number, y: number, t: number } | null = null, wheelAt = 0, wheelSum = 0, wheelDone = false;
    function pick(){
      ray.setFromCamera(ndc, camera);
      const hit = ray.intersectObjects(pieces.map(p => p.mesh), false)[0];
      return hit ? hit.object.userData.i as number : -1; // 0 is the logo
    }
    function setNdc(e: PointerEvent){
      ndc.set(e.clientX/window.innerWidth*2-1, -(e.clientY/window.innerHeight)*2+1);
    }
    screen.addEventListener('pointermove', e => {
      lastMove = performance.now();
      if(e.pointerType !== 'mouse') return;
      setNdc(e);
      pointerFresh = true;
    });
    screen.addEventListener('pointerdown', e => {
      if(pilot && focused < 0){ // the mouse takes the universe back, unless it points at a galaxy to sail to
        setNdc(e);
        const w = pickWorld();
        if(w >= 0 && worlds[w].link.galaxy?.open){ voyage(w); return; }
        if(e.pointerType === 'mouse' && performance.now()-focusAt > 500) exitPilot(); // a finger lands with its own button; a click that only focuses the window doesn't land
        return;
      }
      press = { x:e.clientX, y:e.clientY, t:performance.now() };
      touched();
    });
    window.addEventListener('pointerup', e => {
      if(!press) return;
      const dx = e.clientX-press.x, dy = e.clientY-press.y, quick = performance.now()-press.t < 500;
      press = null;
      if(e.target !== screen || boarded) return;
      if(focused >= 0 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)){ stepFocus(dx < 0 ? 1 : -1); return; }
      if(Math.hypot(dx, dy) > 7 || !quick) return;
      setNdc(e);
      if(focused < 0 && worldAt < 0){ const w = pickWorld(); if(w >= 0){ goToWorld(worlds[w]); return; } } // a world (or a far galaxy) before the balloon
      if(focused < 0 && balloon && balloon.mode === 'cruise' && Math.hypot(e.clientX-balloon.sx, e.clientY-balloon.sy) < 56){ board(); return; }
      if(focused >= 0 && balloon && balloon.peek > .5 && Math.hypot(e.clientX-balloon.sx, e.clientY-balloon.sy) < 64){ backOut(); return; }
      setNdc(e);
      if(worldAt >= 0){ if(pickWorld() !== worldAt) leaveWorld(); return; }
      const w = focused < 0 ? pickWorld() : -1;
      if(w >= 0){ visitWorld(w); return; }
      const i = pick();
      if(focused < 0){ if(i > 0) focusOn(i); else if(i === 0) board(); } // the logo is where words land: it takes you to write one
      else if(i !== focused) { if(i > 0) focusOn(i, 1100); else backOut(); }
    });
    screen.addEventListener('wheel', e => {
      touched();
      if(focused < 0 || boarded) return;
      // one gesture, one step: a two-finger swipe on a trackpad keeps sending wheel events for a second
      // or more of inertia, and a fixed cooldown turned that into two or three flights cut short.
      // A gesture lasts until the events go quiet; it steps once, after enough travel in one direction
      const now = performance.now(), d = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
      if(now-wheelAt > 220){ wheelSum = 0; wheelDone = false; }
      wheelAt = now;
      if(wheelDone) return;
      wheelSum += d;
      if(Math.abs(wheelSum) < 40) return;
      wheelDone = true;
      stepFocus(wheelSum > 0 ? 1 : -1);
    }, { passive:true });
    btnBack.addEventListener('click', () => { touched(); if(worldAt >= 0) leaveWorld(); else backOut(); });

    window.addEventListener('keydown', e => {
      if(e.key === 'Escape'){
        if(boarded){ if(!delivering) leaveBalloon(); }
        else if(anyOpen()) closeSheets();
        else if(pilot?.selecting && focused < 0) endSelection();
        else if(pilot && focused < 0) exitPilot();
        else if(worldAt >= 0) leaveWorld();
        else { touched(); if(pilot && focused >= 0) flyOn(); else backOut(); }
        return;
      }
      if(boarded || anyOpen() || e.metaKey || e.ctrlKey || e.altKey) return;
      if(pilot && KB_PILOT.includes(e.key.toLowerCase())) return; // flying: the balloon handles these
      const tag = (e.target as HTMLElement).tagName;
      if(tag === 'INPUT' || tag === 'TEXTAREA') return; // typing, not steering
      if(e.key === ' ' && tag === 'BUTTON') return;
      switch(e.key){
        case 'ArrowDown': case 'ArrowRight': case 'PageDown': case ' ': case 'j': touched(); stepFocus(1); e.preventDefault(); break;
        case 'ArrowUp': case 'ArrowLeft': case 'PageUp': case 'k': touched(); stepFocus(-1); e.preventDefault(); break;
        case 'Home': touched(); backOut(); e.preventDefault(); break;
        case 'End': touched(); focusOn(pieces.length-1); e.preventDefault(); break;
        case 'i': openIndex(); break;
        case 'h': startTour(); break;
        case 't': board(); break;
        case 'c': if(meet){ openTalk(); e.preventDefault(); } break;
        case 'g': if(meet) giveGas(); break;
        case 'v': toggleMute(); break;
        case 'x': if(meet){ if(invitedBy) acceptTrip(); else inviteTrip(); } break;
        case 'm': toggleSound(); break;
        case '1': playSong(); break;
      }
    });

    function resize(){
      if(!renderer) return;
      const W = window.innerWidth, H = window.innerHeight;
      renderer.setPixelRatio(DPR);
      renderer.setSize(W, H, false);
      camera.aspect = W/H;
      camera.updateProjectionMatrix();
      overviewR = Math.max(112, galaxyR*1.22, nearestAway()*.3)*Math.max(1, Math.pow(1.2/camera.aspect, .8)); // a small galaxy stands back enough to show its neighbours
      if(controls) controls.maxDistance = overviewR*1.5;
      composer?.setPixelRatio(DPR);
      composer?.setSize(W, H);
    }
    window.addEventListener('resize', resize);

    let lastFrame = 0, calm = 0, slowAvg = 1/60, lowPower = false, focusedWindow = document.hasFocus(), lastMove = 0;
    let focusAt = 0; // the click that brings the window to the front isn't meant for the universe
    window.addEventListener('focus', () => { focusedWindow = true; focusAt = performance.now(); });
    window.addEventListener('blur', () => { focusedWindow = false; });
    // Frame budget: full rate (capped at 60, even on 120Hz screens) while something moves;
    // fewer frames when the picture is still, so the machine can rest.
    function frameBudget(now: number){
      if(!focusedWindow) return follow || crew.size || skyMoving ? 1000/30 : 1000/10; // another window has the focus: barely tick, unless flying with someone
      const moving = flight || boarded || delivering || impactAt || (pilot && !pilot.selecting && focused < 0) || now-lastInput < 1200 || skyMoving;
      if(moving) return 1000/60;
      if(focused >= 0 || pilot?.selecting) return 1000/24;           // a piece on screen, or the universe paused
      if(now-Math.max(lastInput, lastMove) > 20000) return 1000/30;                      // nobody around: the slow auto-rotate is enough at 30
      return 1000/60;
    }
    let sim = 0; // the universe's own clock: it stops while you choose a piece from the balloon
