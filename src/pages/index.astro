          lamps.push([m]);
        }
        const threadGeo = new THREE.BufferGeometry();
        threadGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(12*3), 3));
        thread = new THREE.Line(threadGeo, new THREE.LineBasicMaterial({ color:0xf0ede8, transparent:true, opacity:.45 }));
        thread.frustumCulled = false;
        group.add(thread);
        const engine = flame(0xff9f1c);
        engine.position.y = -1.05;
        group.add(engine);
        group.scale.setScalar(.7);
        return { kind, scale:.7, group, engine, lamps, bulbs, home, thread, skin };
      }
      const hull = new THREE.LatheGeometry(HULL.map(([r,z]) => new THREE.Vector2(r, z)), 8);
      hull.rotateX(Math.PI/2);
      hull.rotateZ(Math.PI/8);
      add(hull);
      const fin = new THREE.Shape();
      fin.moveTo(0,.6); fin.lineTo(1.1,-1.2); fin.lineTo(2.5,-4.6); fin.lineTo(1.5,-4.1); fin.lineTo(0,-3.2); fin.closePath();
      for(let k = 0; k < 3; k++){
        const g = new THREE.ExtrudeGeometry(fin, { depth:.05, bevelEnabled:false });
        g.rotateX(Math.PI/2);
        g.rotateY(0);
        g.translate(0, 0, 0);
        g.rotateZ(Math.PI/2 + k*Math.PI*2/3);
        add(g, 30);
      }
      const ring = new THREE.TorusGeometry(.62, .1, 6, 16);
      ring.translate(0, 0, -3.5);
      add(ring, 40);
      const lampGeo = new THREE.SphereGeometry(.13, 8, 8);
      for(let k = 0; k < 11; k++){
        const z = 3.1 - k*.56, r = hullR(z)*1.03;
        const row = [1,-1].map(side => {
          const m = new THREE.MeshBasicMaterial({ color:new THREE.Color(COLORS[k % COLORS.length]) });
          const mesh = new THREE.Mesh(lampGeo, m);
          mesh.position.set(side*r, 0, z);
          group.add(mesh);
          return m;
        });
        lamps.push(row);
      }
      const engine = flame(0x6ef9f5);
      engine.position.z = -3.9;
      group.add(engine);
      return { kind, scale:1, group, engine, lamps, bulbs, home, thread, skin };
    }
    function buildShip(){
