      const prev = pieces[focused];
      focused = i;
      const p = pieces[i];
      [i-1, i, i+1].forEach(k => { if(pieces[k]) loadHi(pieces[k]); });
      pieces.forEach(q => { if(Math.abs(q.i-i) > 2) dropHi(q); });
