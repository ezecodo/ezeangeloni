          const grow = 1-Math.exp(-e*2.2);
          burst.scale.setScalar(grow + .02);
          (burst.material as THREE.PointsMaterial).opacity = Math.max(0, 1-e/2.6);
          shock.scale.set(2 + grow*90, 2 + grow*90, 1);
          (shock.material as THREE.MeshBasicMaterial).opacity = Math.max(0, 1-e/1.5);
          if(e > 2.6){ burst.visible = false; shock.visible = false; impactAt = 0; logoPulse = 0; }
        }
      }
      const idle = s.mode === 'cruise' ? Math.floor(now*.006) % 11 : -1;
      s.lamps.forEach((row, k) => row.forEach(m => {
        const c = s.over ? hexRgb('#ff3f3f') : hexRgb(COLORS[k % COLORS.length]);
        const on = s.over ? (Math.floor(now*.008) % 2 ? 1.4 : .2) : k < s.lit ? 1.7 : k === idle ? 1 : .1;
        m.color.setRGB(c[0]*on, c[1]*on, c[2]*on);
