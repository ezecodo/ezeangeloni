    // ── Elsewhere: worlds scattered through the galaxy ─────────────
    // Eze's other work (Fábrica de trapos, ila, …) as small ringed planets, each in its own place in the galaxy,
    // out among the barrios and away from the logo, turning slowly on a little orbit of their own. The place is
    // seeded by the link, so it stays put between visits and anyone can find it again. Edited from the admin (links
    // tab → links.json on the VPS: text or logo, a description, the stack); these defaults show until that file exists.
    // Hovering names one; clicking flies there and opens what it is beside the planet (`#world-info`), with the only
    // button that leaves for the site. Piloting, coming close to one opens the same, as pieces reveal themselves.
    interface SiteLink { label: string; url: string; image?: string; font?: 'malvinas' | 'serif' | 'mono'; description?: string; tags?: string[];
      galaxy?: { slug: string; public: boolean; open: boolean; home?: boolean }; }
    const DEFAULT_LINKS: SiteLink[] = [
      { label: 'Fábrica de trapos', url: 'https://trapos.xyz', font: 'malvinas',
        description: 'Una herramienta para escribir con la letra que nació de una sábana de hotel: en la semifinal de Argentina contra Inglaterra alguien la pintó a mano y los jugadores la mostraron a cámara. Juanma la convirtió en tipografía; yo construí la fábrica alrededor y extendí la fuente, con sus acentos dibujados a mano. Escribís, elegís tamaño, color y formato, y la descargás para la bandera, la remera o la pared. Todo pasa en tu navegador.',
        tags: ['Astro', 'Canvas', 'tipografía', 'self-hosted'] },
      { label: 'ila', url: 'https://www.ila-web.de', image: '/img/ila.png',
        description: 'La nueva casa digital de ila, la revista sobre América Latina que se publica en Alemania desde 1975. Migré más de 2.000 artículos desde Drupal 7 a una base propia y construí el sitio bilingüe, en alemán y español: el archivo de todas las ediciones, búsqueda por región y tema, un mapa de artículos, suscripciones y un panel editorial con traducción automática.',
        tags: ['Next.js', 'Prisma', 'MySQL', 'DeepL', 'DE · ES'] },
    ];
    interface World { link: SiteLink; mesh: THREE.Mesh; mat: THREE.MeshBasicMaterial; home: THREE.Vector3 | null; phase: number; seed: number; size: number;
      beacon?: THREE.Sprite; mark?: HTMLElement; period?: number; }
    let linkList: SiteLink[] = [];
    let worlds: World[] = [];
    let worldAt = -1, hoverWorld = -1, worldShown = -1;
    const worldInfo = $('world-info'), visitEl = $('world-visit') as HTMLAnchorElement;
    const host = (url: string) => { try { return new URL(url).host.replace(/^www\./, ''); } catch { return url; } };
    // the planet: a disc lit in the link's colour with its logo or name, crossed by a tilted ring
    function worldCard(l: SiteLink, tint: string, img?: HTMLImageElement){
      const S = 512, cv = document.createElement('canvas');
      cv.width = cv.height = S;
      const c = cv.getContext('2d')!, cx = S/2, cy = S/2, R = 150;
      const ring = (front: boolean) => {
        c.save();
        c.translate(cx, cy); c.rotate(-.22);
        c.beginPath();
        c.ellipse(0, 0, 232, 58, 0, front ? 0 : Math.PI, front ? Math.PI : Math.PI*2);
        c.strokeStyle = tint; c.globalAlpha = front ? .75 : .35; c.lineWidth = 7;
        c.stroke();
        c.restore();
      };
      ring(false);
      const g = c.createRadialGradient(cx - R*.35, cy - R*.4, R*.1, cx, cy, R);
      g.addColorStop(0, '#2a2438'); g.addColorStop(.75, '#120f1c'); g.addColorStop(1, '#0a0812');
      c.fillStyle = g;
      c.beginPath(); c.arc(cx, cy, R, 0, Math.PI*2); c.fill();
      const lit = c.createRadialGradient(cx - R*.45, cy - R*.5, 0, cx - R*.2, cy - R*.2, R*1.25);
      lit.addColorStop(0, tint); lit.addColorStop(1, 'rgba(0,0,0,0)');
      c.globalAlpha = .55; c.fillStyle = lit; c.fill(); c.globalAlpha = 1;
      c.strokeStyle = tint; c.globalAlpha = .55; c.lineWidth = 3; c.stroke(); c.globalAlpha = 1;
      if(img && img.naturalWidth){
        // a logo on a solid ground (ila's red square): the whole planet takes that colour and the logo is cut
        // into the disc, so it reads as one full circle; shaded a touch so it's still a body
        const probe = document.createElement('canvas');
        probe.width = probe.height = 1;
        const pc = probe.getContext('2d')!;
        pc.drawImage(img, 1, 1, 1, 1, 0, 0, 1, 1);
        const [r, g2, b, a] = pc.getImageData(0, 0, 1, 1).data;
        c.save();
        c.beginPath(); c.arc(cx, cy, R, 0, Math.PI*2); c.clip();
        if(a > 200) c.fillStyle = `rgb(${r},${g2},${b})`, c.fillRect(cx - R, cy - R, R*2, R*2);
        const k = a > 200 ? Math.max(R*1.5/img.naturalWidth, R*1.5/img.naturalHeight) : Math.min(R*1.15/img.naturalWidth, R*1.15/img.naturalHeight);
        c.drawImage(img, cx - img.naturalWidth*k/2, cy - img.naturalHeight*k/2, img.naturalWidth*k, img.naturalHeight*k);
        if(a > 200){
          const hi = c.createRadialGradient(cx - R*.45, cy - R*.5, 0, cx - R*.45, cy - R*.5, R*1.1);
          hi.addColorStop(0, 'rgba(255,255,255,.16)'); hi.addColorStop(1, 'rgba(255,255,255,0)');
          c.fillStyle = hi; c.fillRect(cx - R, cy - R, R*2, R*2);
          const rim = c.createRadialGradient(cx, cy, R*.62, cx, cy, R);
          rim.addColorStop(0, 'rgba(0,0,0,0)'); rim.addColorStop(1, 'rgba(0,0,0,.38)');
          c.fillStyle = rim; c.fillRect(cx - R, cy - R, R*2, R*2);
        }
        c.restore();
      } else {
        const words = (l.font === 'mono' ? l.label.toUpperCase() : l.label).split(' ');
        const lines = words.length > 1 ? [words.slice(0, Math.ceil(words.length/2)).join(' '), words.slice(Math.ceil(words.length/2)).join(' ')] : words;
        let size = 90;
        const set = () => { c.font = l.font === 'malvinas' ? `${size}px 'MalvinasSans', sans-serif` : l.font === 'mono' ? `${size}px 'DM Mono', monospace` : `italic 300 ${size}px 'Cormorant Garamond', serif`; };
        set();
        while(size > 18 && Math.max(...lines.map(t => c.measureText(t).width)) > R*1.6){ size -= 4; set(); }
        c.fillStyle = '#f0ede8'; c.textAlign = 'center'; c.textBaseline = 'middle';
        lines.forEach((t, k) => c.fillText(t, cx, cy + (k - (lines.length-1)/2)*size*1.05));
      }
      ring(true);
      return new THREE.CanvasTexture(cv);
    }
    // The neighbouring galaxies, seen from this one: everyone else's (and Eze's, from theirs). A public one is a
    // spiral of light you can fly into; a private one a blurred nebula until its owner lets you in.
    function neighbours(): SiteLink[] {
      const out: SiteLink[] = registry.filter(g => g.slug !== GAL).map(g => {
        const open = g.public || doors[g.slug]?.status === 'open';
        return { label: g.name, url: `/?g=${g.slug}`, galaxy: { slug: g.slug, public: g.public, open } };
      });
      if(GAL) out.unshift({ label: 'Eze', url: '/', galaxy: { slug: '', public: true, open: true, home: true } });
      return out;
    }
    // A galaxy's own shape, seen from afar: its months on the same spiral this page lays out, each photo or frase a
    // point of light in its colour, sets in pink. Big archives look big and many-armed; a new one is a small knot.
    interface Shape { pts: { x: number; z: number; c: string }[]; R: number; }
    const shapes = new Map<string, Shape>();
    function shapeOf(frases: Frase[], sets: SetMeta[]): Shape {
      const items = [...frases.filter(f => f.imagen || f.texto).map(f => ({ d: f.fecha || '', set: false })), ...sets.map(x => ({ d: x.date || '', set: true }))];
      const months = [...new Set(items.map(x => x.d.slice(0, 7)))].sort().reverse();
      const at = new Map(months.map((m, k) => [m, k])), count = new Map<string, number>();
      items.forEach(x => { const m = x.d.slice(0, 7); count.set(m, (count.get(m) || 0) + 1); });
      const rng = makeRng(77);
      const pts = items.map((x, i) => {
        const m = x.d.slice(0, 7), { a, r } = spiral(at.get(m) || 0), spread = 9 + Math.sqrt(count.get(m) || 1)*3.8;
        const u = rng()*Math.PI*2, rr = spread*Math.sqrt(rng());
        return { x: Math.cos(a)*r + Math.cos(u)*rr, z: Math.sin(a)*r + Math.sin(u)*rr, c: x.set ? '#ff6eb4' : COLORS[i % COLORS.length] };
      });
      return { pts, R: spiral(Math.max(0, months.length-1)).r + 22 };
    }
    function galaxyCard(name: string, open: boolean, seed: number, shape?: Shape){
      const S = 512, cv = document.createElement('canvas');
      cv.width = cv.height = S;
      const c = cv.getContext('2d')!, rng = makeRng(seed), cx = S/2, cy = S/2;
      const core = c.createRadialGradient(cx, cy, 0, cx, cy, S*(shape ? .12 : .32));
      core.addColorStop(0, open ? 'rgba(255,240,220,.9)' : 'rgba(199,125,255,.35)'); core.addColorStop(1, 'rgba(0,0,0,0)');
      c.fillStyle = core; c.fillRect(0, 0, S, S);
      if(open && shape){
        // its real barrios, as a disc seen at an angle, turned its own way
        const k = 228/shape.R, tilt = .5 + rng()*.2, turn = rng()*Math.PI*2, ct = Math.cos(turn), st = Math.sin(turn);
        const place = (p: { x: number; z: number }) => { const x = p.x*ct - p.z*st, z = p.x*st + p.z*ct; return [cx + x*k, cy + z*k*tilt]; };
        c.globalCompositeOperation = 'lighter';
        const boost = Math.max(1, Math.min(4, 12/Math.sqrt(shape.pts.length || 1))); // a young galaxy: few, bigger lights
        const halo = 14*boost;
        for(const p of shape.pts){ // a soft halo per point, so dense barrios glow as clusters
          const [x, y] = place(p), g = c.createRadialGradient(x, y, 0, x, y, halo);
          g.addColorStop(0, p.c + (boost > 1.5 ? '55' : '22')); g.addColorStop(1, p.c + '00');
          c.fillStyle = g; c.fillRect(x - halo, y - halo, halo*2, halo*2);
        }
        for(const p of shape.pts){
          const [x, y] = place(p);
          c.globalAlpha = .55 + rng()*.45; c.fillStyle = rng() < .2 ? '#f0ede8' : p.c;
          const d = (1.6 + rng()*1.6)*boost;
          c.beginPath(); c.arc(x, y, d/2, 0, Math.PI*2); c.fill();
        }
        c.globalAlpha = 1; c.globalCompositeOperation = 'source-over';
      } else if(open){
        // two arms of stars in the palette, tilted like a disc seen at an angle
        const tilt = .45 + rng()*.25, turn = rng()*Math.PI*2;
        for(let i = 0; i < 1400; i++){
          const arm = i % 2, t = Math.pow(rng(), .7), a = turn + arm*Math.PI + t*Math.PI*2.4 + (rng()-.5)*.5, r = 18 + t*205;
          const x = Math.cos(a)*r, y = Math.sin(a)*r*tilt;
          c.globalAlpha = (1 - t*.75)*(.35 + rng()*.65);
          c.fillStyle = rng() < .25 ? '#f0ede8' : COLORS[Math.floor(rng()*COLORS.length)];
          const d = 1 + rng()*2.2*(1-t);
          c.fillRect(cx + x, cy + y, d, d);
        }
      } else {
        // closed: only a soft glow, its shape unreadable from here
        for(let i = 0; i < 26; i++){
          const a = rng()*Math.PI*2, r = rng()*120, g = c.createRadialGradient(cx + Math.cos(a)*r, cy + Math.sin(a)*r*.6, 0, cx + Math.cos(a)*r, cy + Math.sin(a)*r*.6, 70 + rng()*70);
          g.addColorStop(0, rng() < .5 ? 'rgba(199,125,255,.22)' : 'rgba(110,249,245,.14)'); g.addColorStop(1, 'rgba(0,0,0,0)');
          c.globalAlpha = 1; c.fillStyle = g; c.fillRect(0, 0, S, S);
        }
      }
      return new THREE.CanvasTexture(cv);
    }
    function buildWorlds(){
      if(!renderer) return;
      if(worldAt >= 0) leaveWorld();
      worlds.forEach(w => { scene.remove(w.mesh); w.mat.map?.dispose(); w.mat.dispose(); const k = billboards.indexOf(w.mesh); if(k >= 0) billboards.splice(k, 1); if(w.beacon){ scene.remove(w.beacon); w.beacon.material.dispose(); } });
      $('sky-marks').replaceChildren(...(sunMark ? [sunMark] : []));
      const ok = [...linkList.filter(l => l && /^https?:\/\//.test(l.url) && (l.label || l.image)).slice(0, 12), ...neighbours()];
      worlds = ok.map((link, k) => {
        const tint = COLORS[(k*3 + 2) % COLORS.length], size = link.galaxy ? 40 : 13;
        const mat = new THREE.MeshBasicMaterial({ transparent:true, depthWrite:false, color:new THREE.Color(.82, .82, .82) }); // under the bloom
        if(link.galaxy) mat.blending = THREE.AdditiveBlending;
        const mesh = new THREE.Mesh(plane, mat);
        mesh.scale.set(size, size, 1);
        mesh.userData.world = k;
        mesh.visible = false; // until it has a place
        scene.add(mesh);
        billboards.push(mesh);
        const seed = Number.parseInt(hash36(link.galaxy ? 'galaxy:' + link.galaxy.slug : link.url), 36);
        if(link.galaxy){ mat.map = galaxyCard(link.label, link.galaxy.open, seed, shapes.get(link.galaxy.slug || 'eze')); }
        else {
          const paint = (img?: HTMLImageElement) => { mat.map?.dispose(); mat.map = worldCard(link, tint, img); mat.needsUpdate = true; };
          if(link.image){ const img = new Image(); img.onload = () => paint(img); img.src = link.image.startsWith('/links/') ? BASE + link.image : link.image; }
          else document.fonts.ready.then(() => paint());
          paint();
        }
        const w: World = { link, mesh, mat, home: null, phase: 0, seed, size };
        if(link.galaxy) addBeacon(w);
        return w;
      });
      worlds.forEach(w => { const sh = w.link.galaxy && shapes.get(w.link.galaxy.slug || 'eze'); if(sh) w.size = galaxySize(sh); });
      placeWorlds();
      loadShapes();
    }
    // Pulsars are told apart by their period; so are the galaxies: a light at each heart that flashes on its own
    // rhythm, the same size on screen at any distance, warm if you may enter, cold and faint if not. And, like a
    // star chart, a thin ellipse with a catalogue name: CV 1 is Eze's, the rest in the order they were born.
    function catalogue(g: NonNullable<SiteLink['galaxy']>){ return g.home ? 1 : registry.findIndex(x => x.slug === g.slug) + 2; }
    function addBeacon(w: World){
      const g = w.link.galaxy!, rng = makeRng(w.seed + 5);
      w.period = 1.1 + rng()*1.9;
      const mat = new THREE.SpriteMaterial({ map: SOFT, color: new THREE.Color(g.open ? '#ffd9a0' : '#7fe8ff'), transparent: true, depthWrite: false, depthTest: false, sizeAttenuation: false, blending: THREE.AdditiveBlending });
      w.beacon = new THREE.Sprite(mat);
      w.beacon.renderOrder = 5;
      scene.add(w.beacon);
      const el = document.createElement('div');
      el.className = 'sky-mark ' + (g.open ? 'open' : 'closed');
      el.innerHTML = '<i></i><b>➤</b><span></span>';
      el.querySelector('span')!.textContent = `${w.link.label} · CV ${catalogue(g)}`;
      el.addEventListener('click', e => { e.stopPropagation(); goToWorld(w); });
      $('sky-marks').append(el);
      w.mark = el;
    }
    function updateBeacons(now: number){
      const W = window.innerWidth, H = window.innerHeight;
      worlds.forEach((w, k) => {
