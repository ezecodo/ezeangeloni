        s.group.quaternion.copy(upright(now*.0002));
        let arrived = 0;
        s.drops.forEach((d, k) => {
          const b = s.bulbs[k], u = reduced ? 1 : Math.max(0, Math.min(1, (e-k*LET_GO)/travel));
          if(u > 0 && b.parent === s.group){ scene.attach(b); playNote(NOTES[k % NOTES.length]); }
          if(b.parent === s.group) return;
