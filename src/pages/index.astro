      requestAnimationFrame(frame);
      if(renderer && !document.hidden) pollPad(now);
      if(!renderer || document.hidden || anyOpen()){ lastFrame = now; return; }
      const budget = frameBudget(now);
      if(now-lastFrame < budget - 2) return;
      const dt = Math.min(now-lastFrame, 100)/1000;
      lastFrame = now;
      const ease = 1-Math.exp(-dt*6);
      const frozen = !!pilot?.selecting;
      if(!frozen) sim += dt*1000;
      // slow device: drop bloom and resolution rather than the frame rate
      if(budget < 20) slowAvg = slowAvg*.97 + dt*.03; // only judge the device when we asked for full rate
      if(!lowPower && now > 8000 && slowAvg > .04){
