    function rnd(a: number, b: number){ return a + Math.random()*(b-a); }

    interface Circle {
      id: number; x: number; y: number; r: number; baseR: number;
      color: string; alpha: number; targetAlpha: number; label: string;
      vx: number; vy: number; delay: number; born: number; phase: number;
      proximityFade?: number;
    }

    const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
    const isMobileDevice = window.matchMedia('(max-width: 768px)').matches;
    const CIRCLE_COUNT = isMobileDevice ? 16 : (isSafari ? 28 : 41);
    const simple = isSafari || isMobileDevice; // skip gradients for performance

    function createCircle(i: number): Circle {
      const r = i === MSG_IDX
        ? rnd(isMobileDevice ? 13:22, isMobileDevice ? 19:32)
        : i === ABOUT_IDX
          ? rnd(isMobileDevice ? 22:55, isMobileDevice ? 32:75)
          : rnd(isMobileDevice ? 6:12, isMobileDevice ? 30:140);
      return { id:i, x:rnd(r,W-r), y:rnd(r,H-r), r, baseR:r, color:COLORS[i%COLORS.length], alpha:0, targetAlpha:0, label:LABELS[i], vx:rnd(-0.18,0.18), vy:rnd(-0.18,0.18), delay:i*40, born:performance.now(), phase:rnd(0,Math.PI*2) };
    }
    let circles: Circle[] = Array.from({length:CIRCLE_COUNT},(_,i)=>createCircle(i));
    let hoveredCircle: Circle | null = null;
    let prevUnderCursor = new Set<number>();

    interface DragState { c: Circle; startX: number; startY: number; lastX: number; lastY: number; moved: boolean; vx: number; vy: number; }
    let drag: DragState | null = null;
    const DRAG_THRESHOLD = 6;

    // Cache grid on offscreen canvas
    let gridCanvas: HTMLCanvasElement | null = null;
    function buildGrid(){
      gridCanvas = document.createElement('canvas');
      gridCanvas.width = W; gridCanvas.height = H;
      const gc = gridCanvas.getContext('2d')!;
      gc.strokeStyle='rgba(240,237,232,0.025)'; gc.lineWidth=1;
      for(let x=0;x<W;x+=80){ gc.beginPath();gc.moveTo(x,0);gc.lineTo(x,H);gc.stroke(); }
      for(let y=0;y<H;y+=80){ gc.beginPath();gc.moveTo(0,y);gc.lineTo(W,y);gc.stroke(); }
    }
    buildGrid();

    function dist(ax: number, ay: number, bx: number, by: number){ return Math.sqrt((ax-bx)**2+(ay-by)**2); }

    function draw(now: number){
      ctx.clearRect(0,0,W,H);
      if(gridCanvas) ctx.drawImage(gridCanvas,0,0);

      // photo & set bubbles push others away + fade overlap, so the content stays readable
      const mediaCircles = circles.filter(c => LABELS[c.id] === '__img__' || LABELS[c.id] === '__set__');
      const AMBIENT_SPEED = 0.55;
      const draggedId = drag?.c.id ?? -1;
      circles.forEach(c => {
        const isMedia = LABELS[c.id] === '__img__' || LABELS[c.id] === '__set__';
        if (isMedia || c.id === draggedId) { c.proximityFade = 1;
        } else {
          let minFade = 1;
          for (const p of mediaCircles) {
            const dx = c.x - p.x, dy = c.y - p.y;
            const d = Math.sqrt(dx*dx + dy*dy);
            const minDist = c.r + p.r + 28;
            if (d < minDist && d > 0.01) {
              const force = (minDist - d) / minDist;
              const push = 0.06 * force;
              c.vx += (dx / d) * push;
              c.vy += (dy / d) * push;
              minFade = Math.min(minFade, Math.max(0.1, d / minDist));
            }
          }
          c.proximityFade = minFade;
        }
        // soft decay: anything above ambient speed (from throw or repulsion) eases back
        if (c.id !== draggedId) {
          const sp = Math.sqrt(c.vx*c.vx + c.vy*c.vy);
          if (sp > AMBIENT_SPEED) { c.vx *= 0.97; c.vy *= 0.97; }
        }
      });

      hoveredCircle = null;
      // draw content bubbles last so they appear on top
      const sorted = [...circles].sort((a,b) => {
        const aHas = LABELS[a.id] ? 1 : 0;
        const bHas = LABELS[b.id] ? 1 : 0;
        return aHas - bHas;
      });
      // hover detection: topmost content bubble wins for click/visual
      const hoverSorted = [...sorted].reverse();
      const allUnderCursor = new Set<number>();
      hoverSorted.forEach(c => {
        const isHov = dist(mouse.x,mouse.y,c.x,c.y)<c.r;
        if(isHov){
          allUnderCursor.add(c.id);
          if(!hoveredCircle) hoveredCircle = c;
        }
      });
      // sound for every bubble the cursor just entered
      allUnderCursor.forEach(id => {
        if(!prevUnderCursor.has(id)) playNote(NOTES[id % NOTES.length]);
      });
      prevUnderCursor = allUnderCursor;
      sorted.forEach(c=>{
        const age = now - c.born - c.delay;
        if(age<0) return;
        const eased = 1-Math.pow(1-Math.min(age/800,1),3);
        c.x+=c.vx; c.y+=c.vy;
        if(c.x-c.r<0||c.x+c.r>W) c.vx*=-1;
        if(c.y-c.r<0||c.y+c.r>H) c.vy*=-1;
        const isHovered = hoveredCircle?.id === c.id;
        if(hoveredCircle && LABELS[hoveredCircle.id]) cursor.classList.add('on-bubble'); else cursor.classList.remove('on-bubble');
        canvas.style.cursor = 'none';
        c.targetAlpha = isHovered ? 1 : 0;
        c.alpha += (c.targetAlpha-c.alpha)*0.08;
        const isMsg = LABELS[c.id] === 'message';
        const pulse = isHovered
          ? (isMsg ? 2.8 + 0.08*Math.sin(now*0.003+c.phase) : 1+0.06*Math.sin(now*0.004+c.phase))
          : 1;
        const displayR = c.baseR*eased*pulse;
        if(c.alpha>0.01){
          if(!simple){
            const glow=ctx.createRadialGradient(c.x,c.y,0,c.x,c.y,displayR*2.5);
            glow.addColorStop(0,c.color+Math.round(c.alpha*60).toString(16).padStart(2,'0'));
            glow.addColorStop(1,'transparent');
            ctx.beginPath();ctx.arc(c.x,c.y,displayR*2.5,0,Math.PI*2);
            ctx.fillStyle=glow;ctx.fill();
          }
        }
        ctx.beginPath();ctx.arc(c.x,c.y,displayR,0,Math.PI*2);
        if(c.alpha>0.01){
          const bubbleColor = LABELS[c.id] === 'message' ? '#ffd166' : c.color;
          if(simple){
            ctx.fillStyle=bubbleColor;ctx.globalAlpha=c.alpha*eased*0.85;ctx.fill();ctx.globalAlpha=1;
          } else {
            const fill=ctx.createRadialGradient(c.x,c.y-displayR*0.3,displayR*0.1,c.x,c.y,displayR);
            fill.addColorStop(0,bubbleColor+'ff');fill.addColorStop(1,bubbleColor+'99');
            ctx.fillStyle=fill;ctx.globalAlpha=c.alpha*eased;ctx.fill();ctx.globalAlpha=1;
          }
        } else {
          const pf = c.proximityFade ?? 1;
          ctx.strokeStyle=`rgba(240,237,232,${(isMobileDevice?0.22:0.08)*eased*pf})`;ctx.lineWidth=isMobileDevice?1.5:1;ctx.stroke();
          if(LABELS[c.id] || IMAGES.has(c.id)){
            const pulse = 0.5 + 0.5*Math.sin(now*0.0015 + c.phase);
            const isImgBubble = LABELS[c.id]==='__img__';
            const isSetBubble = LABELS[c.id]==='__set__';
            const glowColor = isMsg ? '#ffd166' : isImgBubble ? '#38bdf8' : isSetBubble ? '#ff6eb4' : c.color;
            const glowMult = isMobileDevice ? 2.2 : 1;
            const glowAlpha = ((isImgBubble || isSetBubble) ? pulse*120 : pulse*50) * glowMult * pf;
            if(!simple){
              const glow2 = ctx.createRadialGradient(c.x,c.y,0,c.x,c.y,displayR*2.5);
              glow2.addColorStop(0, glowColor+Math.round(glowAlpha).toString(16).padStart(2,'0'));
              glow2.addColorStop(1,'transparent');
              ctx.beginPath();ctx.arc(c.x,c.y,displayR*2.5,0,Math.PI*2);
              ctx.fillStyle=glow2;ctx.fill();
            } else {
              ctx.beginPath();ctx.arc(c.x,c.y,displayR*1.8,0,Math.PI*2);
              ctx.fillStyle=glowColor;ctx.globalAlpha=((isImgBubble||isSetBubble)?0.28:0.12)*pulse*eased*pf;ctx.fill();ctx.globalAlpha=1;
            }
            // photo icon on image bubble
            if(isImgBubble){
              ctx.globalAlpha = pulse * 0.7 * eased;
              ctx.fillStyle = '#38bdf8';
              ctx.font = `${Math.max(12,displayR*0.45)}px serif`;
              ctx.textAlign='center'; ctx.textBaseline='middle';
              ctx.fillText('◎', c.x, c.y);
              ctx.globalAlpha = 1;
            }
            // set bubble: breathing rings + gradient stroke + play triangle
            if(isSetBubble){
              const breath = 0.5 + 0.5*Math.sin(now*0.0012 + c.phase);
              for(let ri=1; ri<=2; ri++){
                const ringR = displayR * (1 + ri*0.22 + breath*0.12);
                ctx.beginPath(); ctx.arc(c.x, c.y, ringR, 0, Math.PI*2);
                ctx.strokeStyle = `rgba(255,110,180,${(0.18 - ri*0.05) * eased * pf})`;
                ctx.lineWidth = 1;
                ctx.stroke();
              }
              ctx.beginPath(); ctx.arc(c.x, c.y, displayR, 0, Math.PI*2);
              const ringGrad = ctx.createLinearGradient(c.x - displayR, c.y, c.x + displayR, c.y);
              ringGrad.addColorStop(0, '#ff6eb4'); ringGrad.addColorStop(1, '#c77dff');
              ctx.strokeStyle = ringGrad;
              ctx.lineWidth = 1.4;
              ctx.globalAlpha = (0.55 + 0.3*breath) * eased * pf;
              ctx.stroke();
              ctx.globalAlpha = 1;
              ctx.globalAlpha = (0.78 + 0.15*pulse) * eased;
              ctx.fillStyle = '#ffd6ea';
              ctx.beginPath();
              const tri = displayR * 0.42;
              const ox = c.x + tri*0.15;
              ctx.moveTo(ox - tri*0.5, c.y - tri*0.6);
              ctx.lineTo(ox - tri*0.5, c.y + tri*0.6);
              ctx.lineTo(ox + tri*0.6, c.y);
              ctx.closePath();
              ctx.fill();
              ctx.globalAlpha = 1;
            }
            if(isMsg){
              const hovered = c.alpha > 0.5;
              const rot = now * 0.0003;
              const breath = 0.5 + 0.5*Math.sin(now*0.0012 + c.phase);
              ctx.save();
              ctx.translate(c.x, c.y);
              ctx.rotate(rot);

              // corona rings
              for(let ring=3;ring>0;ring--){
                const ringR = displayR*(1.4 + ring*0.45 + breath*0.2);
                const ringAlpha = (hovered ? 0.12 : 0.06) * (4-ring) * eased;
                ctx.beginPath(); ctx.arc(0,0,ringR,0,Math.PI*2);
                ctx.fillStyle = `rgba(255,200,50,${ringAlpha})`; ctx.fill();
              }

              // alternating long/short rays
              const numRays = isMobileDevice ? 12 : 24;
              for(let ri=0;ri<numRays;ri++){
                const angle = (ri/numRays)*Math.PI*2;
                const isLong = ri % 2 === 0;
                const breathe = Math.sin(now*0.0018 + ri*0.6);
                const inner = displayR + 4;
                const rayLen = isLong
                  ? displayR*(hovered ? 2.8 + 0.7*breathe : 1.6 + 0.35*breathe)
                  : displayR*(hovered ? 1.4 + 0.4*breathe : 0.7 + 0.2*breathe);
                const outer = inner + rayLen;
                const halfW = isLong ? (hovered ? 2.8 : 2) : (hovered ? 1.8 : 1.2);
                const px = Math.cos(angle), py = Math.sin(angle);
                const nx = -py, ny = px;
                const alpha = (hovered ? 0.75 : 0.4) * (isLong ? 1 : 0.6) * eased;
                ctx.beginPath();
                ctx.moveTo(px*inner + nx*halfW, py*inner + ny*halfW);
                ctx.lineTo(px*outer, py*outer);
                ctx.lineTo(px*inner - nx*halfW, py*inner - ny*halfW);
                ctx.closePath();
                ctx.fillStyle = `rgba(255,${isLong?215:235},${isLong?60:100},${alpha})`;
                ctx.fill();
              }

              // bright inner core
              ctx.beginPath(); ctx.arc(0,0,displayR*0.45,0,Math.PI*2);
              ctx.fillStyle = `rgba(255,245,180,${(hovered?0.6:0.3)*eased})`; ctx.fill();

              ctx.restore();
            }
          }
        }
        const label = LABELS[c.id] || '';
        const isImg = label === '__img__';
        const isNav = label === 'about' || label === 'message';
        // image bubble — always visible on mobile, hover-reveal on desktop
        if(isImg && c.alpha > (isMobileDevice ? 0.05 : 0.3)){
          const img = IMAGES.get(c.id);
          if(img && img.complete && img.naturalWidth > 0){
            ctx.save();
            ctx.globalAlpha = c.alpha * eased;
            ctx.beginPath(); ctx.arc(c.x, c.y, displayR, 0, Math.PI*2); ctx.clip();
            const s = displayR * 2;
            ctx.drawImage(img, c.x - displayR, c.y - displayR, s, s);
            ctx.restore();
          }
        }
        if(label && !isImg && isNav && c.alpha > 0.3 && displayR > 20){
          // about & message: label text inside the bubble
          ctx.globalAlpha = c.alpha * eased;
          ctx.fillStyle = '#080810';
          ctx.font = `bold ${Math.max(10, displayR*0.28)}px 'DM Mono',monospace`;
          ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          ctx.fillText(label, c.x, c.y);
          ctx.globalAlpha = 1;
        }
      });
      requestAnimationFrame(draw);
    }


    if (isMobileDevice) { document.getElementById('hint')!.textContent = 'tap the circles'; }
    window.addEventListener('mousemove',e=>{ mouse.x=e.clientX;mouse.y=e.clientY; (cursor as HTMLElement).style.left=e.clientX+'px'; (cursor as HTMLElement).style.top=e.clientY+'px'; });
    function handleBubbleAction(id: number) {
      const lbl = LABELS[id];
      if(!lbl) return;
      if(lbl === '__img__'){
        const img = IMAGES.get(id);
        if(img?.src) openImgModal(img.src);
      } else if(lbl === '__set__'){
        const meta = SETS.get(id);
        if(meta) openSetModal(meta);
      } else if(SECTIONS[lbl]){
        SECTIONS[lbl]();
      } else {
        // frase — open centered modal
        const c = circles.find(c => c.id === id);
        openFraseModal(lbl, c?.color);
      }
    }

    canvas.addEventListener('pointerdown', e => {
      if(modal.classList.contains('open') || msgOverlay.classList.contains('open') || imgOverlay.classList.contains('open')) return;
      if(fraseOverlay.classList.contains('open')){ closeFraseModal(); return; }
      const x = e.clientX, y = e.clientY;
      const isTouch = e.pointerType === 'touch';
      const TAP = isTouch ? 2.0 : 1.0;
      // pick topmost: prefer content bubbles, then decorative
      const hits = circles.filter(c => dist(x, y, c.x, c.y) < c.r * TAP);
      const hit = hits.find(c => LABELS[c.id]) ?? hits[hits.length - 1] ?? null;
      if(!hit) return;
      e.preventDefault();
      try { canvas.setPointerCapture(e.pointerId); } catch {}
      hit.vx = 0; hit.vy = 0;
      drag = { c: hit, startX: x, startY: y, lastX: x, lastY: y, moved: false, vx: 0, vy: 0 };
    });
    canvas.addEventListener('pointermove', e => {
      if(!drag) return;
      const dx = e.clientX - drag.lastX;
      const dy = e.clientY - drag.lastY;
      // smooth velocity estimate from recent pointer deltas
      drag.vx = drag.vx * 0.5 + dx * 0.5;
      drag.vy = drag.vy * 0.5 + dy * 0.5;
      const r = drag.c.r;
      drag.c.x = Math.max(r, Math.min(W - r, e.clientX));
      drag.c.y = Math.max(r, Math.min(H - r, e.clientY));
      drag.lastX = e.clientX;
      drag.lastY = e.clientY;
      if(!drag.moved && Math.hypot(e.clientX - drag.startX, e.clientY - drag.startY) > DRAG_THRESHOLD){
        drag.moved = true;
      }
    });
    function endDrag(e: PointerEvent){
      if(!drag) return;
      const d = drag;
      drag = null;
      try { canvas.releasePointerCapture(e.pointerId); } catch {}
      if(d.moved){
        // throw with inertia — scale per-event delta to per-frame velocity, clamp
        const SCALE = 0.35;
        let vx = d.vx * SCALE, vy = d.vy * SCALE;
        const sp = Math.hypot(vx, vy);
        const THROW_CAP = 5;
        if(sp > THROW_CAP){ vx *= THROW_CAP/sp; vy *= THROW_CAP/sp; }
        d.c.vx = vx; d.c.vy = vy;
      } else {
        // tap — restore the ambient drift it had before being grabbed
        d.c.vx = rnd(-0.18, 0.18);
        d.c.vy = rnd(-0.18, 0.18);
        if(LABELS[d.c.id]) handleBubbleAction(d.c.id);
      }
    }
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);
    window.addEventListener('touchstart',e=>{ const t=e.touches[0]; mouse.x=t.clientX; mouse.y=t.clientY; }, {passive:true});
    window.addEventListener('touchmove',e=>{ const t=e.touches[0]; mouse.x=t.clientX; mouse.y=t.clientY; }, {passive:true});
    // delay mouse reset so the tap flash is visible before bubble fades
    window.addEventListener('touchend',()=>{ setTimeout(()=>{ mouse.x=-999; mouse.y=-999; }, 350); }, {passive:true});
    window.addEventListener('resize',()=>{ W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight; buildGrid(); circles=Array.from({length:CIRCLE_COUNT},(_,i)=>createCircle(i)); });
    requestAnimationFrame(draw);

    const trapoFab = document.getElementById('trapo-fab') as HTMLAnchorElement;
    let tfX = rnd(0, Math.max(0, window.innerWidth - trapoFab.offsetWidth));
    let tfY = rnd(0, Math.max(0, window.innerHeight - trapoFab.offsetHeight));
    let tfVx = rnd(0.15, 0.35) * (Math.random() < 0.5 ? -1 : 1);
    let tfVy = rnd(0.15, 0.35) * (Math.random() < 0.5 ? -1 : 1);
    function driveTrapoFab(){
      const w = trapoFab.offsetWidth, h = trapoFab.offsetHeight;
      tfX += tfVx; tfY += tfVy;
      if (tfX < 0) { tfX = 0; tfVx *= -1; }
      if (tfX + w > window.innerWidth) { tfX = window.innerWidth - w; tfVx *= -1; }
      if (tfY < 0) { tfY = 0; tfVy *= -1; }
      if (tfY + h > window.innerHeight) { tfY = window.innerHeight - h; tfVy *= -1; }
      trapoFab.style.transform = `translate(${tfX}px, ${tfY}px)`;
      requestAnimationFrame(driveTrapoFab);
    }
    requestAnimationFrame(driveTrapoFab);
  </script>
</Layout>