    // ── Ship ──────────────────────────────────────────────
    // The message carrier: patrols the limbo with one cargo light per word, leaves when it holds eleven.
    interface Ship {
      group: THREE.Group; engine: THREE.Mesh; lamps: THREE.MeshBasicMaterial[][]; trail: THREE.Line;
      tau: number; up: THREE.Vector3; peek: number; peekFrom: number; mode: 'cruise' | 'board' | 'parked' | 'launch' | 'away';
      spawn: number; t0: number; p0: THREE.Vector3; ctrl: THREE.Vector3; v: number; dir: THREE.Vector3; lit: number; over: boolean; sx: number; sy: number; onScreen: boolean;
    }
    let ship: Ship | null = null, boarded = false, hoverShip = false;
    let burst: THREE.Points | null = null, shock: THREE.Mesh | null = null;
    let impactAt = 0, logoPulse = 0, delivering = false;
    const BURST = 330, DELIVERY = 2.7;
    const TRAIL = 170, SHIP_SCALE = 1;
    // Cruising, the ship lives in this rig glued to the camera: orbiting and zooming the universe never move it.
    const rig = new THREE.Group();
    scene.add(rig);
    const HULL: [number, number][] = [[0,5.4],[.3,4.5],[.62,3],[.86,.8],[.92,-1.4],[.76,-2.9],[.52,-3.5]];
    const hullR = (z: number) => {
      for(let i = 1; i < HULL.length; i++){
        if(z >= HULL[i][1]){
          const [r0,z0] = HULL[i-1], [r1,z1] = HULL[i];
          return r1 + (r0-r1)*(z-z1)/(z0-z1);
        }
      }
      return .5;
    };
    function buildShip(){
      const group = new THREE.Group();
      const ink = new THREE.LineBasicMaterial({ color:0xf0ede8 });
      const shell = new THREE.MeshBasicMaterial({ color:0x0b0b16, polygonOffset:true, polygonOffsetFactor:1, polygonOffsetUnits:1 });
      const add = (geo: THREE.BufferGeometry, angle = 18) => {
        group.add(new THREE.Mesh(geo, shell));
        group.add(new THREE.LineSegments(new THREE.EdgesGeometry(geo, angle), ink));
      };
      const hull = new THREE.LatheGeometry(HULL.map(([r,z]) => new THREE.Vector2(r, z)), 8);
      hull.rotateX(Math.PI/2);
      hull.rotateZ(Math.PI/8);
      add(hull);
      const fin = new THREE.Shape();
      fin.moveTo(0,.6); fin.lineTo(1.1,-1.2); fin.lineTo(2.5,-4.6); fin.lineTo(1.5,-4.1); fin.lineTo(0,-3.2); fin.closePath();
      for(let k = 0; k < 3; k++){
        const g = new THREE.ExtrudeGeometry(fin, { depth:.05, bevelEnabled:false });
        g.rotateX(Math.PI/2);
        g.rotateY(0);
        g.translate(0, 0, 0);
        g.rotateZ(Math.PI/2 + k*Math.PI*2/3);
        add(g, 30);
      }
      const ring = new THREE.TorusGeometry(.62, .1, 6, 16);
      ring.translate(0, 0, -3.5);
      add(ring, 40);
      const lampGeo = new THREE.SphereGeometry(.13, 8, 8);
      const lamps: THREE.MeshBasicMaterial[][] = [];
      for(let k = 0; k < 11; k++){
        const z = 3.1 - k*.56, r = hullR(z)*1.03;
        const row = [1,-1].map(side => {
          const m = new THREE.MeshBasicMaterial({ color:new THREE.Color(COLORS[k % COLORS.length]) });
          const mesh = new THREE.Mesh(lampGeo, m);
          mesh.position.set(side*r, 0, z);
          group.add(mesh);
          return m;
        });
        lamps.push(row);
      }
      const engine = new THREE.Mesh(plane, new THREE.MeshBasicMaterial({ map:SPRITE, color:0x6ef9f5, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending }));
      engine.position.z = -3.9;
      group.add(engine);
      group.scale.setScalar(SHIP_SCALE);
      rig.add(group);

      const pts = new Float32Array(TRAIL*3), col = new Float32Array(TRAIL*3);
      for(let i = 0; i < TRAIL; i++){
        const f = Math.pow(1-i/TRAIL, 2)*.9;
        col.set([.43*f, .98*f, .96*f], i*3);
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(pts, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      const trail = new THREE.Line(geo, new THREE.LineBasicMaterial({ vertexColors:true, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending }));
      trail.frustumCulled = false;
      rig.add(trail);

      // what the logo gives back on arrival: a shockwave and the colours of the eleven lights
      const dirs = new Float32Array(BURST*3), tints = new Float32Array(BURST*3);
      for(let i = 0; i < BURST; i++){
        const u = rnd(0, Math.PI*2), v = Math.acos(rnd(-1, 1)), r = rnd(12, 60);
        dirs.set([Math.sin(v)*Math.cos(u)*r, Math.cos(v)*r, Math.sin(v)*Math.sin(u)*r], i*3);
        tints.set(hexRgb(COLORS[i % COLORS.length]), i*3);
      }
      const burstGeo = new THREE.BufferGeometry();
      burstGeo.setAttribute('position', new THREE.BufferAttribute(dirs, 3));
      burstGeo.setAttribute('color', new THREE.BufferAttribute(tints, 3));
      burst = new THREE.Points(burstGeo, new THREE.PointsMaterial({ size:1.1, map:SPRITE, vertexColors:true, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending }));
      burst.visible = false;
      scene.add(burst);
      shock = new THREE.Mesh(new THREE.RingGeometry(.975, 1, 128), new THREE.MeshBasicMaterial({ color:0xf0ede8, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide }));
      shock.visible = false;
      scene.add(shock);
      billboards.push(shock);

      ship = { group, engine, lamps, trail, tau:rnd(0, 400), up:new THREE.Vector3(0,1,0), peek:0, peekFrom:0, mode:'cruise', spawn:0, t0:0, p0:new THREE.Vector3(), ctrl:new THREE.Vector3(), v:0, dir:new THREE.Vector3(0,0,1), lit:0, over:false, sx:0, sy:0, onScreen:false };
      resetTrail();
    }
    // Its own route, in view space: incommensurate waves, so it never repeats and always stays in frame.
    function route(tau: number){
      const depth = 94 + 16*Math.sin(tau*.067+2);
      const hh = depth*Math.tan(camera.fov*Math.PI/360), hw = hh*camera.aspect;
      const x = (Math.sin(tau*.113) + .4*Math.sin(tau*.047+1))/1.4;
      const y = (Math.sin(tau*.081+1) + .4*Math.sin(tau*.037))/1.4;
